  2009-01-01 12:00  => FORMAT-CLE.
  2009-01-01 12:00  =>     MOVE SPACES   TO TAB-OUTPUT.
  2009-01-01 12:00  =>     MOVE ZL1      TO TAB-INPUT.
  2009-01-01 12:00  =>     MOVE 1        TO INDEXI INDEXO.
  2009-01-01 12:00  =>     PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT SW-AVANT TIMES.
  2009-01-01 12:00  =>     IF TAB-I (INDEXI) NOT = '2'
  2009-01-01 12:00  =>        ADD 2 TO INDEXI
  2009-01-01 12:00  =>        PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT 2 TIMES
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        ADD 1 TO INDEXI
  2009-01-01 12:00  =>        IF  TAB-I (INDEXI)     = '0' AND
  2009-01-01 12:00  =>            TAB-I (INDEXI + 1) = '0'
  2009-01-01 12:00  =>            MOVE ';' TO TAB-O (INDEXO)
  2009-01-01 12:00  =>            ADD  2   TO INDEXI
  2009-01-01 12:00  =>            ADD  1   TO INDEXO
  2009-01-01 12:00  =>            PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT
  2009-01-01 12:00  =>        ELSE
  2009-01-01 12:00  =>        IF  TAB-I (INDEXI)     = '0' AND
  2009-01-01 12:00  =>            TAB-I (INDEXI + 1) = '1'
  2009-01-01 12:00  =>            MOVE '_' TO TAB-O (INDEXO)
  2009-01-01 12:00  =>            ADD  2   TO INDEXI
  2009-01-01 12:00  =>            ADD  1   TO INDEXO
  2009-01-01 12:00  =>            PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT
  2009-01-01 12:00  =>        ELSE
  2009-01-01 12:00  =>        IF  TAB-I (INDEXI)     = '0' AND
  2009-01-01 12:00  =>            TAB-I (INDEXI + 1) = '2'
  2009-01-01 12:00  =>            MOVE '|' TO TAB-O (INDEXO)
  2009-01-01 12:00  =>            ADD  2   TO INDEXI
  2009-01-01 12:00  =>            ADD  1   TO INDEXO
  2009-01-01 12:00  =>            PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT
  2009-01-01 12:00  =>        ELSE
  2009-01-01 12:00  =>        IF  TAB-I (INDEXI)     = '0' AND
  2009-01-01 12:00  =>            TAB-I (INDEXI + 1) = '3'
  2009-01-01 12:00  =>            MOVE '~' TO TAB-O (INDEXO)
  2009-01-01 12:00  =>            ADD  2   TO INDEXI
  2009-01-01 12:00  =>            ADD  1   TO INDEXO
  2009-01-01 12:00  =>            PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT.
  2009-01-01 12:00  =>     PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT.
  2009-01-01 12:00  =>     PERFORM MOVE-CHAR THRU MOVE-CHAR-EXIT.
  2009-01-01 12:00  => FORMAT-CLE-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => MOVE-CHAR.
  2009-01-01 12:00  =>     MOVE TAB-I (INDEXI) TO TAB-O (INDEXO).
  2009-01-01 12:00  =>     ADD  1 TO INDEXI.
  2009-01-01 12:00  =>     ADD  1 TO INDEXO.
  2009-01-01 12:00  => MOVE-CHAR-EXIT.
  2009-01-01 12:00  =>     EXIT.
