  2009-01-01 12:00  =>     06  FIXED1  PIC  X(1)  VALUE ZEROES.  *> SSG-STUB [*I], [FIXE//,1,I,2]
  2009-01-01 12:00  =>     06  FIXED1 PIC X(1)  *> SSG-STUB [*I], [FIXE,1,I,2]
  2009-01-01 12:00  =>     VALUE '1'.  *> SSG-STUB [FIXE,1,I,3]
  2009-01-01 12:00  => 01  COUNT.
  2009-01-01 12:00  =>     03 COUNTING PIC S9(1)  VALUE 0.  *> SSG-STUB [FIXE,1,1,2]
  2009-01-01 12:00  =>     03 COUNTER PIC S9(1) VALUE 1.  *> SSG-STUB [FIXE,1,1,2], [FIX//E,1,1,4]
  2009-01-01 12:00  => 01   SWITCHES.
  2009-01-01 12:00  =>     03  REC-SKIPPED  PIC  S9(6) VALUE ZEROES.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN OUTPUT  PRINTOUT.
  2009-01-01 12:00  =>     OPEN INPUT TAPEIN.
  2009-01-01 12:00  =>     OPEN  OUTPUT  TAPEOUT.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECOUT.
  2009-01-01 12:00  =>     READ  TAPEIN  AT  END  GO TO  FINW.
  2009-01-01 12:00  =>     MOVE  RECIN  TO RECW.
  2009-01-01 12:00  =>     IF  RECW4 (7) = '*' GO TO LECT.
  2009-01-01 12:00  => REPSIM.
  2009-01-01 12:00  =>     MOVE RECIN TO RECOUT.
  2009-01-01 12:00  =>     MOVE                ZONE1 TO ZONO1.  *> SSG-STUB [*I], [*I]
  2009-01-01 12:00  =>     ADD COUNTER TO COUNTING.
  2009-01-01 12:00  =>     MOVE COUNTING TO FIXED[*1].
  2009-01-01 12:00  =>     ENTER  SST60  SUBROUTINE REFERENCING '-' FIXDATA1.  *> SSG-ST//UB [*I]
  2009-01-01 12:00  =>     MOVE                  FIXED1 TO FIXDATA1.  *> SSG-STUB [*I], //[*I]
  2009-01-01 12:00  =>     EXAMINE FIXDATA1 REPLACING ALL '<' BY ';'.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     WRITE LISTE  FROM RECOUT.
  2009-01-01 12:00  =>     ADD 1  TO NB-LUS.
  2009-01-01 12:00  =>     IF  ZONE2  <  1  *> SSG-STUB [STARTFIELD,1,1,1]
  2009-01-01 12:00  =>     ADD 1  TO REC-SKIPPED
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  =>     IF  NB-LUS  <  1  *> SSG-STUB [STARTREC,1,1,1]
  2009-01-01 12:00  =>     ADD 1  TO REC-SKIPPED
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  =>     IF REPRISE-AA11  = SPACES MOVE SPACES TO REPRISE-AA21.  *> SS//G-STUB [*I], [*I]
  2009-01-01 12:00  =>     IF REPRISE-AA11 = SPACES MOVE SPACES TO REPRISE-AA1.  *> SSG-//STUB [*I], [*I]
  2009-01-01 12:00  =>     WRITE RECOUT.
  2009-01-01 12:00  =>     IF  NB-LUS  NOT <  COPY-LIMIT  GO TO FINW.
  2009-01-01 12:00  =>     IF  NB-LUS  =  1  *> SSG-STUB [REPSIM,1,1,1]
  2009-01-01 12:00  =>     GO TO FINW
  2009-01-01 12:00  =>     ELSE  GO TO REPSIM.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     DISPLAY  '*CFH-COPY  FIN*'  UPON  PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-LUS ='  NB-LUS  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE  TAPEIN.
  2009-01-01 12:00  =>     CLOSE  TAPEOUT.
  2009-01-01 12:00  =>     DISPLAY  REC-SKIPPED  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE PRINTOUT.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  *create sgs 1   SSG-STUB [*par]
  *remove sgs FIXE,1,maxy 
  PROGRAM-ID. AUTHOR. MICHEL REVISED BY BOURDEAUD HUY.
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
<IN FOLDER>
COBOL
</IN FOLDER>
</OBJECT>
<OBJECT=ASSURFED_UTILIT_COMPARE2_ASCII(P),COBOL PROGRAM>
<REVDATA>
<VERSION=1.0>
<USER=>
<DATE=20090101>
<TIME=1200>
<LOCKED=False>
<DESCRIPTION=COBOL PROGRAM>
</REVDATA>
<DATA=Options>
  Name=ASSURFED_UTILIT_COMPARE2_ASCII(P)
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  =>    IDENTIFICATION DIVISION.
  2009-01-01 12:00  => PROGRAM-ID.    COMPARE.
  2009-01-01 12:00  => AUTHOR.        HANSE.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER. SPERRY-1100.
  2009-01-01 12:00  => OBJECT-COMPUTER. SPERRY-1100.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT IN1 ASSIGN TO DISC FILEIN-1.  *> SSG-STUB [INPUT,1,1,1//]
  2009-01-01 12:00  =>     SELECT IN2 ASSIGN TO DISC 80.  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  =>     SELECT LISTING ASSIGN TO PRINTER.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  IN1
  2009-01-01 12:00  =>     LABEL  RECORD IS OMITTED
  2009-01-01 12:00  =>     LABEL  RECORD IS STANDARD
  2009-01-01 12:00  =>     BLOCK  CONTAINS 80 RECORDS  *> SSG-STUB [INPUT,1,1,4]
  2009-01-01 12:00  =>     RECORD CONTAINS 1 CHARACTERS  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  =>     DATA RECORD IS ENR-IN1.
  2009-01-01 12:00  => 01  ENR-IN1   PIC X(1).  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  => FD  IN2
  2009-01-01 12:00  =>     LABEL  RECORD IS OMITTED
  2009-01-01 12:00  =>     LABEL  RECORD IS STANDARD
  2009-01-01 12:00  =>     BLOCK  CONTAINS 80 RECORDS  *> SSG-STUB [INPUT,1,1,4]
  2009-01-01 12:00  =>     RECORD CONTAINS 1 CHARACTERS  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  =>     DATA RECORD IS ENR-IN2.
  2009-01-01 12:00  => 01  ENR-IN2   PIC X(1).  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  => FD  LISTING
  2009-01-01 12:00  =>     LABEL RECORD IS OMITTED
  2009-01-01 12:00  =>     BLOCK CONTAINS 1 RECORDS
  2009-01-01 12:00  =>     RECORD CONTAINS 132 CHARACTERS
  2009-01-01 12:00  =>     DATA RECORD IS LIGNE.
  2009-01-01 12:00  => 01  LIGNE PIC X(132).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => 01  L-NOLIGNE.
  2009-01-01 12:00  =>     05 FILLER PIC X(50) VALUE
  2009-01-01 12:00  =>     '----+----1----+----2----+----3----+----4----+----5'.
  2009-01-01 12:00  =>     05 FILLER PIC X(50) VALUE
  2009-01-01 12:00  =>     '----+----6----+----7----+----8----+----9----+----1'.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => 01  WS-IN1.
  2009-01-01 12:00  =>     02 TAB-IN1 OCCURS 1 INDEXED BY XT1 PIC X(100).  *> SSG-STUB [//*A]
  2009-01-01 12:00  => 01  WS-IN11 REDEFINES WS-IN1.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     02 INDIC11      PIC X(1).  *> SSG-STUB [*I], [INDIC,1,I,2]
  2009-01-01 12:00  => 01  WS-EXCL1-1 REDEFINES WS-IN1.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     02 FILLER                PIC X(-1).  *> SSG-STUB [*L1]
  2009-01-01 12:00  =>     02 EXCL1-1              PIC X(1).  *> SSG-STUB [*I], [EXCLUDE//,1,I,2]
  2009-01-01 12:00  =>     02 FILLER                PIC X(0).  *> SSG-STUB [*L2]
  2009-01-01 12:00  => 01  WS-IN2.
  2009-01-01 12:00  =>     02 TAB-IN2 OCCURS 1 INDEXED BY XT2 PIC X(100).  *> SSG-STUB [//*A]
  2009-01-01 12:00  => 01  WS-IN21 REDEFINES WS-IN2.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     02 INDIC21      PIC X(1).  *> SSG-STUB [*I], [INDIC,1,I,2]
  2009-01-01 12:00  => 01  WS-EXCL2-1 REDEFINES WS-IN2.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     02 FILLER                PIC X(-1).  *> SSG-STUB [*L1]
  2009-01-01 12:00  =>     02 EXCL2-1              PIC X(1).  *> SSG-STUB [*I], [EXCLUDE//,1,I,2]
  2009-01-01 12:00  =>     02 FILLER                PIC X(0).  *> SSG-STUB [*L2]
  2009-01-01 12:00  => 01  WS-INDIC1.
  2009-01-01 12:00  =>     02 IND11        PIC X(1).  *> SSG-STUB [*I], [INDIC,1,I,2]
  2009-01-01 12:00  =>     02 FILLER          PIC X(4).
  2009-01-01 12:00  => 01  WS-INDIC2.
  2009-01-01 12:00  =>     02 IND21        PIC X(1).  *> SSG-STUB [*I], [INDIC,1,I,2]
  2009-01-01 12:00  =>     02 FILLER          PIC X(4).
  2009-01-01 12:00  => 01  LIGNE-NO-REC.
  2009-01-01 12:00  =>   03  FILLER   PIC X(20) VALUE 'ENREGISTREMENT NO   '.
  2009-01-01 12:00  =>   03  ZCT1     PIC 9(10) VALUE ZEROES.
  2009-01-01 12:00  =>   03  FILLER   PIC X(4) VALUE ' (FILEIN-1) '.  *> SSG-STUB [INPUT//,1,1,1], [*LONGUEUR]
  2009-01-01 12:00  =>   03  FILLER   PIC X(3) VALUE ' / '.
  2009-01-01 12:00  =>   03  ZCT2     PIC 9(10) VALUE ZEROES.
  2009-01-01 12:00  =>   03  FILLER   PIC X(4) VALUE ' (80) '.  *> SSG-STUB [INPUT,1,1,2//], [*LONGUEUR]
  2009-01-01 12:00  =>   03  FILLER   PIC X(9) VALUE 'NO DIFF: '.
  2009-01-01 12:00  =>   03  ZCT3     PIC 9(6) VALUE ZEROES.
  2009-01-01 12:00  => 01  CT1     PIC 9(10) COMP VALUE ZEROES.
  2009-01-01 12:00  => 01  CT2     PIC 9(10) COMP VALUE ZEROES.
  2009-01-01 12:00  => 01  SW-ANO  PIC 9          VALUE 0.
  2009-01-01 12:00  => 01  DIFFERENCE         PIC 9            VALUE 0.
  2009-01-01 12:00  => 01  NB-TOT-DIFFERENCE  PIC 9(6)         VALUE 0.
  2009-01-01 12:00  => 01  WS-COMPTEUR-PRNT   PIC 9(6)         VALUE 0.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT IN1 IN2
  2009-01-01 12:00  =>          OUTPUT LISTING.
  2009-01-01 12:00  =>     MOVE SPACES TO LIGNE.
  2009-01-01 12:00  =>     WRITE LIGNE AFTER PAGE.
  2009-01-01 12:00  => LECTURE.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN1 THRU LECTURE-EX.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN2 THRU LECTURE-EX.
  2009-01-01 12:00  => TEST.
  2009-01-01 12:00  =>     IF WS-INDIC1 = WS-INDIC2  GO TO EGALITE.
  2009-01-01 12:00  =>     IF WS-INDIC1 > WS-INDIC2  GO TO IN2-SEUL.
  2009-01-01 12:00  =>     IF WS-INDIC1 < WS-INDIC2  GO TO IN1-SEUL.
  2009-01-01 12:00  => EGALITE.
  2009-01-01 12:00  =>     IF WS-INDIC1 = HIGH-VALUES GO TO FINI.
  2009-01-01 12:00  =>     GO TO LECTURE
  2009-01-01 12:00  =>     MOVE 0 TO SW-ANO.
  2009-01-01 12:00  =>     SET XT1 XT2 TO 1.
  2009-01-01 12:00  => BCL1.
  2009-01-01 12:00  =>     IF XT1 > 1  GO TO IMP-EGAL.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     IF XT2 > 1  GO TO IMP-EGAL.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     IF TAB-IN1 (XT1) = TAB-IN2 (XT2)  GO TO RBCL1.
  2009-01-01 12:00  =>     MOVE 1 TO DIFFERENCE.
  2009-01-01 12:00  =>     MOVE 1 TO SW-ANO.
  2009-01-01 12:00  => RBCL1.
  2009-01-01 12:00  =>     SET XT1 XT2 UP BY 1.
  2009-01-01 12:00  =>     GO TO BCL1.
  2009-01-01 12:00  => IMP-EGAL.
  2009-01-01 12:00  =>     IF SW-ANO = 0   GO TO LECTURE.
  2009-01-01 12:00  =>     ADD  1 TO WS-COMPTEUR-PRNT.
  2009-01-01 12:00  =>     IF NOT WS-COMPTEUR-PRNT > 0  *> SSG-STUB [*AIMPRIMER]
  2009-01-01 12:00  =>        GO TO IMPRESSION.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  => IMPRESSION.
  2009-01-01 12:00  =>     MOVE CT1 TO ZCT1.
  2009-01-01 12:00  =>     MOVE CT2 TO ZCT2.
  2009-01-01 12:00  =>     DISPLAY ' ' UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY LIGNE-NO-REC                   UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY L-NOLIGNE                      UPON PRINTER.
  2009-01-01 12:00  =>     SET XT1 TO 1.
  2009-01-01 12:00  =>     SET XT2 TO 1.
  2009-01-01 12:00  => BCL-IMP.
  2009-01-01 12:00  =>     IF XT2 > 1   GO TO LECTURE.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     DISPLAY TAB-IN1 (XT1) UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY TAB-IN2 (XT2) UPON PRINTER.
  2009-01-01 12:00  =>     SET XT1 UP BY 1
  2009-01-01 12:00  =>     SET XT2 UP BY 1.
  2009-01-01 12:00  =>     GO TO BCL-IMP.
  2009-01-01 12:00  => IN1-SEUL.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN1 THRU LECTURE-EX.
  2009-01-01 12:00  =>     GO TO TEST.
  2009-01-01 12:00  =>     DISPLAY '< ENREG. NO : ' CT1 UPON PRINTER.
  2009-01-01 12:00  =>     SET XT1 TO 1.
  2009-01-01 12:00  => BCL-IMP-IN1.
  2009-01-01 12:00  =>     IF XT1 > 1   PERFORM LECTURE-IN1 THRU LECTURE-EX  *> SSG-STUB// [*A]
  2009-01-01 12:00  =>                     GO TO TEST.
  2009-01-01 12:00  =>     DISPLAY TAB-IN1 (XT1) UPON PRINTER.
  2009-01-01 12:00  =>     SET XT1 UP BY 1.
  2009-01-01 12:00  =>     GO TO BCL-IMP-IN1.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN1 THRU LECTURE-EX.
  2009-01-01 12:00  =>     GO TO TEST.
  2009-01-01 12:00  => IN2-SEUL.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN2 THRU LECTURE-EX.
  2009-01-01 12:00  =>     GO TO TEST.
  2009-01-01 12:00  =>     DISPLAY '> ENREG. NO :            - ' CT2 UPON PRINTER.
  2009-01-01 12:00  =>     SET XT2 TO 1.
  2009-01-01 12:00  => BCL-IMP-IN2.
  2009-01-01 12:00  =>     IF XT2 > 1   PERFORM LECTURE-IN2 THRU LECTURE-EX  *> SSG-STUB// [*A]
  2009-01-01 12:00  =>                     GO TO TEST.
  2009-01-01 12:00  =>     DISPLAY TAB-IN2 (XT2) UPON PRINTER.
  2009-01-01 12:00  =>     SET XT2 UP BY 1.
  2009-01-01 12:00  =>     GO TO BCL-IMP-IN2.
  2009-01-01 12:00  =>     PERFORM LECTURE-IN2 THRU LECTURE-EX.
  2009-01-01 12:00  =>     GO TO TEST.
  2009-01-01 12:00  => LECTURE-IN1.
  2009-01-01 12:00  =>     ADD DIFFERENCE TO NB-TOT-DIFFERENCE.
  2009-01-01 12:00  =>     MOVE NB-TOT-DIFFERENCE TO ZCT3.
  2009-01-01 12:00  =>     ADD 1 TO ZCT3.
  2009-01-01 12:00  =>     MOVE 0 TO DIFFERENCE.
  2009-01-01 12:00  =>     READ IN1 INTO WS-IN1 AT END
  2009-01-01 12:00  =>                          MOVE HIGH-VALUES TO WS-INDIC1
  2009-01-01 12:00  =>                          GO TO LECTURE-EX.
  2009-01-01 12:00  =>     PERFORM EXCLUDE1 THRU EXCLUDE1-EXIT.
  2009-01-01 12:00  =>     ADD 1 TO CT1.
  2009-01-01 12:00  =>     MOVE INDIC11 TO IND11.  *> SSG-STUB [*I], [*I]
  2009-01-01 12:00  =>     GO TO LECTURE-EX.
  2009-01-01 12:00  => LECTURE-IN2.
  2009-01-01 12:00  =>     MOVE 0 TO DIFFERENCE.
  2009-01-01 12:00  =>     READ IN2 INTO WS-IN2 AT END
  2009-01-01 12:00  =>                          MOVE HIGH-VALUES TO WS-INDIC2
  2009-01-01 12:00  =>                          GO TO LECTURE-EX.
  2009-01-01 12:00  =>     PERFORM EXCLUDE2 THRU EXCLUDE2-EXIT.
  2009-01-01 12:00  =>     ADD 1 TO CT2.
  2009-01-01 12:00  =>     MOVE INDIC21 TO IND21.  *> SSG-STUB [*I], [*I]
  2009-01-01 12:00  => LECTURE-EX.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => EXCLUDE1.
  2009-01-01 12:00  =>     MOVE ALL '*' TO EXCL1-1.  *> SSG-STUB [*I]
  2009-01-01 12:00  => EXCLUDE1-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => EXCLUDE2.
  2009-01-01 12:00  =>     MOVE ALL '*' TO EXCL2-1.  *> SSG-STUB [*I]
  2009-01-01 12:00  => EXCLUDE2-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>
  2009-01-01 12:00  => FINI.
  2009-01-01 12:00  =>     DISPLAY '******************************'
  2009-01-01 12:00  =>              UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE ENREGISTREMENTS INPUT FICHIER 1 = ' CT1
  2009-01-01 12:00  =>              UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE ENREGISTREMENTS INPUT FICHIER 2 = ' CT2
  2009-01-01 12:00  =>              UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE ENREGISTREMENTS DIFFERENTS = '
  2009-01-01 12:00  =>              NB-TOT-DIFFERENCE              UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY '******************************' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY '**********************************************'
  2009-01-01 12:00  =>              UPON PRINTER.
  2009-01-01 12:00  =>     IF NB-TOT-DIFFERENCE > 0  *> SSG-STUB [*AIMPRIMER]
  2009-01-01 12:00  =>           DISPLAY '* TOUTES LES DIFFERENCES NE SONT PAS LISTEES *//'
  2009-01-01 12:00  =>           UPON PRINTER
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>           DISPLAY '*    TOUTES LES DIFFERENCES SONT LISTEES     *//'
  2009-01-01 12:00  =>           UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY '**********************************************'
  2009-01-01 12:00  =>              UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE IN1 IN2 LISTING.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  PROGRAM-ID. .
  ENVIRONMENT. HANSE.
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
