  2009-01-01 12:00  =>*   INPUT:  chercheuse                                           *
  2009-01-01 12:00  =>***------------------------------------------------------------***
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Identification division.
  2009-01-01 12:00  =>*========================*
  2009-01-01 12:00  => program-id.  ARCHIINSERT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Environment division.
  2009-01-01 12:00  =>*====================*
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Configuration section.
  2009-01-01 12:00  =>*----------------------*
  2009-01-01 12:00  => source-computer.  unisys-2200.
  2009-01-01 12:00  => object-computer.  unisys-2200 MEMORY 3 MODULES.
  2009-01-01 12:00  => special-names.
  2009-01-01 12:00  =>     printer       printer
  2009-01-01 12:00  =>     decimal-point comma.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Input-output section.
  2009-01-01 12:00  =>*---------------------*
  2009-01-01 12:00  => file-control.
  2009-01-01 12:00  =>     select chercheuse assign to disc    ECL-FICREPORT.  *> SSG-ST//UB [filein,1,1,1]
  2009-01-01 12:00  => i-o-control.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Data division.
  2009-01-01 12:00  =>*==============*
  2009-01-01 12:00  =>
  2009-01-01 12:00  => File section.
  2009-01-01 12:00  =>*-------------*
  2009-01-01 12:00  =>* Fichier chercheuse
  2009-01-01 12:00  => FD  chercheuse.
  2009-01-01 12:00  =>  1  no-rch              pic 9(1).  *> SSG-STUB [filein,1,1,2]
  2009-01-01 12:00  =>
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  =>*------------------------*
  2009-01-01 12:00  =>*--------------- VARIABLES DE TRAVAIL ----------
  2009-01-01 12:00  =>   1 lecturef                    pic 9 value 0.
  2009-01-01 12:00  =>     88 fin-lecture              value 1.
  2009-01-01 12:00  =>   1 ws-vl-pnt-rep.
  2009-01-01 12:00  =>     3 ws-vl-cpt-lu-cpr         pic 9(10).
  2009-01-01 12:00  =>     3 ws-vl-cpt-ins-cpr        pic 9(10).
  2009-01-01 12:00  =>     3     pic x(40).
  2009-01-01 12:00  =>*----------------------------------------------
  2009-01-01 12:00  =>*---------------- FLAGS ------------------------
  2009-01-01 12:00  =>  77 fl-pre                     pic 9.
  2009-01-01 12:00  =>  77 fl-cpr                     pic 9.
  2009-01-01 12:00  =>  77 fl-ins-cpr                 pic 9.
  2009-01-01 12:00  =>  77 fl-rch-vide                pic 9.
  2009-01-01 12:00  =>*-----------------------------------------------
  2009-01-01 12:00  =>*------------- DATE ET HEURE -------------------
  2009-01-01 12:00  =>   1 ws-date                     pic 9(8).
  2009-01-01 12:00  =>   1 ws-dt-i redefines ws-date.
  2009-01-01 12:00  =>     3 ws-aa-i                   pic 9(4).
  2009-01-01 12:00  =>     3 ws-mm-i                   pic 99.
  2009-01-01 12:00  =>     3 ws-jj-i                   pic 99.
  2009-01-01 12:00  =>   1 ws-dt-fr.
  2009-01-01 12:00  =>     3 ws-jj-fr                  pic 99.
  2009-01-01 12:00  =>     3    pic x value "/".
  2009-01-01 12:00  =>     3 ws-mm-fr                  pic 99.
  2009-01-01 12:00  =>     3    pic x value "/".
  2009-01-01 12:00  =>     3 ws-aa-fr                  pic 9(4).
  2009-01-01 12:00  =>   1 ws-hre-tot.
  2009-01-01 12:00  =>     3 ws-hre                   pic 9(6).
  2009-01-01 12:00  =>     3     pic 99.
  2009-01-01 12:00  =>*-----------------------------------------------
  2009-01-01 12:00  =>*-------------- COMPTEURS ----------------------
  2009-01-01 12:00  =>  77 cpt-commit                  PIC 999.
  2009-01-01 12:00  =>  77 cpt-lu                      PIC 9(10).
  2009-01-01 12:00  =>  77 cpt-ins                     pic 9(10).
  2009-01-01 12:00  =>  77 cpt-luf                     PIC z(9)9.
  2009-01-01 12:00  =>  77 cpt-insf                    pic z(9)9.
  2009-01-01 12:00  =>*--------------------------------------------------------
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>*  VARIABLES DE CONTROLE RDMS ET ESQL
  2009-01-01 12:00  =>*-------------------------------------------------------------------------
  2009-01-01 12:00  =>
  2009-01-01 12:00  => 01 SQLSTATE                PIC X(05) USAGE DISPLAY.
  2009-01-01 12:00  =>     COPY WS-ESQL-VAR  OF COMMONS.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>     COPY ESQL-INVOKE OF COMMONS
  2009-01-01 12:00  =>          REPLACING ==NM-TAB== BY ==CHK_PNT_RST==.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>     COPY ESQL-INVOKE OF COMMONS
  2009-01-01 12:00  =>          REPLACING ==NM-TAB== BY ==SCHEMA1==.  *> SSG-STUB [table//,1,1,1]
  2009-01-01 12:00  =>
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  =>*==================*
  2009-01-01 12:00  =>  000-main.
  2009-01-01 12:00  =>     open input chercheuse
  2009-01-01 12:00  =>     perform 010-init-db thru 010-exit
  2009-01-01 12:00  =>     perform 020-init-var thru 020-exit
  2009-01-01 12:00  =>     perform 030-pre-trait thru 030-exit
  2009-01-01 12:00  =>     perform 040-lec-fic thru 040-exit
  2009-01-01 12:00  =>     perform 050-rapport thru 050-exit
  2009-01-01 12:00  =>     perform 060-fin-db thru 060-exit
  2009-01-01 12:00  =>     close chercheuse
  2009-01-01 12:00  =>     stop run
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>*--------- INITIALISATION DE LA DB -----------------
  2009-01-01 12:00  =>  010-init-db.
  2009-01-01 12:00  =>     MOVE  "0"                   TO  WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     EXEC RDMS
  2009-01-01 12:00  =>              BEGIN THREAD FOR UDSSRC UPDATE (QUICKLOOKS)
  2009-01-01 12:00  =>     END-EXEC
  2009-01-01 12:00  =>     IF  SQLCODE NOT = 0
  2009-01-01 12:00  =>         PERFORM  999-ESQL-ERR
  2009-01-01 12:00  =>         PERFORM  999-ESQL-ABORT
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     MOVE  "1"                   TO  WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     COPY  ESQL-USE              OF  COMMONS.
  2009-01-01 12:00  =>     COPY  ESQL-USE-DYN          OF  COMMONS.
  2009-01-01 12:00  =>     IF  SQLCODE NOT = 0
  2009-01-01 12:00  =>         PERFORM  999-ESQL-ERR
  2009-01-01 12:00  =>         PERFORM  999-ESQL-ABORT
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  010-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*-------- INIT DES VARIABLES -------------
  2009-01-01 12:00  =>  020-init-var.
  2009-01-01 12:00  =>     move zeroes to fl-pre
  2009-01-01 12:00  =>                    fl-cpr
  2009-01-01 12:00  =>                    fl-ins-cpr
  2009-01-01 12:00  =>                    fl-rch-vide
  2009-01-01 12:00  =>                    ws-date
  2009-01-01 12:00  =>                    ws-hre
  2009-01-01 12:00  =>                    ws-vl-pnt-rep
  2009-01-01 12:00  =>                    cpt-commit
  2009-01-01 12:00  =>                    cpt-lu
  2009-01-01 12:00  =>                    cpt-ins
  2009-01-01 12:00  =>                    cpt-luf
  2009-01-01 12:00  =>                    cpt-insf
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  020-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*----- PREMIERE LECTURE DU FICHIER  ---------
  2009-01-01 12:00  =>  030-pre-trait.
  2009-01-01 12:00  =>     read chercheuse
  2009-01-01 12:00  =>       at end
  2009-01-01 12:00  =>         move 1 to lecturef fl-rch-vide
  2009-01-01 12:00  =>       not at end
  2009-01-01 12:00  =>         move 1 to fl-pre
  2009-01-01 12:00  =>         accept ws-hre-tot from time
  2009-01-01 12:00  =>         perform 100-lec-cpr thru 100-exit
  2009-01-01 12:00  =>     end-read
  2009-01-01 12:00  =>     accept ws-date from date yyyymmdd
  2009-01-01 12:00  =>     move ws-aa-i to ws-aa-fr
  2009-01-01 12:00  =>     move ws-mm-i to ws-mm-fr
  2009-01-01 12:00  =>     move ws-jj-i to ws-jj-fr
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  030-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*---------- LECTURE DU FICHIER ---------
  2009-01-01 12:00  =>  040-lec-fic.
  2009-01-01 12:00  =>     perform until fin-lecture
  2009-01-01 12:00  =>       add 1 to cpt-lu
  2009-01-01 12:00  =>       if fl-cpr = 1
  2009-01-01 12:00  =>         add 1 to ws-vl-cpt-lu-cpr
  2009-01-01 12:00  =>         perform until cpt-lu = ws-vl-cpt-lu-cpr
  2009-01-01 12:00  =>           read chercheuse
  2009-01-01 12:00  =>             at end
  2009-01-01 12:00  =>               move 1 to lecturef
  2009-01-01 12:00  =>               move cpt-lu to ws-vl-cpt-lu-cpr
  2009-01-01 12:00  =>             not at end
  2009-01-01 12:00  =>               add 1 to cpt-lu
  2009-01-01 12:00  =>           end-read
  2009-01-01 12:00  =>         end-perform
  2009-01-01 12:00  =>       end-if
  2009-01-01 12:00  =>       perform 101-ins-rch thru 101-exit
  2009-01-01 12:00  =>       read chercheuse
  2009-01-01 12:00  =>         at end
  2009-01-01 12:00  =>           move 1 to lecturef
  2009-01-01 12:00  =>       end-read
  2009-01-01 12:00  =>     end-perform
  2009-01-01 12:00  =>     if fl-rch-vide = 0
  2009-01-01 12:00  =>       perform 102-del-cpr thru 102-exit
  2009-01-01 12:00  =>     end-if
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  040-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*--------------- RAPPORT  --------
  2009-01-01 12:00  =>  050-rapport.
  2009-01-01 12:00  =>     move cpt-lu to cpt-luf
  2009-01-01 12:00  =>     move cpt-ins to cpt-insf
  2009-01-01 12:00  =>     display "ARCHIINSERT      Rapport       " ws-dt-fr
  2009-01-01 12:00  =>       upon printer
  2009-01-01 12:00  =>     display "tot lu = " cpt-luf upon printer
  2009-01-01 12:00  =>     display "tot ins = " cpt-insf upon printer
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  050-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*--------------- FIN CONNECTION DB ------------
  2009-01-01 12:00  =>  060-fin-db.
  2009-01-01 12:00  =>     IF  WS-ESQL-FL-THREAD = "1"
  2009-01-01 12:00  =>       EXEC RDMS  END THREAD  END-EXEC
  2009-01-01 12:00  =>       MOVE 0 TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     end-if
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  060-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*------- LECTURE DU PARAMETRE DE CHK_PNT_RST -------
  2009-01-01 12:00  =>  100-lec-cpr.
  2009-01-01 12:00  =>     exec RDMS
  2009-01-01 12:00  =>       select vl_pnt_rep
  2009-01-01 12:00  =>       into   :ws-vl-pnt-rep
  2009-01-01 12:00  =>       from   chk_pnt_rst
  2009-01-01 12:00  =>       where  mr_prg_maj   =  'ARCHII'
  2009-01-01 12:00  =>     end-exec
  2009-01-01 12:00  =>     evaluate sqlcode
  2009-01-01 12:00  =>       when 0
  2009-01-01 12:00  =>         move 1 to fl-cpr
  2009-01-01 12:00  =>         move 0 to fl-ins-cpr
  2009-01-01 12:00  =>         move ws-vl-cpt-ins-cpr to cpt-ins
  2009-01-01 12:00  =>       when 100
  2009-01-01 12:00  =>         move 1 to ws-vl-cpt-lu-cpr
  2009-01-01 12:00  =>                   fl-ins-cpr
  2009-01-01 12:00  =>         move 0 to fl-cpr
  2009-01-01 12:00  =>       when other
  2009-01-01 12:00  =>         move "100-lec-cpr" to ws-esql-trace
  2009-01-01 12:00  =>         perform 999-esql-err
  2009-01-01 12:00  =>         perform 999-esql-abort
  2009-01-01 12:00  =>     end-evaluate
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  100-exit.
  2009-01-01 12:00  =>*----------- INSERT DANS LA TABLE CHERCHEUSE ------
  2009-01-01 12:00  =>  101-ins-rch.
  2009-01-01 12:00  =>     EXEC RDMS
  2009-01-01 12:00  =>          INSERT INTO SCHEMA1  *> SSG-STUB [table,1,1,1]
  2009-01-01 12:00  =>           COLUMNS
  2009-01-01 12:00  =>             (TABLE-ARCH       =     :no-rch)  *> SSG-STUB [table,//1,1,2]
  2009-01-01 12:00  =>     END-EXEC.
  2009-01-01 12:00  =>     evaluate sqlcode
  2009-01-01 12:00  =>       when 0
  2009-01-01 12:00  =>         add 1 to cpt-ins
  2009-01-01 12:00  =>         add 1 to cpt-commit
  2009-01-01 12:00  =>         if cpt-commit > 500
  2009-01-01 12:00  =>           perform 500-commit thru 500-exit
  2009-01-01 12:00  =>         end-if
  2009-01-01 12:00  =>*Continue si la cl{ existe!
  2009-01-01 12:00  =>       when -6003
  2009-01-01 12:00  =>         continue
  2009-01-01 12:00  =>       when other
  2009-01-01 12:00  =>         display "no chercheuse: " no-rch upon printer
  2009-01-01 12:00  =>         MOVE "101-ins-rch" TO WS-ESQL-TRACE
  2009-01-01 12:00  =>         PERFORM 999-ESQL-ERR
  2009-01-01 12:00  =>         PERFORM 999-ESQL-ABORT
  2009-01-01 12:00  =>     end-evaluate
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  101-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*----------- DELETE DU PARAMETRE CPR -------
  2009-01-01 12:00  =>  102-del-cpr.
  2009-01-01 12:00  =>     exec RDMS
  2009-01-01 12:00  =>       delete Chk_Pnt_Rst
  2009-01-01 12:00  =>       where mr_prg_maj = 'ARCHII'
  2009-01-01 12:00  =>     end-exec
  2009-01-01 12:00  =>     if sqlcode not = 0
  2009-01-01 12:00  =>        move "102-del-cpr" to ws-esql-trace
  2009-01-01 12:00  =>        perform 999-esql-err
  2009-01-01 12:00  =>        perform 999-esql-abort
  2009-01-01 12:00  =>     end-if
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  102-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*------------ EFFETUE UN COMMIT DANS LA DB ------------
  2009-01-01 12:00  =>  500-commit.
  2009-01-01 12:00  =>     perform 600-maj-cpr thru 600-exit
  2009-01-01 12:00  =>     EXEC RDMS COMMIT WORK END-EXEC.
  2009-01-01 12:00  =>     IF SQLCODE NOT = 0
  2009-01-01 12:00  =>        MOVE "500-commit" TO WS-ESQL-TRACE
  2009-01-01 12:00  =>        PERFORM 999-ESQL-ERR
  2009-01-01 12:00  =>        PERFORM 999-ESQL-ABORT
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     move 0 to cpt-commit
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  500-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*------------ MAJ DE CHK_PNT_RST -----------
  2009-01-01 12:00  =>  600-maj-cpr.
  2009-01-01 12:00  =>     move cpt-lu to ws-vl-cpt-lu-cpr
  2009-01-01 12:00  =>     move cpt-ins to ws-vl-cpt-ins-cpr
  2009-01-01 12:00  =>     if fl-ins-cpr = 1
  2009-01-01 12:00  =>       exec RDMS
  2009-01-01 12:00  =>         insert into chk_pnt_rst
  2009-01-01 12:00  =>           columns (mr_prg_maj  =  'ARCHII',
  2009-01-01 12:00  =>                    vl_pnt_rep  =  :ws-vl-pnt-rep,
  2009-01-01 12:00  =>                    mr_dat_maj  =  :ws-date,
  2009-01-01 12:00  =>                    mr_hre_maj  =  :ws-hre)
  2009-01-01 12:00  =>       end-exec
  2009-01-01 12:00  =>       evaluate sqlcode
  2009-01-01 12:00  =>         when 0
  2009-01-01 12:00  =>           move 0 to fl-ins-cpr
  2009-01-01 12:00  =>         when 100
  2009-01-01 12:00  =>           continue
  2009-01-01 12:00  =>         when other
  2009-01-01 12:00  =>         move "600-maj-cpr: insert" to ws-esql-trace
  2009-01-01 12:00  =>         perform 999-esql-err
  2009-01-01 12:00  =>         perform 999-esql-abort
  2009-01-01 12:00  =>       end-evaluate
  2009-01-01 12:00  =>     else
  2009-01-01 12:00  =>       exec RDMS
  2009-01-01 12:00  =>         update chk_pnt_rst
  2009-01-01 12:00  =>           columns (vl_pnt_rep  =  :ws-vl-pnt-rep)
  2009-01-01 12:00  =>           where    mr_prg_maj  =  'ARCHII'
  2009-01-01 12:00  =>       end-exec
  2009-01-01 12:00  =>       if sqlcode not = 0
  2009-01-01 12:00  =>           move "600-maj-cpr: update" to ws-esql-trace
  2009-01-01 12:00  =>           perform 999-esql-err
  2009-01-01 12:00  =>           perform 999-esql-abort
  2009-01-01 12:00  =>       end-if
  2009-01-01 12:00  =>     end-if
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  600-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>* GESTION DES ERREURS RDMS *
  2009-01-01 12:00  =>****************************
  2009-01-01 12:00  =>     COPY AMT_999-ESQL-ERRR          OF  COMMONS.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => 999-ESQL-ABORT.
  2009-01-01 12:00  =>*===============*
  2009-01-01 12:00  =>     CALL "EREABT$".
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
<DATA=Documentation>
  -MAP-
