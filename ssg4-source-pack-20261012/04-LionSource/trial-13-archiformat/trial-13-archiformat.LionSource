  2009-01-01 12:00  =>     IF (ADDZ-0-0 EQUAL TO 9999)  *> SSG-STUB [*NOCOND], [*NOZONEA//DDZ]
  2009-01-01 12:00  =>        ADD 1 TO NB-ANO-9999
  2009-01-01 12:00  =>        MOVE 1 TO ANOMALIE
  2009-01-01 12:00  =>        GO TO FIN-TRT-ADDZ-0-0.  *> SSG-STUB [*NOCOND], [*NOZONEAD//DZ]
  2009-01-01 12:00  =>     IF (ADDZ-0-0 LESS 1901)  *> SSG-STUB [*DATE_MIN], [*NOCOND], //[*NOZONEADDZ]
  2009-01-01 12:00  =>        ADD 1 TO NB-ANO-DMIN
  2009-01-01 12:00  =>        MOVE 1 TO ANOMALIE.
  2009-01-01 12:00  =>     IF (ADDZ-0-0 GREATER 2019)  *> SSG-STUB [*DATE_MAX], [*NOCOND//], [*NOZONEADDZ]
  2009-01-01 12:00  =>        ADD 1 TO NB-ANO-DMAX
  2009-01-01 12:00  =>        MOVE 1 TO ANOMALIE.
  2009-01-01 12:00  =>     MOVE 1 TO MODIFIE.
  2009-01-01 12:00  =>     ADD 1 TO ADDZ-0-0.  *> SSG-STUB [*NOCOND], [*NOZONEADDZ], [PA//RAM,I,1,3]
  2009-01-01 12:00  => FIN-TRT-ADDZ-0-0.  *> SSG-STUB [*NOCOND], [*NOZONEADDZ]
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>dIf
  2009-01-01 12:00  => 1 = COND  *> SSG-STUB [PARAM,I,1,1]
  2009-01-01 12:00  => Set PARAMOLD = 'C'
  2009-01-01 12:00  =>se
  2009-01-01 12:00  => Set PARAMOLD = ' '
  2009-01-01 12:00  =>dIf
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => GEN-ERR-PAR.
  2009-01-01 12:00  =>     DISPLAY 'GENERAL ERROR ***' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-STATUS      = ' ERROR-STATUS    UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-NUM         = ' ERROR-NUM       UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-AREA        = ' ERROR-AREA      UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-RECORD      = ' ERROR-RECORD    UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-SET         = ' ERROR-SET       UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'I/O-ERROR-STATUS  = ' IO-ERROR-STATUS UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE ALL ON ERROR GO TO DEPART-WITH-ROLLBACK.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => DEPART-WITH-ROLLBACK.
  2009-01-01 12:00  =>     DEPART WITH ROLLBACK.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => RBK-PAR.
  2009-01-01 12:00  =>     DISPLAY '------------------------------'       UPON PRINER.
  2009-01-01 12:00  =>     DISPLAY 'NB REC LUS         = ' REC-LU         UPON PRINER.
  2009-01-01 12:00  =>     DISPLAY 'NB REC MODIFIES    = ' REC-MODIFIE    UPON PRINER.
  2009-01-01 12:00  =>     DISPLAY 'NB REC ECRITS      = ' REC-ECRIT      UPON PRINER.
  2009-01-01 12:00  =>     DISPLAY '------------------------------'       UPON PRINER.
  2009-01-01 12:00  =>     DISPLAY 'ROLLBACK ERROR ***' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-STATUS      = ' ERROR-STATUS    UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-NUM         = ' ERROR-NUM       UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-AREA        = ' ERROR-AREA      UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-RECORD      = ' ERROR-RECORD    UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'ERROR-SET         = ' ERROR-SET       UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'I/O-ERROR-STATUS  = ' IO-ERROR-STATUS UPON PRINTER.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => RK2.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  =>F$.
  2009-01-01 12:00  =>UX C$DML
  2009-01-01 12:00  =>MRC I1,025000
  2009-01-01 12:00  =>$LIB$*ACOB-DML.CBEP$$ACOB/FULL-LIB-CB
  2009-01-01 12:00  =>MU     D1,0164000
  2009-01-01 12:00  =>*DIS
  2009-01-01 12:00  =>ORKCONDIS
  2009-01-01 12:00  =>TST*Y2-SCHABS.S$WORK/Y2SSCHEMA
  2009-01-01 12:00  =>$.CLSEG$
  2009-01-01 12:00  =>$$SRC*DMRMT$.CBEP$$DMS
  2009-01-01 12:00  =>$LIB$*RSA.RDMR-ACOBDAT
  2009-01-01 12:00  =>$LIB$*RSA.CBEP$$RSA
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  *   Set Debug to '' 
  *   Set Debug to 'N'
  *   Create SGS: LIST 0  
  *   Create SGS: LISTM 0 
  *   Create SGS: LISTA 1   SSG-STUB [LISTM,1,1,1]
  *   Display 'Vous devez pr?ciser le type de donn?es trait?es avec une carte'
  *   Display 'FD (fichier CFH),' 
  *   Display 'AF (fichier SDF Fieldata - param?tre par d?faut),' 
  *   Display 'AA ou ASCII (fichier SDF Ascii) ou'
  *   Display 'DMS (base de donn?e DMS)'  
  *Remove Variable v  
  *   If not 1   SSG-STUB [DMS,1,1]
  *      Display 'Carte DMS incompl?te'   
  *      Display 'DMS UPDATE|RETRIEVAL'   
  *      Abort
  *   ElseIf 1 <> UPDATE and 1 <> RETRIEVAL   SSG-STUB [DMS,1,1,1]
  *      Display 'Carte DMS incorrecte'   
  *      Display 'DMS UPDATE|RETRIEVAL'   
  *      Abort
  *   ElseIf 1 <> UPDATE and [Info$,1,4,1] <> UNIQU   SSG-STUB [DM
  *      Display 'User not authorized to update DMS'  
  *      Display 'Please contact your SSG administrator'  
  *   EndIf   
        **************************
  PROGRAM-ID. *-----------* /.
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
