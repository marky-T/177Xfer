  2009-01-01 12:00  =>*====================*
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Configuration section.
  2009-01-01 12:00  =>*----------------------*
  2009-01-01 12:00  => source-computer.  unisys-2200.
  2009-01-01 12:00  => object-computer.  unisys-2200 MEMORY 3 MODULES.
  2009-01-01 12:00  => special-names.
  2009-01-01 12:00  =>     printer       printer.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Input-output section.
  2009-01-01 12:00  =>*---------------------*
  2009-01-01 12:00  => file-control.
  2009-01-01 12:00  =>     select ficout assign to disc      1.  *> SSG-STUB [fname,1,1,//1]
  2009-01-01 12:00  => i-o-control.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Data division.
  2009-01-01 12:00  =>*==============*
  2009-01-01 12:00  =>
  2009-01-01 12:00  => File section.
  2009-01-01 12:00  =>*-------------*
  2009-01-01 12:00  =>* Fichier pour architab2
  2009-01-01 12:00  => FD  ficout.
  2009-01-01 12:00  =>  1  ligneout              pic x(80).
  2009-01-01 12:00  =>
  2009-01-01 12:00  => Working-storage section.
  2009-01-01 12:00  =>*------------------------*
  2009-01-01 12:00  =>   1 ligne-type0.
  2009-01-01 12:00  =>     3 cd-don0                   pic x value "0".
  2009-01-01 12:00  =>     3 nm-bas0                   pic x(6).
  2009-01-01 12:00  =>     3 nm-tab0                   pic x(30).
  2009-01-01 12:00  =>     3 dt-ach0                   pic x(8).
  2009-01-01 12:00  =>     3 dt-tab                    pic x(8) value space.
  2009-01-01 12:00  =>   1 ligne-type1.
  2009-01-01 12:00  =>     3 cd-don1                   pic x value "1".
  2009-01-01 12:00  =>     3 nm-cle                    pic x(30).
  2009-01-01 12:00  =>     3 ds-cle.
  2009-01-01 12:00  =>      5 type-cle                 pic x.
  2009-01-01 12:00  =>      5 longueur                 pic 99.99.
  2009-01-01 12:00  =>   1 ligne-type9.
  2009-01-01 12:00  =>     3 cd-don9                   pic x value "9".
  2009-01-01 12:00  =>     3 nm-bas9                   pic x(6).
  2009-01-01 12:00  =>     3 nm-tab9                   pic x(30).
  2009-01-01 12:00  =>     3 dt-ach9                   pic x(8).
  2009-01-01 12:00  =>     3 nombre                    pic s9(11) sign leading
  2009-01-01 12:00  =>       separate value 99999999999.
  2009-01-01 12:00  =>     3 nombre2                   pic s9(11) sign leading
  2009-01-01 12:00  =>       separate value 99999999999.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  =>*-------------------
  2009-01-01 12:00  =>   000-main.
  2009-01-01 12:00  =>     open output ficout
  2009-01-01 12:00  =>     perform 100-type0 thru 100-exit
  2009-01-01 12:00  =>     perform 101-type1 thru 101-exit
  2009-01-01 12:00  =>     perform 102-type9 thru 102-exit
  2009-01-01 12:00  =>     close ficout
  2009-01-01 12:00  =>     stop run
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>*------------ ENREGISTREMENT DE TYPE 0 ----------------
  2009-01-01 12:00  =>  100-type0.
  2009-01-01 12:00  =>     move "1" to nm-bas0  *> SSG-STUB [tname,1,1,1]
  2009-01-01 12:00  =>     move "1" to nm-tab0  *> SSG-STUB [tname,1,1,2]
  2009-01-01 12:00  =>     accept dt-ach0 from date yyyymmdd
  2009-01-01 12:00  =>     write ligneout from ligne-type0
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  100-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*------------ ENREGISTREMENT DE TYPE 1 -----------------
  2009-01-01 12:00  =>  101-type1.
  2009-01-01 12:00  =>     move "CLE-TABLE" to nm-cle  *> SSG-STUB [key,1,1,1]
  2009-01-01 12:00  =>     move "N" to type-cle  *> SSG-STUB [key,1,1,2]
  2009-01-01 12:00  =>     move 10 to longueur  *> SSG-STUB [key,1,1,3]
  2009-01-01 12:00  =>     write ligneout from ligne-type1
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  101-exit.
  2009-01-01 12:00  =>     exit.
  2009-01-01 12:00  =>*------------ ENREGISTREMENT DE TYPE 9 -----------------
  2009-01-01 12:00  =>  102-type9.
  2009-01-01 12:00  =>     move "1" to nm-bas9  *> SSG-STUB [tname,1,1,1]
  2009-01-01 12:00  =>     move "1" to nm-tab9  *> SSG-STUB [tname,1,1,2]
  2009-01-01 12:00  =>     accept dt-ach9 from date yyyymmdd
  2009-01-01 12:00  =>     write ligneout from ligne-type9
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>  102-exit.
  2009-01-01 12:00  =>     exit.
