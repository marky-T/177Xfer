  2009-01-01 12:00  =>     ENTER  SST60  SUBROUTINE REFERENCING '-' FIXDATA1.  *> SSG-ST//UB [*I]
  2009-01-01 12:00  =>     MOVE                  FIXED1 TO FIXDATA1.  *> SSG-STUB [*I], //[*I]
  2009-01-01 12:00  =>     WRITE LISTE  FROM RECOUT AFTER 2.
  2009-01-01 12:00  =>     ADD 1  TO NB-LUS.
  2009-01-01 12:00  =>     ADD 1  TO LNCTR.
  2009-01-01 12:00  =>     IF  ZONE2  <  1  *> SSG-STUB [STARTFIELD,1,1,1]
  2009-01-01 12:00  =>     ADD 1  TO REC-SKIPPED
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  =>     IF  NB-LUS  <  1  *> SSG-STUB [STARTREC,1,1,1]
  2009-01-01 12:00  =>     ADD 1  TO REC-SKIPPED
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  =>     WRITE RECOUT AFTER 2.
  2009-01-01 12:00  =>     IF  NB-LUS  NOT <  COPY-LIMIT  GO TO FINW.
  2009-01-01 12:00  =>     IF  NB-LUS  =  1  *> SSG-STUB [REPSIM,1,1,1]
  2009-01-01 12:00  =>     ADD 1  TO LNCTR.
  2009-01-01 12:00  =>     GO TO FINW
  2009-01-01 12:00  =>     ELSE  GO TO REPSIM.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     DISPLAY  '*CFH-COPY  FIN*'  UPON  PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-LUS ='  NB-LUS  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE  TAPEIN.
  2009-01-01 12:00  =>     CLOSE  TAPEOUT.
  2009-01-01 12:00  =>     DISPLAY  REC-SKIPPED  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE PRINTOUT.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
