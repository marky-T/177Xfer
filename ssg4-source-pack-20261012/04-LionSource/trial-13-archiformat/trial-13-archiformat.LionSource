  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => OUVERT.
  2009-01-01 12:00  =>     OPEN OUTPUT IMP.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP1 BEFORE PAGE.
  2009-01-01 12:00  =>     OPEN INPUT FICHIN.
  2009-01-01 12:00  =>              MOVE LOW-VALUES TO SYMK.
  2009-01-01 12:00  =>     START  FICHIN KEY IS GREATER THAN SYMK INVALID KEY
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>              MOVE LOW-VALUES TO SYMK1.
  2009-01-01 12:00  =>     START  FICHIN KEY IS GREATER THAN SYMK1 INVALID KEY
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>              MOVE LOW-VALUES TO SYMK2.
  2009-01-01 12:00  =>     START  FICHIN KEY IS GREATER THAN SYMK2 INVALID KEY
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  => LECTURE.
  2009-01-01 12:00  =>     READ FICHIN NEXT RECORD INTO WREC AT END GO TO FIN.
  2009-01-01 12:00  =>     ADD 1 TO CTR.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>        IF
  2009-01-01 12:00  =>     1  *> SSG-STUB [COND,1,I,1]
  2009-01-01 12:00  =>              NEXT SENTENCE
  2009-01-01 12:00  =>                                ELSE GO TO FIN.
  2009-01-01 12:00  => SUITE.
  2009-01-01 12:00  =>     MOVE CTR TO FILCO.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM TIT BEFORE 1.
  2009-01-01 12:00  =>     MOVE WREC TO ZPR.
  2009-01-01 12:00  =>     PERFORM IMPRES THRU FIIMPRES.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  =>     OPEN INPUT FICHIN.
  2009-01-01 12:00  =>     OPEN INPUT CARTE.
  2009-01-01 12:00  => LOOP.
  2009-01-01 12:00  =>     READ CARTE AT END GO TO FIN.
  2009-01-01 12:00  =>     MOVE ZL1 TO SYMK INDICATIF2.
  2009-01-01 12:00  =>     PERFORM FORMAT-CLE THRU FORMAT-CLE-EXIT
  2009-01-01 12:00  =>     MOVE    TAB-OUTPUT TO SYMK  INDICATIF2
  2009-01-01 12:00  =>*    display 'symk  = ' symk upon printer.
  2009-01-01 12:00  =>     START FICHIN KEY = SYMK INVALID KEY ADD 1 TO CTR
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     MOVE ZL1 TO SYMK1 INDICATIF2.
  2009-01-01 12:00  =>     PERFORM FORMAT-CLE THRU FORMAT-CLE-EXIT
  2009-01-01 12:00  =>     MOVE    TAB-OUTPUT TO SYMK1 INDICATIF2
  2009-01-01 12:00  =>*    display 'symk1 = ' symk1 upon printer.
  2009-01-01 12:00  =>     START FICHIN KEY = SYMK1 INVALID KEY ADD 1 TO CTR
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     MOVE ZL1 TO SYMK2 INDICATIF2.
  2009-01-01 12:00  =>     PERFORM FORMAT-CLE THRU FORMAT-CLE-EXIT
  2009-01-01 12:00  =>     MOVE    TAB-OUTPUT TO SYMK2 INDICATIF2
  2009-01-01 12:00  =>*    display 'symk2 = ' symk2 upon printer.
  2009-01-01 12:00  =>     START FICHIN KEY = SYMK2 INVALID KEY ADD 1 TO CTR
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  => LECTURE-RANDOM.
  2009-01-01 12:00  =>     READ FICHIN NEXT INTO WREC AT END
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     IF SYMK = INDICATIF2
  2009-01-01 12:00  =>     MOVE WREC TO ZPR PERFORM IMPRES THRU FIIMPRES
  2009-01-01 12:00  =>     GO TO LECTURE-RANDOM.
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     READ FICHIN NEXT INTO WREC AT END
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     IF SYMK1 = INDICATIF2
  2009-01-01 12:00  =>     MOVE WREC TO ZPR PERFORM IMPRES THRU FIIMPRES
  2009-01-01 12:00  =>     GO TO LECTURE-RANDOM.
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     READ FICHIN NEXT INTO WREC AT END
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  =>     IF SYMK2 = INDICATIF2
  2009-01-01 12:00  =>     MOVE WREC TO ZPR PERFORM IMPRES THRU FIIMPRES
  2009-01-01 12:00  =>     GO TO LECTURE-RANDOM.
  2009-01-01 12:00  =>     GO TO ERREUR.
  2009-01-01 12:00  => ERREUR.
  2009-01-01 12:00  =>     GO TO LOOP.
  2009-01-01 12:00  => FIN.
  2009-01-01 12:00  =>     MOVE SPACES TO ZPRINT.
  2009-01-01 12:00  =>     WRITE ZPRINT BEFORE SAUT.
  2009-01-01 12:00  =>     DISPLAY '** FIN DU TRAVAIL **' UPON PRINTER.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE DE RECORDS LUS ** ' CTR UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE D INVALID KEY **' CTR UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE FICHIN IMP.
  2009-01-01 12:00  =>     CLOSE CARTE.
  2009-01-01 12:00  =>     STOP RUN.
