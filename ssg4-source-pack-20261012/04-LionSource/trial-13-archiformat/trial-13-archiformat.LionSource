<DATA=Code>
  2009-01-01 12:00  =>    IDENTIFICATION DIVISION.
  2009-01-01 12:00  => PROGRAM-ID. MONTANT.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT  FILEIN  ASSIGN TO DISC FILEIN-1.  *> SSG-STUB [INPUT,//1,1,1]
  2009-01-01 12:00  =>     SELECT  FILEOUT ASSIGN TO DISC FILEOUT-1.  *> SSG-STUB [OUTPU//T,1,1,1]
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  FILEIN
  2009-01-01 12:00  =>     LABEL RECORD IS STANDARD
  2009-01-01 12:00  =>     BLOCK CONTAINS 1  RECORDS  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  =>     RECORD CONTAINS 80  CHARACTERS  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  =>     DATA RECORD IS REC-IN.
  2009-01-01 12:00  => 01  REC-IN             PIC X(80).  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  => FD  FILEOUT
  2009-01-01 12:00  =>     LABEL RECORD IS STANDARD
  2009-01-01 12:00  =>     BLOCK CONTAINS 1  RECORDS  *> SSG-STUB [OUTPUT,1,1,3]
  2009-01-01 12:00  =>     RECORD CONTAINS 80  CHARACTERS  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  =>     DATA RECORD IS REC-OUT.
  2009-01-01 12:00  => 01  REC-OUT            PIC X(80).  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  WS-IN  PIC X(80).  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  => 01  WS-IN1 REDEFINES WS-IN.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>         03 FILLER    PIC X(1).  *> SSG-STUB [*FILLUN]
  2009-01-01 12:00  =>         03 MONTANT1  PIC S9(9).  *> SSG-STUB [*I], [MONTANT,I,1,2//]
  2009-01-01 12:00  =>         03 FILLER    PIC X(1).  *> SSG-STUB [*FILLDEU]
  2009-01-01 12:00  => 01  WS-OUT  PIC X(80).  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  => 01  WS-OUT1 REDEFINES WS-OUT.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>         03 FILLER    PIC X(1).  *> SSG-STUB [*FILLUN]
  2009-01-01 12:00  =>         03 MONTANT1  PIC S9(9).  *> SSG-STUB [*I], [MONTANT,I,1,2//]
  2009-01-01 12:00  =>         03 FILLER    PIC X(1).  *> SSG-STUB [*FILLDEU]
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT FILEIN
  2009-01-01 12:00  =>          OUTPUT FILEOUT.
  2009-01-01 12:00  => LECTURE.
  2009-01-01 12:00  =>     READ FILEIN INTO WS-IN AT END GO TO FIN.
  2009-01-01 12:00  =>     MOVE WS-IN TO WS-OUT.
  2009-01-01 12:00  =>     COMPUTE MONTANT1 OF WS-OUT1 = MONTANT1 OF WS-IN1 * +1  *> SSG//-STUB [*I], [*I], [*I], [*I]
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>     WRITE REC-OUT FROM WS-OUT.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  => FIN.
  2009-01-01 12:00  =>     CLOSE FILEIN FILEOUT.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
