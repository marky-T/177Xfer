COBOL
</IN FOLDER>
</OBJECT>
<OBJECT=ASSURFED_UTILIT_CONDIS_ASCII(P),COBOL PROGRAM>
<REVDATA>
<VERSION=1.0>
<USER=>
<DATE=20090101>
<TIME=1200>
<LOCKED=False>
<DESCRIPTION=COBOL PROGRAM>
</REVDATA>
<DATA=Options>
  Name=ASSURFED_UTILIT_CONDIS_ASCII(P)
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  => Set Debug to ''
  2009-01-01 12:00  =>t Debug to 'N'
  2009-01-01 12:00  =>eate SGS: LIST 0
  2009-01-01 12:00  =>eate SGS: LISTM 0
  2009-01-01 12:00  =>eate SGS: LISTA 1  *> SSG-STUB [LISTM,1,1,1]
  2009-01-01 12:00  =>splay 'Vous devez pr�ciser le type de donn�es trait�es avec //une carte'
  2009-01-01 12:00  =>splay 'FD (fichier CFH),'
  2009-01-01 12:00  =>splay 'AF (fichier SDF Fieldata - param�tre par d�faut),'
  2009-01-01 12:00  =>splay 'AA ou ASCII (fichier SDF Ascii) ou'
  2009-01-01 12:00  =>splay 'DMS (base de donn�e DMS)'
  2009-01-01 12:00  =>e Variable v
  2009-01-01 12:00  => not 1  *> SSG-STUB [DMS,1,1]
  2009-01-01 12:00  => Display 'Carte DMS incompl�te'
  2009-01-01 12:00  => Display 'DMS UPDATE|RETRIEVAL'
  2009-01-01 12:00  => Abort
  2009-01-01 12:00  =>seIf 1 <> UPDATE and 1 <> RETRIEVAL  *> SSG-STUB [DMS,1,1,1], [DMS//,1,1,1]
  2009-01-01 12:00  => Display 'Carte DMS incorrecte'
  2009-01-01 12:00  => Display 'DMS UPDATE|RETRIEVAL'
  2009-01-01 12:00  => Abort
  2009-01-01 12:00  =>seIf 1 <> UPDATE and [Info$,1,4,1] <> UNIQU  *> SSG-STUB [DMS,1,1,//1]
  2009-01-01 12:00  => Display 'User not authorized to update DMS'
  2009-01-01 12:00  => Display 'Please contact your SSG administrator'
  2009-01-01 12:00  =>dIf
