  2009-01-01 12:00  =>     SELECT  BDE1  ASSIGN TO  *> SSG-STUB [*I]
  2009-01-01 12:00  =>         UNISERVO FILEIN-1.  *> SSG-STUB [INPUT,1,1,1]
  2009-01-01 12:00  =>         DISC FILEIN-1.  *> SSG-STUB [INPUT,1,1,1]
