<DATA=Options>
  Name=ASSURFED_UTILIT_SCAN-VAR_ASCII(P)
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  =>
  2009-01-01 12:00  => IDENTIFICATION DIVISION.
  2009-01-01 12:00  => PROGRAM-ID. SCAN.
  2009-01-01 12:00  => AUTHOR.     HANSE.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER.  UNISYS-2200.
  2009-01-01 12:00  => OBJECT-COMPUTER.  UNISYS-2200.
  2009-01-01 12:00  => SPECIAL-NAMES.  PRINTER IS LISTE.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT  TAPEIN  ASSIGN
  2009-01-01 12:00  =>                        UNISERVO FILEIN-1.  *> SSG-STUB [INPUT,1,1//,1]
  2009-01-01 12:00  =>                        DISC FILEIN-1.  *> SSG-STUB [INPUT,1,1,1]
  2009-01-01 12:00  =>     SELECT  PRT  ASSIGN  TO  PRINTER.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  TAPEIN
  2009-01-01 12:00  =>             LABEL RECORD IS OMITTED
  2009-01-01 12:00  =>             LABEL RECORD IS STANDARD
  2009-01-01 12:00  =>     BLOCK  CONTAINS 1  1  *> SSG-STUB [BLOCK,1,1,1], [BLOCK,1,1,2//]
  2009-01-01 12:00  =>F 1 > 3  *> SSG-STUB [INPUT,1,1]
  2009-01-01 12:00  =>     BLOCK  CONTAINS 80  RECORDS  *> SSG-STUB [INPUT,1,1,4]
  2009-01-01 12:00  =>LSE
  2009-01-01 12:00  =>     BLOCK  CONTAINS 1  RECORDS  *> SSG-STUB [INPUT,1,1,3]
  2009-01-01 12:00  =>ND
  2009-01-01 12:00  =>     RECORD CONTAINS 80 TO 1 CHARACTERS  *> SSG-STUB [INPUT,1,1,2]//, [INPUT,1,1,3]
  2009-01-01 12:00  =>     RECORD CONTAINS 80  CHARACTERS  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  => 01  ZIN1   PIC X(1).  *> SSG-STUB [DESC,I,1,1], [DESC,I,1,1]
  2009-01-01 12:00  => 01  ZIN                PIC X(80).  *> SSG-STUB [INPUT,1,1,2]
  2009-01-01 12:00  => FD  PRT      LABEL RECORD IS OMITTED  DATA RECORD IS PRT-LINE.
  2009-01-01 12:00  => 01  PRT-LINE          PIC X(100)          USAGE  DISPLAY-1.
  2009-01-01 12:00  => 01  PRT-LINE           PIC X(100).
