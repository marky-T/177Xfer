<OBJECT=ASSURFED_UTILIT_ECLAT(P),COBOL PROGRAM>
<REVDATA>
<VERSION=1.0>
<USER=>
<DATE=20090101>
<TIME=1200>
<LOCKED=False>
<DESCRIPTION=COBOL PROGRAM>
</REVDATA>
<DATA=Options>
  Name=ASSURFED_UTILIT_ECLAT(P)
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  =>   ***************************************************************//****
  2009-01-01 12:00  =>***                     -- UGXB02 --                            ***
  2009-01-01 12:00  =>***     PROGRAMME D'EXTRACTION DES ENREGISTREMENTS A ARCHIVER   ***
  2009-01-01 12:00  =>***                     ------------                            ***
  2009-01-01 12:00  =>***                                                             ***
  2009-01-01 12:00  =>*******************************************************************
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>*******************************************************************
  2009-01-01 12:00  =>* Type     : BATCH RDMS                      (BATCH, TRANSACTION) *
  2009-01-01 12:00  =>* Analyste : VG                              (INITIALES)          *
  2009-01-01 12:00  =>* Auteur   : GIUSEPPI VALERIE                (NOM, PRENOM)        *
  2009-01-01 12:00  =>* Release  : 01                              (2 CHIFFRES)         *
  2009-01-01 12:00  =>* Version  : 001                             (3 CHIFFRES)         *
  2009-01-01 12:00  =>*******************************************************************
  2009-01-01 12:00  =>*  Modification                                                   *
  2009-01-01 12:00  =>*  Qui ?    Quand ?     Quoi ?                             Projet *
  2009-01-01 12:00  =>* .PP     .29/03/1996.  CREATION                          .ARCHIV
  2009-01-01 12:00  =>* .       .__/__/____.                                    .       *
  2009-01-01 12:00  =>* .       .__/__/____.                                    .       *
  2009-01-01 12:00  =>* .       .__/__/____.                                    .       *
  2009-01-01 12:00  =>* .       .__/__/____.                                    .       *
  2009-01-01 12:00  =>* .       .__/__/___ .                                    .       *
  2009-01-01 12:00  =>* .       .__/__/___ .                                    .       *
  2009-01-01 12:00  =>* .       .__/__/___ .                                    .       *
  2009-01-01 12:00  =>* .       .__/__/___ .                                    .       *
  2009-01-01 12:00  =>*******************************************************************
  2009-01-01 12:00  =>
  2009-01-01 12:00  => IDENTIFICATION DIVISION.
  2009-01-01 12:00  => PROGRAM-ID. UGXB02.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => DATE-WRITTEN. 29/03/96.
  2009-01-01 12:00  => DATE-COMPILED.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER. UNISYS-2200.
  2009-01-01 12:00  => OBJECT-COMPUTER. UNISYS-2200 MEMORY 3 MODULES.
  2009-01-01 12:00  => SPECIAL-NAMES.
  2009-01-01 12:00  =>     PRINTER IS PRINER
  2009-01-01 12:00  =>     DECIMAL-POINT IS COMMA
  2009-01-01 12:00  =>     PRINTER IS PRINTER
  2009-01-01 12:00  =>     CARD-READER    CARD-READER
  2009-01-01 12:00  =>     CARD-PUNCH     CARD-PUNCH
  2009-01-01 12:00  =>     CONSOLE         CONSOLE
  2009-01-01 12:00  =>     CURRENCY    "F".
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT 1 ASSIGN TO DISC 1.  *> SSG-STUB [FILEKEY,1,1,1], [FIL//EKEY,1,1,1]
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>     SELECT SCHEMA1 ASSIGN TO DISC SCHEMA1.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>     SELECT FARCHIVE ASSIGN TO DISC 1.  *> SSG-STUB [FARCHIVE,1,1,//1]
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>     SELECT FENCOURS ASSIGN TO DISC 1.  *> SSG-STUB [FENCOURS,1,1,//1]
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  1  *> SSG-STUB [FILEKEY,1,1,1]
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>*    DECLARATION DE LA CHERCHEUSE GENERE PAR SSG
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>      LABEL RECORDS ARE STANDARD.
  2009-01-01 12:00  => 01  ENR-CHER.
  2009-01-01 12:00  =>     02  FILLER PIC X(1).  *> SSG-STUB [*fil]
  2009-01-01 12:00  =>     02  KEY1   PIC X(1).  *> SSG-STUB [key,a,1,2], [*a]
  2009-01-01 12:00  =>     02  FILLER PIC X(1).  *> SSG-STUB [*FIL]
  2009-01-01 12:00  => FD  SCHEMA1  *> SSG-STUB [table,1,1,1]
  2009-01-01 12:00  =>*   DECLARATION DU FICHIER SEQUENTIEL CONTENANT LA TABLE UNLOADEE
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>      LABEL RECORDS ARE STANDARD.
  2009-01-01 12:00  => 01  ENR-TAB.
  2009-01-01 12:00  =>     02  FILLER PIC X(1).  *> SSG-STUB [*fil]
  2009-01-01 12:00  =>     02  KEY-T1   PIC X(1).  *> SSG-STUB [key,b,1,2], [*B]
  2009-01-01 12:00  =>     02  FILLER PIC X(1).  *> SSG-STUB [*fil]
  2009-01-01 12:00  => FD  FARCHIVE
  2009-01-01 12:00  =>     LABEL RECORDS ARE STANDARD.
  2009-01-01 12:00  => 01  ENR-ARC.
  2009-01-01 12:00  =>     02 NOM-TAB         PIC X(30).
  2009-01-01 12:00  =>     02 DAT-ARC.
  2009-01-01 12:00  =>          03 DAT-SS     PIC 9(2).
  2009-01-01 12:00  =>          03 DAT-DAT.
  2009-01-01 12:00  =>              04 DAT-AA PIC 9(2).
  2009-01-01 12:00  =>              04 DAT-MM PIC 9(2).
  2009-01-01 12:00  =>              04 DAT-JJ PIC 9(2).
  2009-01-01 12:00  =>     02 CLES-TAB        PIC X(1).  *> SSG-STUB [filekey,1,1,2]
  2009-01-01 12:00  =>     02 ENR             PIC X(TABLE-ARCH).  *> SSG-STUB [table,1,1//,2]
  2009-01-01 12:00  => FD  FENCOURS
  2009-01-01 12:00  =>     LABEL RECORDS ARE STANDARD.
  2009-01-01 12:00  => 01  ENR-ENC            PIC X(TABLE-ARCH).  *> SSG-STUB [table,1,1//,2]
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  SEQ-KEY.
  2009-01-01 12:00  =>     02 S-KEY1   PIC X(1).  *> SSG-STUB [key,a,1,2], [*a]
  2009-01-01 12:00  => 01  SEQ-KEY-T.
  2009-01-01 12:00  =>     02 S-KEY-T1   PIC X(1).  *> SSG-STUB [key,a,1,2], [*a]
  2009-01-01 12:00  => 77  EOF-FILE            PIC X VALUE "0".
  2009-01-01 12:00  => 77  EOF-CHER            PIC X VALUE "0".
  2009-01-01 12:00  => 77  CPT-CHER            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  CPT-FILE            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  CPT-ENC             PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  CPT-ARC             PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 01  CPT-CHER-ED         PIC Z(10).
  2009-01-01 12:00  => 01  CPT-FILE-ED         PIC Z(10).
  2009-01-01 12:00  => 01  CPT-ENC-ED          PIC Z(10).
  2009-01-01 12:00  => 01  CPT-ARC-ED          PIC Z(10).
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  => 000-MAIN.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  =>     PERFORM 010-OUVERTURE
  2009-01-01 12:00  =>     PERFORM 020-TRT-PRINC UNTIL (EOF-CHER = "1" AND
  2009-01-01 12:00  =>                                 EOF-FILE = "1")
  2009-01-01 12:00  =>     IF EOF-FILE = "0"
  2009-01-01 12:00  =>        PERFORM LEC-FILE
  2009-01-01 12:00  =>*       PERFORM 030-TRT-SEC UNTIL (EOF-FILE = "1")
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     PERFORM 090-CLOTURE
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>******FONCTIONS*******
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  => LEC-CHER.
  2009-01-01 12:00  =>     READ 1 AT END MOVE "1" TO EOF-CHER  *> SSG-STUB [filekey,1,1,//1]
  2009-01-01 12:00  =>     END-READ
  2009-01-01 12:00  =>     IF EOF-CHER = "0"
  2009-01-01 12:00  =>        ADD 1 TO CPT-CHER
  2009-01-01 12:00  =>        MOVE KEY1 to S-KEY1  *> SSG-STUB [*a], [*a]
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        MOVE HIGH-VALUE TO SEQ-KEY
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  => LEC-FILE.
  2009-01-01 12:00  =>     READ SCHEMA1 AT END MOVE "1" TO EOF-FILE  *> SSG-STUB [table,//1,1,1]
  2009-01-01 12:00  =>     END-READ
  2009-01-01 12:00  =>     IF EOF-FILE = "0"
  2009-01-01 12:00  =>        ADD 1 TO CPT-FILE
  2009-01-01 12:00  =>        MOVE KEY-T1 to S-KEY-T1  *> SSG-STUB [*a], [*a]
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        MOVE HIGH-VALUE TO SEQ-KEY-T
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     .
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => 010-OUVERTURE.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  =>     OPEN INPUT 1 SCHEMA1  *> SSG-STUB [table,1,1,1], [filekey,1,1//,1]
  2009-01-01 12:00  =>          OUTPUT FARCHIVE FENCOURS
  2009-01-01 12:00  =>     ACCEPT DAT-DAT FROM DATE
  2009-01-01 12:00  =>     PERFORM LEC-CHER
  2009-01-01 12:00  =>     PERFORM LEC-FILE.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => 020-TRT-PRINC.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  =>     IF SEQ-KEY = SEQ-KEY-T
  2009-01-01 12:00  =>          MOVE "ARCHIS" TO NOM-TAB  *> SSG-STUB [table,1,1,3]
  2009-01-01 12:00  =>          IF DAT-AA < 28
  2009-01-01 12:00  =>             MOVE 20 TO DAT-SS
  2009-01-01 12:00  =>          ELSE
  2009-01-01 12:00  =>             MOVE 19 TO DAT-SS
  2009-01-01 12:00  =>          END-IF
  2009-01-01 12:00  =>          MOVE SEQ-KEY TO CLES-TAB
  2009-01-01 12:00  =>          MOVE ENR-TAB TO ENR
  2009-01-01 12:00  =>          WRITE ENR-ARC
  2009-01-01 12:00  =>          ADD 1 TO CPT-ARC
  2009-01-01 12:00  =>          PERFORM LEC-CHER
  2009-01-01 12:00  =>          PERFORM LEC-FILE
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>       IF SEQ-KEY > SEQ-KEY-T
  2009-01-01 12:00  =>          MOVE ENR-TAB TO ENR-ENC
  2009-01-01 12:00  =>          WRITE ENR-ENC
  2009-01-01 12:00  =>          ADD 1 TO CPT-ENC
  2009-01-01 12:00  =>          PERFORM LEC-FILE
  2009-01-01 12:00  =>       ELSE
  2009-01-01 12:00  =>*         ERREUR
  2009-01-01 12:00  =>          PERFORM LEC-CHER
  2009-01-01 12:00  =>       END-IF
  2009-01-01 12:00  =>     END-IF.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => 030-TRT-SEC.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  =>     MOVE ENR-TAB TO ENR-ENC
  2009-01-01 12:00  =>     WRITE ENR-ENC
  2009-01-01 12:00  =>     ADD 1 TO CPT-ENC
  2009-01-01 12:00  =>     PERFORM LEC-FILE.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => 090-CLOTURE.
  2009-01-01 12:00  =>**********************
  2009-01-01 12:00  =>     CLOSE 1 SCHEMA1 FARCHIVE FENCOURS  *> SSG-STUB [table,1,1,1],// [filekey,1,1,1]
  2009-01-01 12:00  =>     MOVE CPT-ENC TO CPT-ENC-ED
  2009-01-01 12:00  =>     MOVE CPT-ARC TO CPT-ARC-ED
  2009-01-01 12:00  =>     MOVE CPT-CHER TO CPT-CHER-ED
  2009-01-01 12:00  =>     MOVE CPT-FILE TO CPT-FILE-ED
  2009-01-01 12:00  =>     DISPLAY   '  LES TOTAUX DE CONTROLE:' UPON PRINER
  2009-01-01 12:00  =>     DISPLAY   '  ***********************' UPON PRINER
  2009-01-01 12:00  =>     DISPLAY             ' Nombre de records lus dans le fichier'
  2009-01-01 12:00  =>     ' 1 : ' CPT-CHER-ED UPON PRINER  *> SSG-STUB [filekey,1,1,1]
  2009-01-01 12:00  =>     DISPLAY             ' Nombre de records lus dans le fichier'
  2009-01-01 12:00  =>     ' SCHEMA1 : ' CPT-FILE-ED UPON PRINER  *> SSG-STUB [table,1,1//,1]
  2009-01-01 12:00  =>     DISPLAY           ' Nombre de records {crit dans le fichier'
  2009-01-01 12:00  =>     ' 1 : ' CPT-ARC-ED UPON PRINER  *> SSG-STUB [farchive,1,1,1]
  2009-01-01 12:00  =>     DISPLAY           ' Nombre de records {crit dans le fichier'
  2009-01-01 12:00  =>     ' 1 : ' CPT-ENC-ED UPON PRINER.  *> SSG-STUB [fencours,1,1,1]
  2009-01-01 12:00  =>CACHE/0,EXTENDED/0,NO-SHIFT,NO-DEBUG,OPTIM,SOURCE;
  2009-01-01 12:00  =>NO-UREP-XREF
  2009-01-01 12:00  =>
</DATA>
