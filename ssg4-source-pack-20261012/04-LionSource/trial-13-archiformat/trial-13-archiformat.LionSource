  2009-01-01 12:00  =>     02 CLEF PIC X(1).  *> SSG-STUB [KEYIS,1,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,1,1,3]
  2009-01-01 12:00  =>     02 CLEG PIC X(1).  *> SSG-STUB [KEYIS,2,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,2,1,3]
  2009-01-01 12:00  =>     02 CLEH PIC X(1).  *> SSG-STUB [KEYIS,3,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,3,1,3]
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 77  FF  PIC  9(10)  COMP  VALUE 1.
  2009-01-01 12:00  => 77  CTRIN  PIC  9(10)  COMP  VALUE  0.
  2009-01-01 12:00  => 01  WREC.
  2009-01-01 12:00  =>     02 FILLER  PIC  X(80).  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  => 01  WREC1     REDEFINES  WREC.
  2009-01-01 12:00  =>     02 FILLER   PIC  X(1).  *> SSG-STUB [KEYIS,1,1,1]
  2009-01-01 12:00  =>     02 KEYA PIC X(1).  *> SSG-STUB [KEYIS,1,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,1,1,3]
  2009-01-01 12:00  =>     02 KEYB PIC X(1).  *> SSG-STUB [KEYIS,2,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,2,1,3]
  2009-01-01 12:00  =>     02 KEYA PIC X(1).  *> SSG-STUB [KEYIS,1,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,1,1,3]
  2009-01-01 12:00  =>     02 KEYB PIC X(1).  *> SSG-STUB [KEYIS,2,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,2,1,3]
  2009-01-01 12:00  =>     02 FILLER   PIC  X(1).  *> SSG-STUB [KEYIS,1,1,1]
  2009-01-01 12:00  =>     02 KEYA PIC X(1).  *> SSG-STUB [KEYIS,1,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,1,1,3]
  2009-01-01 12:00  =>     02 KEYB PIC X(1).  *> SSG-STUB [KEYIS,2,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,2,1,3]
  2009-01-01 12:00  =>     02 KEYC PIC X(1).  *> SSG-STUB [KEYIS,3,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,3,1,3]
  2009-01-01 12:00  =>     02 KEYA PIC X(1).  *> SSG-STUB [KEYIS,1,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,1,1,3]
  2009-01-01 12:00  =>     02 KEYB PIC X(1).  *> SSG-STUB [KEYIS,2,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,2,1,3]
  2009-01-01 12:00  =>     02 KEYC PIC X(1).  *> SSG-STUB [KEYIS,3,1,2]
  2009-01-01 12:00  =>     02 FILLER PIC X(1).  *> SSG-STUB [KEYIS,3,1,3]
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT  BDE1.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     OPEN  OUTPUT  DISQ.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     GO TO LECT1 FINB  DEPENDING  ON FF.
  2009-01-01 12:00  => LECT1.
  2009-01-01 12:00  =>     MOVE SPACES TO Z1.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     READ  BDE1  INTO  WREC  AT END ADD 1 TO FF  GO TO LECT.
  2009-01-01 12:00  =>     GO TO CONT.
  2009-01-01 12:00  => CONT.
  2009-01-01 12:00  =>     MOVE KEYA     TO  CLEF.
  2009-01-01 12:00  =>     MOVE KEYB     TO  CLEG.
  2009-01-01 12:00  =>     MOVE KEYA     TO  CLEF.
  2009-01-01 12:00  =>     MOVE KEYB     TO  CLEG.
  2009-01-01 12:00  =>     MOVE KEYC     TO  CLEH.
  2009-01-01 12:00  =>     ADD  1  TO  CTRIN.
  2009-01-01 12:00  =>     WRITE ZDISQ FROM WREC INVALID KEY GO TO  ERRDISQ.
  2009-01-01 12:00  =>     MOVE SPACES TO WREC WREC1 ZDISQ.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINB.
  2009-01-01 12:00  =>     DISPLAY 'NB.RECORDS ECRITS'  CTRIN  UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE  DISQ.
  2009-01-01 12:00  =>     CLOSE  BDE1.  *> SSG-STUB [*I]
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => ERRDISQ.
  2009-01-01 12:00  =>     DISPLAY 'IS.ERROR'  CLEF  UPON  PRINTER.
  2009-01-01 12:00  =>     ENTER ASM 'ABORT'.
</DATA>
