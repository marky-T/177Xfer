  2009-01-01 12:00  =>     SELECT  TAPEOUT  ASSIGN
  2009-01-01 12:00  =>                   CARD-PUNCH.
  2009-01-01 12:00  =>                        DISC FILEOUT-1.  *> SSG-STUB [OUTPUT,1,1,1//]
  2009-01-01 12:00  =>     SELECT SORTFILE ASSIGN TO MASS-STORAGE XA.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  TAPE-1  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     LABEL  RECORD IS OMITTED
  2009-01-01 12:00  =>     LABEL RECORD STANDARD
  2009-01-01 12:00  =>             BLOCK CONTAINS 1 RECORDS  *> SSG-STUB [INPUT,1,A,3]
  2009-01-01 12:00  =>             DATA RECORD IS REC-IN-1.  *> SSG-STUB [*A]
  2009-01-01 12:00  => 01  REC-IN-1            PIC X(1).  *> SSG-STUB [INPUT,1,A,2], [*A//]
  2009-01-01 12:00  => FD  TAPEOUT  LABEL RECORD OMITTED
  2009-01-01 12:00  => FD  TAPEOUT  LABEL RECORD IS STANDARD
  2009-01-01 12:00  =>              RECORD CONTAINS 80 CHARACTERS  *> SSG-STUB [OUTPUT,1//,1,2]
  2009-01-01 12:00  =>              DATA RECORD IS REC-OUT.
  2009-01-01 12:00  => 01  REC-OUT           PIC X(80).  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  => SD  SORTFILE
  2009-01-01 12:00  =>              DATA RECORD IS SORT-REC.
  2009-01-01 12:00  => 01  SORT-REC   PIC  X(80).  *> SSG-STUB [OUTPUT,1,1,2]
  2009-01-01 12:00  => 01  SORT-R1.  *> SSG-STUB [*COL]
  2009-01-01 12:00  =>     03  SORT-KEY-1     PIC X(1).  *> SSG-STUB [KEYS,1,COL,2], [*C//OL]
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  INPUT-CT-MESS-1.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     03  FILLER         PIC X(24)
  2009-01-01 12:00  =>              VALUE  'INPUT RECORD COUNT FROM '.
  2009-01-01 12:00  =>     03  FILLER         PIC X(12)
  2009-01-01 12:00  =>              VALUE  '1'.  *> SSG-STUB [INPUT,1,A,1]
  2009-01-01 12:00  =>     03  INPUT-CT-1  PIC Z(11)9.  *> SSG-STUB [*A]
  2009-01-01 12:00  => 01  IN-CT-1         PIC  9(10)  COMP    VALUE ZERO.  *> SSG-STUB //[*A]
  2009-01-01 12:00  => 01  OUTPUT-CT-MESS.
  2009-01-01 12:00  =>     03  FILLER         PIC X(24)
  2009-01-01 12:00  =>              VALUE  'OUTPUT RECORD COUNT TO  '.
  2009-01-01 12:00  =>     03  FILLER         PIC X(12)
  2009-01-01 12:00  =>              VALUE  'FILEOUT-1 '.  *> SSG-STUB [OUTPUT,1,1,1]
  2009-01-01 12:00  =>     03  OUTPUT-CT      PIC  Z(11)9.
  2009-01-01 12:00  => 01  OUT-CT             PIC  9(10)   COMP   VALUE ZERO.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => SORT-START SECTION.
  2009-01-01 12:00  => SORTING.
  2009-01-01 12:00  =>     OPEN INPUT  TAPE-1.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     OPEN OUTPUT TAPEOUT.
  2009-01-01 12:00  =>     SORT SORTFILE ON ASCENDING KEY
  2009-01-01 12:00  =>                    SORT-KEY-1  *> SSG-STUB [*SK]
  2009-01-01 12:00  =>                        INPUT PROCEDURE  IS INP
  2009-01-01 12:00  =>                        OUTPUT PROCEDURE IS OUTP.
  2009-01-01 12:00  =>     GO  TO  CLOSE-FILES.
  2009-01-01 12:00  => INP SECTION.
  2009-01-01 12:00  => INPUT-PROC-1.  *> SSG-STUB [*B]
  2009-01-01 12:00  =>     READ   TAPE-1   INTO  SORT-REC  *> SSG-STUB [*B]
  2009-01-01 12:00  =>              AT END GO TO  CLOSE-1.  *> SSG-STUB [*B]
  2009-01-01 12:00  =>     ADD  1   TO  IN-CT-1.  *> SSG-STUB [*B]
  2009-01-01 12:00  =>     RELEASE  SORT-REC.                GO TO INPUT-PROC-1.  *> SSG//-STUB [*B]
  2009-01-01 12:00  => CLOSE-1.   CLOSE  TAPE-1.  *> SSG-STUB [*B], [*B]
  2009-01-01 12:00  => INP-EXIT.    EXIT.
  2009-01-01 12:00  => OUTP SECTION.
  2009-01-01 12:00  => OUTPUT-PROC.
  2009-01-01 12:00  =>     RETURN SORTFILE              AT END GO TO OUTP-EXIT.
  2009-01-01 12:00  =>     ADD  1  TO  OUT-CT.
  2009-01-01 12:00  =>     WRITE  REC-OUT  FROM SORT-REC.         GO TO OUTPUT-PROC.
  2009-01-01 12:00  => OUTP-EXIT.   EXIT.
  2009-01-01 12:00  => CLOSE-FILES  SECTION.
  2009-01-01 12:00  => ENDING-RUN.
  2009-01-01 12:00  =>     MOVE  IN-CT-1   TO  INPUT-CT-1.  *> SSG-STUB [*A], [*A]
  2009-01-01 12:00  =>     DISPLAY  INPUT-CT-MESS-1  UPON PRINTER.  *> SSG-STUB [*A]
  2009-01-01 12:00  =>     MOVE  OUT-CT  TO  OUTPUT-CT.
  2009-01-01 12:00  =>     DISPLAY  OUTPUT-CT-MESS  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE TAPEOUT.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
