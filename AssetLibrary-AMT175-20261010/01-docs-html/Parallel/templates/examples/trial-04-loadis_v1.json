      "usageExample": "%%ERUN \"UNLOADIS_MULT-NODUP\" %%FILEINPUT LU01 \"archive.bin\" %%FILEOUTPUT LU02 \"export.csv\" FORMAT=CSV KEYS=\"EMP_ID,DEPT\"",
