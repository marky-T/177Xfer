      "toolName": "LOADIS_MULT-NODUP",
      "description": "Load with deduplication - multi-key loading and duplicate removal (Trial 04 primary focus)",
      "filePath": "C:\\Amt\\Sources\\loadis_mult_nodup.cbl",
      "usageExample": "%%ERUN \"LOADIS_MULT-NODUP\" %%FILEINPUT LU01 \"raw-85M.dat\" %%FILEOUTPUT LU02 \"dedup.dat\" KEYS=\"EMP_ID,DEPT\" DEDUP=YES",
      "parameters": ["LU01:input-file (85M+ records)", "LU02:output-file", "KEYS:emp_id,dept", "DEDUP:yes/no", "SCALE:standard/xl/xxl"],
      "outputs": "Deduplicated records; timing: ~12 seconds for 85M records on standard hardware",
      "notes": "Trial 04 benchmark: Dedup 85M records by (EMP_ID, DEPT); performance target: <15 seconds"
    },
    {
      "toolName": "LECTIS_MULT",
      "description": "Multi-record reader with checkpoint support - used for LOADIS input in Trial 04",
      "filePath": "C:\\Amt\\Sources\\lectis_mult.cbl",
      "usageExample": "%%ERUN \"LECTIS_MULT\" %%FILEINPUT LU01 \"raw.dat\" %%FILEOUTPUT LU02 \"records.out\" CHECKPOINT=YES CHKPT_INTERVAL=1000000",
      "parameters": ["LU01:input", "LU02:output", "CHECKPOINT:yes/no", "CHKPT_INTERVAL:number"],
      "outputs": "Sequential records with checkpoint markers every N records",
      "notes": "In Trial 04, CHKPT_INTERVAL=1M for 85M record dataset enables resume capability"
    },
    {
      "toolName": "ARCHIFORMAT",
      "description": "Archive formatter - data transformation for LOADIS pipeline in Trial 04",
      "filePath": "C:\\Amt\\Sources\\archiformat.cbl",
      "usageExample": "%%ERUN \"ARCHIFORMAT\" %%FILEINPUT LU01 \"dedup.dat\" %%FILEOUTPUT LU02 \"archive.bin\" BLOCKSIZE=8192 ENCODING=EBCDIC",
      "parameters": ["LU01:input", "LU02:output", "BLOCKSIZE:4096|8192|16384", "ENCODING:EBCDIC|ASCII"],
      "outputs": "Formatted binary archive with metadata",
      "notes": "Trial 04 uses ENCODING=EBCDIC for mainframe compatibility"
    },
    {
      "toolName": "UNLOADIS_MULT-NODUP",
