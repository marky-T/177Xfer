      "usageExample": "%%ERUN \"SCAN-VAR_ASCII\" %%FILEINPUT LU01 \"dedup.dat\" %%FILEOUTPUT LU02 \"anomalies.txt\" PATTERN=\"^[A-Z]{3}[0-9]{5}$\" INVERTED=NO",
      "parameters": ["LU01:input", "LU02:output", "PATTERN:regex", "INVERTED:yes/no"],
