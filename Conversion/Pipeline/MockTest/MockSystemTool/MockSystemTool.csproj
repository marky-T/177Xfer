<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mock-system helper: seeds and probes the isolated AMT system database using AMT's own system-table classes.
       Build output goes into the isolated runner folder (see PROCESS.md step 6), never into Federale's AmtTools. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MockSystemTool</AssemblyName>
    <RootNamespace>MockSystemTool</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AmtBin Condition="'$(AmtBin)' == ''">E:\AMT_Work\Apps\Binaries\Programs</AmtBin>
    <!-- No deps.json: the host then loads every DLL in the folder, like the AMT programs folder it is copied from. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Asysco.Amt.Libs"><HintPath>$(AmtBin)\Asysco.Amt.Libs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Asysco.Amt.AmtSharedDataModel"><HintPath>$(AmtBin)\Asysco.Amt.AmtSharedDataModel.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
