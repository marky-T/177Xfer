COBOL
</IN FOLDER>
</OBJECT>
<OBJECT=LOADIS_ASCII_PREPARED,COBOL PROGRAM>
<REVDATA>
<VERSION=1.0>
<USER=>
<DATE=20090101>
<TIME=1200>
<LOCKED=False>
<DESCRIPTION=COBOL PROGRAM>
</REVDATA>
<DATA=Options>
  Name=LOADIS_ASCII_PREPARED
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  =>*DEFINE  FILER
  2009-01-01 12:00  =>*SET  FILLCTR TO  [#1]-1
  2009-01-01 12:00  =>*IF FILLCTR  IS  SET
  2009-01-01 12:00  =>           02  FILLER  PIC  X([*FILLCTR]).
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>*END FILER
  2009-01-01 12:00  =>*IF [ASCII] > 0
  2009-01-01 12:00  =>#ACOB,IE  .LOADIS/ASCII,.LOADIS/ASCII
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>#ACOB,IET .LOADIS/ASCII,.LOADIS/ASCII
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>       IDENTIFICATION DIVISION.
  2009-01-01 12:00  =>       PROGRAM-ID. LOADIS-ASCII.
  2009-01-01 12:00  =>       AUTHOR BOURDEAUD HUY 17/12/79.
  2009-01-01 12:00  =>       ENVIRONMENT DIVISION.
  2009-01-01 12:00  =>       CONFIGURATION SECTION.
  2009-01-01 12:00  =>       SOURCE-COMPUTER. UNIVAC-1100-60EIS.
  2009-01-01 12:00  =>       OBJECT-COMPUTER. UNIVAC-1100-60EIS.
  2009-01-01 12:00  =>       INPUT-OUTPUT SECTION.
  2009-01-01 12:00  =>       FILE-CONTROL.
  2009-01-01 12:00  =>*IF [VIDE] > 0
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>*INCREMENT  I  FROM  1  BY 1 TO [INPUT,1]
  2009-01-01 12:00  =>           SELECT  BDE[*I]  ASSIGN TO
  2009-01-01 12:00  =>*IF [INPUT,1,1] > 3
  2009-01-01 12:00  =>               UNISERVO [INPUT,1,1,1].
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>               DISC [INPUT,1,1,1].
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>*LOOP
  2009-01-01 12:00  =>*ENDIF
  2009-01-01 12:00  =>           SELECT DISQ ASSIGN TO DISC  [OUTPUT,1,1,1]
  2009-01-01 12:00  =>           ORGANIZATION IS INDEXED
  2009-01-01 12:00  =>           RESERVE 5 AREAS
  2009-01-01 12:00  =>           ACCESS  MODE IS SEQUENTIAL RECORD KEY IS CLEF
  2009-01-01 12:00  =>           FILE STATUS IS IO-STAT.
  2009-01-01 12:00  =>       DATA DIVISION.
  2009-01-01 12:00  =>       FILE SECTION.
  2009-01-01 12:00  =>*IF [VIDE] > 0
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>*INCREMENT I FROM 1 BY 1 TO  [INPUT,1]
  2009-01-01 12:00  =>       FD  BDE[*I]
  2009-01-01 12:00  =>           LABEL RECORD STANDARD
  2009-01-01 12:00  =>             BLOCK CONTAINS [INPUT,1,1,3]   RECORDS
  2009-01-01 12:00  =>           RECORD CONTAINS [INPUT,1,1,2] CHARACTERS
  2009-01-01 12:00  =>           DATA RECORD IS  Z[*I].
  2009-01-01 12:00  =>       01  Z[*I]   PIC  X([INPUT,1,1,2]).
  2009-01-01 12:00  =>*LOOP
  2009-01-01 12:00  =>*ENDIF
  2009-01-01 12:00  =>       FD  DISQ   LABEL RECORD STANDARD
  2009-01-01 12:00  =>           BLOCK CONTAINS [OUTPUT,1,1,3] RECORDS
  2009-01-01 12:00  =>           RECORD  CONTAINS [OUTPUT,1,1,2] CHARACTERS
  2009-01-01 12:00  =>             DATA RECORD IS ZDISQ CLEF.
  2009-01-01 12:00  =>       01  ZDISQ  PIC  X([OUTPUT,1,1,2]).
  2009-01-01 12:00  =>       01  CLEFA.
  2009-01-01 12:00  =>*IF [KEYIS,1,1,1] > 0
  2009-01-01 12:00  =>           02 FILLER PIC X([KEYIS,1,1,1]).
  2009-01-01 12:00  =>           02 CLEF PIC X([KEYIS,1,1,2]).
  2009-01-01 12:00  =>           02 FILLER PIC X([KEYIS,1,1,3]).
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>           02 CLEF PIC X([KEYIS,1,1,2]).
  2009-01-01 12:00  =>           02 FILLER PIC X([KEYIS,1,1,3]).
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>       WORKING-STORAGE SECTION.
  2009-01-01 12:00  =>       77  FF  PIC  9(10)  COMP  VALUE 1.
  2009-01-01 12:00  =>       77  CTRIN  PIC  9(10)  COMP  VALUE  0.
  2009-01-01 12:00  =>       01  WREC.
  2009-01-01 12:00  =>           02 FILLER  PIC  X([OUTPUT,1,1,2]).
  2009-01-01 12:00  =>       01  WREC1     REDEFINES  WREC.
  2009-01-01 12:00  =>*IF [KEYIS,1,1,1] > 0
  2009-01-01 12:00  =>           02 FILLER   PIC  X([KEYIS,1,1,1]).
  2009-01-01 12:00  =>           02 KEYA PIC X([KEYIS,1,1,2]).
  2009-01-01 12:00  =>           02 FILLER PIC X([KEYIS,1,1,3]).
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>           02 KEYA PIC X([KEYIS,1,1,2]).
  2009-01-01 12:00  =>           02 FILLER PIC X([KEYIS,1,1,3]).
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>*IF [ASCII] > 0
  2009-01-01 12:00  =>       01  IO-STAT.
  2009-01-01 12:00  =>           02 IO-FS1     PIC X VALUE '9'.
  2009-01-01 12:00  =>           02 IO-FS2     PIC X VALUE '9'.
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>       01  IO-STAT DISP-1.
  2009-01-01 12:00  =>           02 IO-FS1     PIC X VALUE '9' DISP-1.
  2009-01-01 12:00  =>           02 IO-FS2     PIC X VALUE '9' DISP-1.
  2009-01-01 12:00  =>*END IF
  2009-01-01 12:00  =>       PROCEDURE DIVISION.
  2009-01-01 12:00  =>       DEBUT.
  2009-01-01 12:00  =>*IF [VIDE] > 0
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>*INCREMENT  I  FROM  1  BY 1 TO [INPUT,1]
  2009-01-01 12:00  =>           OPEN INPUT  BDE[*I].
  2009-01-01 12:00  =>*LOOP
  2009-01-01 12:00  =>*ENDIF
  2009-01-01 12:00  =>           OPEN  OUTPUT  DISQ.
  2009-01-01 12:00  =>*IF [VIDE] > 0
  2009-01-01 12:00  =>*ELSE
  2009-01-01 12:00  =>       LECT.
  2009-01-01 12:00  =>           GO TO LECT1 FINB  DEPENDING  ON FF.
  2009-01-01 12:00  =>       LECT1.
  2009-01-01 12:00  =>*INCREMENT I FROM 1 BY 1 TO [INPUT,1]
  2009-01-01 12:00  =>           MOVE SPACES TO Z[*I].
  2009-01-01 12:00  =>*LOOP
  2009-01-01 12:00  =>           READ  BDE1  INTO  WREC  AT END ADD 1 TO FF  GO TO LECT.
  2009-01-01 12:00  =>           GO TO CONT.
  2009-01-01 12:00  =>       CONT.
  2009-01-01 12:00  =>           MOVE KEYA     TO  CLEF.
  2009-01-01 12:00  =>           ADD  1  TO  CTRIN.
  2009-01-01 12:00  =>           WRITE ZDISQ FROM WREC INVALID KEY GO TO  ERRDISQ.
  2009-01-01 12:00  =>           MOVE SPACES TO WREC WREC1 ZDISQ.
  2009-01-01 12:00  =>           GO TO LECT.
  2009-01-01 12:00  =>       FINB.
  2009-01-01 12:00  =>           DISPLAY 'NB.RECORDS ECRITS'  CTRIN  UPON PRINTER.
  2009-01-01 12:00  =>*INCREMENT I FROM 1 BY 1 TO [INPUT,1]
  2009-01-01 12:00  =>           CLOSE  BDE[*I].
  2009-01-01 12:00  =>*LOOP
  2009-01-01 12:00  =>*ENDIF
  2009-01-01 12:00  =>           CLOSE  DISQ.
  2009-01-01 12:00  =>           STOP RUN.
  2009-01-01 12:00  =>       ERRDISQ.
  2009-01-01 12:00  =>           DISPLAY 'IS.ERROR         : '  CLEF  UPON  PRINTER.
  2009-01-01 12:00  =>           DISPLAY 'STATUS           : ' IO-FS1 IO-FS2 UPON  PRINT//ER.
  2009-01-01 12:00  =>           DISPLAY 'RECORD EN ERREUR : ' CTRIN ' EME'  UPON PRINTE//R.
  2009-01-01 12:00  =>           ENTER ASM 'ABORT'.
  2009-01-01 12:00  =>#MAP,S    ASSURFED*UTILITASCII.MAP,TPF$.LOADIS
  2009-01-01 12:00  =>#HDG,N
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  *DEFINE  FILER  
  *SET  FILLCTR TO  [#1]-1
  *IF FILLCTR  IS  SET
  *END IF
  *END FILER
  *IF [ASCII] > 0 
  *ELSE   
  *END IF
  PROGRAM-ID. AUTHOR BOURDEAUD HUY 17/12/79.
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
