<DATA=Code>
  2009-01-01 12:00  =>
  2009-01-01 12:00  => IDENTIFICATION DIVISION.
  2009-01-01 12:00  => PROGRAM-ID.    CHABAN.
  2009-01-01 12:00  => AUTHOR. BOURDEAUD HUY.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER. UNIVAC-1106.
  2009-01-01 12:00  => OBJECT-COMPUTER. UNIVAC-1106.
  2009-01-01 12:00  => SPECIAL-NAMES.
  2009-01-01 12:00  =>     PAGE IS SAUT.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT FIC ASSIGN TO DISC FICHOUT-1.
  2009-01-01 12:00  =>     SELECT CAR ASSIGN TO CARD-READER.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  FIC
  2009-01-01 12:00  =>     BLOCK 1 RECORDS
  2009-01-01 12:00  =>     LABEL RECORD STANDARD
  2009-01-01 12:00  =>     DATA RECORD ZFIC.
  2009-01-01 12:00  => 01  ZFIC               PIC X(80).
  2009-01-01 12:00  => FD  CAR
  2009-01-01 12:00  =>     LABEL RECORD OMITTED
  2009-01-01 12:00  =>     DATA RECORD ZIN.
  2009-01-01 12:00  => 01  ZIN      PIC X(80).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  COUNTERS  VALUE ALL ZEROES.
  2009-01-01 12:00  =>     03  CTOUT          PIC S9(7).
  2009-01-01 12:00  =>     03  CTFS           PIC S9(5).
  2009-01-01 12:00  =>     03  CTCAR          PIC S9(5).
  2009-01-01 12:00  => 01  ZOUT     VALUE SPACES.
  2009-01-01 12:00  =>     03  ZT1         PIC X(80).
  2009-01-01 12:00  => 01  ZOUTR    REDEFINES ZOUT.
  2009-01-01 12:00  =>     03  ZTR OCCURS 80 PIC X.
  2009-01-01 12:00  => 01  ZCAR.
  2009-01-01 12:00  =>     03  FILLER         PIC X(80).
  2009-01-01 12:00  => 01  ZCPOS REDEFINES ZCAR.
  2009-01-01 12:00  =>     03  ZCEM OCCURS 80 PIC X.
  2009-01-01 12:00  => 01  INDEKS.
  2009-01-01 12:00  =>     03  IED            PIC S9999 VALUE 1.
  2009-01-01 12:00  =>     03  IEF            PIC S9999 VALUE 1.
  2009-01-01 12:00  =>     03  IRD            PIC S9999 VALUE 1.
  2009-01-01 12:00  => 01  ZTIT.
  2009-01-01 12:00  =>     03  FILLER      PIC X(4) VALUE ALL '*'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(2) VALUE SPACES.
  2009-01-01 12:00  =>     03  FILLER         PIC X(16) VALUE 'RECORD NUMERO **'.
  2009-01-01 12:00  =>     03  FILCT          PIC Z(7).
  2009-01-01 12:00  => 01  CTSPEC             PIC S9(7) VALUE 0.
  2009-01-01 12:00  => 01  CTTEST             PIC S9(7) VALUE 0.
  2009-01-01 12:00  => 01  NBFOIS             PIC S9(7) VALUE 0.
  2009-01-01 12:00  => 01  ZONE               PIC X VALUE SPACES.
  2009-01-01 12:00  => 01  TABLE-ALPHA        PIC X(26) VALUE
  2009-01-01 12:00  =>                        'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
  2009-01-01 12:00  => 01  TABALPHA REDEFINES TABLE-ALPHA.
  2009-01-01 12:00  =>     03  ALPHA OCCURS 26  PIC X.
  2009-01-01 12:00  => 01  VALEUR             PIC S9999 VALUE 0.
  2009-01-01 12:00  => 01  VINSIX             PIC S99  VALUE 26.
  2009-01-01 12:00  => 01  ZREP               PIC S9999 VALUE 0.
  2009-01-01 12:00  => 01  DIX                PIC S99  VALUE 10.
  2009-01-01 12:00  => 01  TABLE-NUM      PIC X(10) VALUE '0123456789'.
  2009-01-01 12:00  => 01  TABNUM  REDEFINES TABLE-NUM.
  2009-01-01 12:00  =>     03  NUMER  OCCURS 10         PIC X.
  2009-01-01 12:00  => 01  RETOUR        PIC X VALUE SPACE.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => P1.
  2009-01-01 12:00  =>     OPEN INPUT CAR OUTPUT FIC.
  2009-01-01 12:00  => PAR1.
  2009-01-01 12:00  =>     ADD 1 TO CTSPEC.
  2009-01-01 12:00  =>     READ CAR INTO ZT1 AT END GO TO STATIS.
  2009-01-01 12:00  =>     ADD 1 TO CTCAR.
  2009-01-01 12:00  =>     PERFORM ECRIOUT THRU FIECRIOUT.
  2009-01-01 12:00  => STATIS.
  2009-01-01 12:00  =>     DISPLAY 'STATISTIQUES DE CREATION' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE DE CARTES DONNEES LUES' UPON PRINTER.
  2009-01-01 12:00  =>     ADD CTFS CTCAR GIVING CTTEST.
  2009-01-01 12:00  =>     DISPLAY CTTEST UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE DE CARTES DONNEES POUR FS' CTFS
  2009-01-01 12:00  =>                                  UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE DE CARTES DONNEES CREATION' CTCAR
  2009-01-01 12:00  =>                                  UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NOMBRE DE RECORDS CREES' CTOUT  UPON PRINTER.
  2009-01-01 12:00  =>     IF CTSPEC = CTTEST
  2009-01-01 12:00  =>              DISPLAY 'FIN DU TRAVAIL,TOUT EST OK' UPON PRINTER
  2009-01-01 12:00  =>     ELSE DISPLAY 'VERIFIER OUTPUT' 'IL Y AVAIT TROP PEU DE CARTES'
  2009-01-01 12:00  =>-      ' DONNEES OU FS' UPON PRINTER.
  2009-01-01 12:00  => FIN.
  2009-01-01 12:00  =>     CLOSE FIC CAR.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => ECRIOUT.
  2009-01-01 12:00  =>     WRITE ZFIC FROM ZOUT.
  2009-01-01 12:00  =>     ADD 1 TO CTOUT.
  2009-01-01 12:00  => FIECRIOUT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => PARAG.
  2009-01-01 12:00  =>     MOVE ZCEM (IED) TO ZTR (IRD).
  2009-01-01 12:00  =>     ADD 1 TO IED IRD.
  2009-01-01 12:00  =>     IF IED NOT > IEF GO TO PARAG.
  2009-01-01 12:00  => FIPARAG.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => RECHA.
  2009-01-01 12:00  =>     MOVE 0 TO IED.
  2009-01-01 12:00  => INC1.
  2009-01-01 12:00  =>     ADD 1 TO IED.
  2009-01-01 12:00  =>     IF ZONE = ALPHA (IED) GO TO CONT1.
  2009-01-01 12:00  =>     IF IED < 26 GO TO INC1.
  2009-01-01 12:00  =>     GO TO RECHN.
  2009-01-01 12:00  => CONT1.
  2009-01-01 12:00  =>     SUBTRACT IED FROM VINSIX GIVING ZREP.
  2009-01-01 12:00  =>     IF ZREP NOT < VALEUR ADD VALEUR TO IED
  2009-01-01 12:00  =>                          MOVE ALPHA (IED) TO ZONE
  2009-01-01 12:00  =>                          MOVE SPACE TO RETOUR
  2009-01-01 12:00  =>                          GO TO FIRECHA.
  2009-01-01 12:00  =>     SUBTRACT ZREP FROM VALEUR GIVING IED.
  2009-01-01 12:00  =>     MOVE ALPHA (IED) TO ZONE.
  2009-01-01 12:00  =>     MOVE 'R' TO RETOUR.
  2009-01-01 12:00  =>     MOVE 1 TO VALEUR.
  2009-01-01 12:00  =>     GO TO FIRECHA.
  2009-01-01 12:00  => RECHN.
  2009-01-01 12:00  =>     MOVE 0 TO IED.
  2009-01-01 12:00  => INC2.
  2009-01-01 12:00  =>     ADD 1 TO IED.
  2009-01-01 12:00  =>     IF ZONE = NUMER (IED) GO TO CONT2.
  2009-01-01 12:00  =>     IF IED < 10 GO TO INC2.
  2009-01-01 12:00  =>     MOVE '*' TO ZONE.
  2009-01-01 12:00  =>     MOVE SPACE TO RETOUR.
  2009-01-01 12:00  =>     GO TO FIRECHA.
  2009-01-01 12:00  => CONT2.
  2009-01-01 12:00  =>     SUBTRACT IED FROM DIX GIVING ZREP.
  2009-01-01 12:00  =>     IF ZREP NOT < VALEUR ADD VALEUR TO IED
  2009-01-01 12:00  =>                          MOVE NUMER (IED) TO ZONE
  2009-01-01 12:00  =>                          MOVE SPACE TO RETOUR
  2009-01-01 12:00  =>                          GO TO FIRECHA.
  2009-01-01 12:00  =>     SUBTRACT ZREP FROM VALEUR GIVING IED.
  2009-01-01 12:00  =>     MOVE NUMER (IED) TO ZONE.
  2009-01-01 12:00  =>     MOVE 'R' TO RETOUR.
  2009-01-01 12:00  =>     MOVE 1 TO VALEUR.
  2009-01-01 12:00  =>     GO TO FIRECHA.
  2009-01-01 12:00  => FIRECHA.
  2009-01-01 12:00  =>     EXIT.
</DATA>
