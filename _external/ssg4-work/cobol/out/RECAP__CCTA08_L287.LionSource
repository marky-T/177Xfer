  2009-01-01 12:00  =>       'USE DEFAULT QUALIFIER AFLINC;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'USE DEFAULT VERSION PRODUCTION ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 0 TO RDMS-FLAG.
  2009-01-01 12:00  =>     MOVE 'RECAP'     TO NM-PGM-APL   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'BATCH'     TO NM-NOM-ENV   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'Y'         TO CD-DBG-PRG   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'EUW002'    TO NM-NOM-COP   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'SERVICE1'  TO NM-NOM-DEM   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE SPACES      TO WS-PTR-ENE   OF EUW002.
  2009-01-01 12:00  =>     MOVE 'R'         TO FL-PLT-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE '2'         TO FL-TRD-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE 'Y'         TO MT-ENE-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE '1'         TO CD-FMT-MON-SRT  OF EUW002.
  2009-01-01 12:00  =>     MOVE 'Y'         TO FL-IMP-PNT      OF EUW002.
  2009-01-01 12:00  =>     MOVE 'N'         TO FL-000          OF EUW002.
  2009-01-01 12:00  =>     MOVE SPACES TO RECOUT.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     MOVE W-INDIC TO W-INDIC-OLD.
  2009-01-01 12:00  =>     READ  TAPEIN  AT  END MOVE 1 TO TESTFIN  GO TO  RUPTURE.
  2009-01-01 12:00  =>     ADD 1 TO NB-LUS.
  2009-01-01 12:00  =>     IF TOTAL1 NUMERIC
  2009-01-01 12:00  =>     ADD TOTAL1 TO TOTAL-LU1
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>     EXAMINE TOTAL1 REPLACING ALL SPACES BY ZERO
  2009-01-01 12:00  =>     ADD TOTAL1 TO TOTAL-LU1.
  2009-01-01 12:00  =>     IF TOTAL2 NUMERIC
  2009-01-01 12:00  =>     ADD TOTAL2 TO TOTAL-LU2
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>     EXAMINE TOTAL2 REPLACING ALL SPACES BY ZERO
  2009-01-01 12:00  =>     ADD TOTAL2 TO TOTAL-LU2.
  2009-01-01 12:00  =>     IF TOTAL3 NUMERIC
  2009-01-01 12:00  =>     ADD TOTAL3 TO TOTAL-LU3
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>     EXAMINE TOTAL3 REPLACING ALL SPACES BY ZERO
  2009-01-01 12:00  =>     ADD TOTAL3 TO TOTAL-LU3.
  2009-01-01 12:00  =>     IF TOTAL4 NUMERIC
  2009-01-01 12:00  =>     ADD TOTAL4 TO TOTAL-LU4
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>     EXAMINE TOTAL4 REPLACING ALL SPACES BY ZERO
  2009-01-01 12:00  =>     ADD TOTAL4 TO TOTAL-LU4.
  2009-01-01 12:00  =>     IF TOTAL5 NUMERIC
  2009-01-01 12:00  =>     ADD TOTAL5 TO TOTAL-LU5
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>     EXAMINE TOTAL5 REPLACING ALL SPACES BY ZERO
  2009-01-01 12:00  =>     ADD TOTAL5 TO TOTAL-LU5.
  2009-01-01 12:00  =>     MOVE  LIND1  TO  IND1  OF  W-INDIC.
  2009-01-01 12:00  =>     IF PREMIER =  0 MOVE 1 TO PREMIER GO TO EGALITE.
  2009-01-01 12:00  =>     IF W-INDIC-OLD GREATER THAN W-INDIC GO TO ERR-SEQ.
  2009-01-01 12:00  =>     IF W-INDIC NOT EQUAL TO W-INDIC-OLD GO TO RUPTURE.
  2009-01-01 12:00  =>     GO TO EGALITE.
  2009-01-01 12:00  => RUPTURE.
  2009-01-01 12:00  =>     MOVE TOTAL-OUT1 TO TOTAL-O1.
  2009-01-01 12:00  =>     MOVE ZEROES TO TOTAL-OUT1.
  2009-01-01 12:00  =>     MOVE TOTAL-OUT2 TO TOTAL-O2.
  2009-01-01 12:00  =>     MOVE ZEROES TO TOTAL-OUT2.
  2009-01-01 12:00  =>     MOVE TOTAL-OUT3 TO TOTAL-O3.
  2009-01-01 12:00  =>     MOVE ZEROES TO TOTAL-OUT3.
  2009-01-01 12:00  =>     MOVE TOTAL-OUT4 TO TOTAL-O4.
  2009-01-01 12:00  =>     MOVE ZEROES TO TOTAL-OUT4.
  2009-01-01 12:00  =>     MOVE TOTAL-OUT5 TO TOTAL-O5.
  2009-01-01 12:00  =>     MOVE ZEROES TO TOTAL-OUT5.
  2009-01-01 12:00  =>     WRITE RECOUT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECOUT.
  2009-01-01 12:00  =>     ADD 1 TO NB-ECR.
  2009-01-01 12:00  =>     IF TESTFIN = 1 GO TO FINW.
  2009-01-01 12:00  =>     GO TO EGALITE.
  2009-01-01 12:00  => ERR-SEQ.
  2009-01-01 12:00  =>     DISPLAY '**ANCIEN INDIC** ' W-INDIC-OLD
  2009-01-01 12:00  =>     DISPLAY '**NOUVEL INDIC** ' W-INDIC.
  2009-01-01 12:00  =>     DISPLAY '**ERREUR DE SEQUENCE** '.
  2009-01-01 12:00  =>     CLOSE TAPEIN TAPEOUT.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'END THREAD ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 0 TO RDMS-FLAG-THREAD.
  2009-01-01 12:00  =>     CALL 'ABORT'.
  2009-01-01 12:00  => EGALITE.
  2009-01-01 12:00  =>     MOVE ZONE1 TO ZONO1.
  2009-01-01 12:00  =>     MOVE ZONE2 TO ZONO2.
  2009-01-01 12:00  =>     MOVE ZONE3 TO ZONO3.
  2009-01-01 12:00  =>     MOVE ZONE4 TO ZONO4.
  2009-01-01 12:00  =>     MOVE ZONE5 TO ZONO5.
  2009-01-01 12:00  =>     MOVE ZONE6 TO ZONO6.
  2009-01-01 12:00  =>     MOVE ZONE7 TO ZONO7.
  2009-01-01 12:00  =>     MOVE ZONE8 TO ZONO8.
  2009-01-01 12:00  =>     MOVE ZONE9 TO ZONO9.
  2009-01-01 12:00  =>     ADD TOTAL1 TO TOTAL-OUT1 MONT1.
  2009-01-01 12:00  =>     ADD TOTAL2 TO TOTAL-OUT2 MONT2.
  2009-01-01 12:00  =>     ADD TOTAL3 TO TOTAL-OUT3 MONT3.
  2009-01-01 12:00  =>     ADD TOTAL4 TO TOTAL-OUT4 MONT4.
  2009-01-01 12:00  =>     ADD TOTAL5 TO TOTAL-OUT5 MONT5.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     EXAMINE NB-LUS REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     EXAMINE NB-ECR REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     DISPLAY  '*RECAP  FIN*'  UPON  PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-LUS ='  NB-LUS  UPON  PRINTER.
  2009-01-01 12:00  =>     EXAMINE TOTAL-LU1 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE TOTAL-LU1 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE TOTAL-LU2 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE TOTAL-LU2 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE TOTAL-LU3 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE TOTAL-LU3 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE TOTAL-LU4 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE TOTAL-LU4 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE TOTAL-LU5 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE TOTAL-LU5 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-ECR ='  NB-ECR  UPON  PRINTER.
  2009-01-01 12:00  =>     EXAMINE MONT1 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE MONT1 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE MONT2 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE MONT2 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE MONT3 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE MONT3 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE MONT4 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE MONT4 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     EXAMINE MONT5 REPLACING LEADING ZEROES BY SPACES.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  =>     MOVE MONT5 TO MT-ENE OF EUW002.
  2009-01-01 12:00  =>     MOVE EUW002       TO VL-CHP-TSF  OF WS-CMT-PGM.
  2009-01-01 12:00  =>     CALL 'EUU003'     USING WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE VL-CHP-TSF   OF WS-CMT-PGM TO EUW002.
  2009-01-01 12:00  =>     DISPLAY MT-SRT    OF EUW002 UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE  TAPEIN.
  2009-01-01 12:00  =>     CLOSE  TAPEOUT.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'END THREAD ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 0 TO RDMS-FLAG-THREAD.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => RAPPEL.
  2009-01-01 12:00  =>     DISPLAY 'RELISEZ ATTENTIVEMENT MODE D EMPLOI DE RECAP'
  2009-01-01 12:00  =>     UPON PRINTER.
  2009-01-01 12:00  => RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     DISPLAY '*** ERROR RDMS ***' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'COLUMN = ' RDMS-COLUMN UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'STATUS = ' RDMS-STATUS UPON PRINTER.
  2009-01-01 12:00  =>     PERFORM TRAIT-RDMS.
  2009-01-01 12:00  =>     GO TO RDMS-ERROR-EX.
  2009-01-01 12:00  => TRAIT-RDMS.
  2009-01-01 12:00  =>     MOVE ZEROS TO RDMS-FLAG.
  2009-01-01 12:00  =>     PERFORM VISU-RDMS-COM VARYING RDMS-IND FROM 1 BY 1
  2009-01-01 12:00  =>         UNTIL RDMS-IND > 36.
  2009-01-01 12:00  =>     MOVE ZEROS TO RDMS-FLAG.
  2009-01-01 12:00  =>     PERFORM TRAIT-RDMS-ERROR
  2009-01-01 12:00  =>         UNTIL RDMS-FLAG NOT = ZEROS.
  2009-01-01 12:00  => TRAIT-RDMS-ERROR.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'GETERROR INTO $P1, $P2, $P3, $P4 ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN,
  2009-01-01 12:00  =>       RDMS-ERROR-LINE (1), RDMS-ERROR-LINE (2),
  2009-01-01 12:00  =>       RDMS-ERROR-LINE (3), RDMS-ERROR-LINE (4).
  2009-01-01 12:00  =>     PERFORM VISU-RDMS-ERROR
  2009-01-01 12:00  =>       VARYING RDMS-IND FROM 1 BY 1
  2009-01-01 12:00  =>       UNTIL RDMS-IND > 4.
  2009-01-01 12:00  => VISU-RDMS-ERROR.
  2009-01-01 12:00  =>     IF RDMS-ERROR-LINE (RDMS-IND) NOT = SPACE
  2009-01-01 12:00  =>          DISPLAY RDMS-ERROR-LINE (RDMS-IND) UPON PRINTER
  2009-01-01 12:00  =>     ELSE MOVE 1 TO RDMS-FLAG.
  2009-01-01 12:00  => VISU-RDMS-COM.
  2009-01-01 12:00  =>     IF RLIN (RDMS-IND) NOT = SPACES
  2009-01-01 12:00  =>          DISPLAY RLIN (RDMS-IND) UPON PRINTER.
  2009-01-01 12:00  => RDMS-ERROR-EX.
</DATA>
