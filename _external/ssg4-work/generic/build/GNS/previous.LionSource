  2009-01-01 12:00  =>        DISPLAY '*   certains records ne       *' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*   respectent aucun case     *' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*   et ne figurent donc pas   *' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*   sur le fichier output     *' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*******************************' UPON PRINTER.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => CASE-RPT.
  2009-01-01 12:00  =>     IF I > P-NC GO TO CASE-RPT-FIN.
  2009-01-01 12:00  =>     MOVE I TO IX.
  2009-01-01 12:00  =>     ADD 1 TO IX.
  2009-01-01 12:00  =>     MOVE CNT (IX) TO D-CNT.
  2009-01-01 12:00  =>     IF I < 10
  2009-01-01 12:00  =>        MOVE I TO D-N1
  2009-01-01 12:00  =>        DISPLAY 'NB ENREGISTREMENTS CONDITION NO ' D-N1
  2009-01-01 12:00  =>                ' = ' D-CNT UPON PRINTER.
  2009-01-01 12:00  =>     IF I > 9 AND I < 100
  2009-01-01 12:00  =>        MOVE I TO D-N2
  2009-01-01 12:00  =>        DISPLAY 'NB ENREGISTREMENTS CONDITION NO ' D-N2
  2009-01-01 12:00  =>                ' = ' D-CNT UPON PRINTER.
  2009-01-01 12:00  =>     IF I > 99
  2009-01-01 12:00  =>        MOVE I TO D-N3
  2009-01-01 12:00  =>        DISPLAY 'NB ENREGISTREMENTS CONDITION NO ' D-N3
  2009-01-01 12:00  =>                ' = ' D-CNT UPON PRINTER.
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO CASE-RPT.
  2009-01-01 12:00  => CASE-RPT-FIN.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS OTHER = ' NB-REC-OTHER
  2009-01-01 12:00  =>                                          UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY ' ' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY ' ' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY ' ' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY ' ' UPON PRINTER.
