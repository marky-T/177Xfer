  2009-01-01 12:00  =>     ADD 1 TO NB-REC-LU.
  2009-01-01 12:00  =>     MOVE 1 TO PC.
  2009-01-01 12:00  =>     MOVE 1 TO W-ACTIVE.
  2009-01-01 12:00  => RUN-LOOP.
  2009-01-01 12:00  =>     IF PC > N-IT GO TO CASE-NON-PREVU.
  2009-01-01 12:00  =>     MOVE IT-TYPE (PC) TO W-TYPE.
  2009-01-01 12:00  =>     IF W-TYPE = 'C' GO TO IT-C.
  2009-01-01 12:00  =>     IF W-TYPE = 'M' GO TO IT-M.
  2009-01-01 12:00  =>     IF W-TYPE = 'K' GO TO IT-K.
  2009-01-01 12:00  =>     GO TO IT-T.
  2009-01-01 12:00  => IT-NEXT.
  2009-01-01 12:00  =>     ADD 1 TO PC.
  2009-01-01 12:00  =>     GO TO RUN-LOOP.
  2009-01-01 12:00  => IT-C.
  2009-01-01 12:00  =>     IF W-ACTIVE = 0 GO TO IT-NEXT.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-CA.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):IT-B (PC)) TO WS-CA (1:IT-B (PC)).
  2009-01-01 12:00  =>     IF WS-CA NOT = IT-VAL (PC)
  2009-01-01 12:00  =>        MOVE 0 TO W-ACTIVE.
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => IT-K.
  2009-01-01 12:00  =>     IF W-ACTIVE = 0 GO TO IT-NEXT.
  2009-01-01 12:00  =>     MOVE IT-VAL (PC) (1:IT-B (PC))
  2009-01-01 12:00  =>       TO WS-OUT (IT-A (PC):IT-B (PC)).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => IT-M.
  2009-01-01 12:00  =>     IF W-ACTIVE = 0 GO TO IT-NEXT.
  2009-01-01 12:00  =>     MOVE IT-CODE (PC) TO W-CODE.
  2009-01-01 12:00  =>     IF W-CODE = 0
  2009-01-01 12:00  =>        MOVE WS-IN (IT-A (PC):IT-B (PC))
  2009-01-01 12:00  =>          TO WS-OUT (IT-C (PC):IT-B (PC))
  2009-01-01 12:00  =>        GO TO IT-NEXT.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           DC-1 DC-2 DC-3 DC-4 DC-5 DC-6 DC-7 DC-8
  2009-01-01 12:00  =>       DEPENDING ON W-CODE.
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-1.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):2) TO WS-A2.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-2-4 THRU TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A4 TO WS-OUT (IT-C (PC):4).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-2.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):4) TO WS-A4.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-4-2 THRU TRANSFO-DATE-4-2-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A2 TO WS-OUT (IT-C (PC):2).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-3.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):2) TO WS-A2.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-22A THRU TRANSFO-DATE-22A-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A2 TO WS-OUT (IT-C (PC):2).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-4.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):2) TO WS-A2.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-22B THRU TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A2 TO WS-OUT (IT-C (PC):2).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-5.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):6) TO WS-A6.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-66A THRU TRANSFO-DATE-66A-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A6 TO WS-OUT (IT-C (PC):6).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-6.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):6) TO WS-A6.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-66B THRU TRANSFO-DATE-66B-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A6 TO WS-OUT (IT-C (PC):6).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-7.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):6) TO WS-A6.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-68 THRU TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A8 TO WS-OUT (IT-C (PC):8).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => DC-8.
  2009-01-01 12:00  =>     MOVE WS-IN (IT-A (PC):8) TO WS-A8.
  2009-01-01 12:00  =>     PERFORM TRANSFO-DATE-86 THRU TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     MOVE WS-A6 TO WS-OUT (IT-C (PC):6).
  2009-01-01 12:00  =>     GO TO IT-NEXT.
  2009-01-01 12:00  => IT-T.
  2009-01-01 12:00  =>     IF W-ACTIVE = 0
  2009-01-01 12:00  =>        MOVE 1 TO W-ACTIVE
  2009-01-01 12:00  =>        GO TO IT-NEXT.
  2009-01-01 12:00  =>     IF W-TYPE = 'U'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-OTHER
  2009-01-01 12:00  =>        PERFORM WRITE-REC-OUTPUT THRU WRITE-REC-OUTPUT-EXIT
  2009-01-01 12:00  =>        GO TO TRT.
  2009-01-01 12:00  =>     MOVE IT-A (PC) TO IX.
  2009-01-01 12:00  =>     ADD 1 TO IX.
  2009-01-01 12:00  =>     ADD 1 TO CNT (IX).
  2009-01-01 12:00  =>     PERFORM WRITE-REC-OUTPUT THRU WRITE-REC-OUTPUT-EXIT.
  2009-01-01 12:00  =>     GO TO TRT.
  2009-01-01 12:00  => CASE-NON-PREVU.
  2009-01-01 12:00  =>     GO TO TRT.
  2009-01-01 12:00  => FIN-TRT.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS LUS    = ' NB-REC-LU
  2009-01-01 12:00  =>                          UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS ECRITS = ' NB-REC-ECRIT
  2009-01-01 12:00  =>                          UPON PRINTER.
  2009-01-01 12:00  =>     SUBTRACT NB-REC-ECRIT FROM NB-REC-LU GIVING NB-REC-NONECRIT.
  2009-01-01 12:00  =>     IF NB-REC-NONECRIT > 0
  2009-01-01 12:00  =>        DISPLAY '*******************************' UPON PRINTER
