<DATA=Code>
  2009-01-01 12:00  => IDENTIFICATION DIVISION.
  2009-01-01 12:00  =>* SSG-4 (MT-043): one BABA for every call. Key fields, mode,
  2009-01-01 12:00  =>* value sets and outputs come from the SGSPARM file written by
  2009-01-01 12:00  =>* the skeleton hand-off; see _scratch\spike-baba\spec.md.
  2009-01-01 12:00  => PROGRAM-ID. 'ASSURFED-UTILIT-BABA-GN'.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER. UNIVAC-1100-10.
  2009-01-01 12:00  => OBJECT-COMPUTER. UNIVAC-1100-10.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT PARMF ASSIGN TO DISC SGSPARM.
  2009-01-01 12:00  =>     SELECT FI1 ASSIGN TO DISC BABIN.
  2009-01-01 12:00  =>     SELECT FO1 ASSIGN TO DISC BABOUT1.
  2009-01-01 12:00  =>     SELECT FO2 ASSIGN TO DISC BABOUT2.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  PARMF
  2009-01-01 12:00  =>     LABEL RECORD STANDARD.
  2009-01-01 12:00  => 01  PARM-REC.
  2009-01-01 12:00  =>     03  P-TYPE         PIC XX.
  2009-01-01 12:00  =>     03  P-REST         PIC X(398).
  2009-01-01 12:00  => 01  PARM-FILE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PF-NAME        PIC X(30).
  2009-01-01 12:00  =>     03  PF-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(363).
  2009-01-01 12:00  => 01  PARM-MODE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PD-MODE        PIC X(3).
  2009-01-01 12:00  =>     03  PD-SEQ         PIC X.
  2009-01-01 12:00  =>     03  FILLER         PIC X(394).
  2009-01-01 12:00  => 01  PARM-KEY-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PK-POS         PIC 9(5).
  2009-01-01 12:00  =>     03  PK-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(388).
  2009-01-01 12:00  => 01  PARM-REQ-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PR-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  PR-VAL         PIC X(393).
  2009-01-01 12:00  => FD  FI1
  2009-01-01 12:00  =>     LABEL RECORD STANDARD
  2009-01-01 12:00  =>     RECORD VARYING IN SIZE FROM 1 TO 4001
  2009-01-01 12:00  =>     DEPENDING ON WS-IN-LEN.
  2009-01-01 12:00  => 01  FI1-REC PIC X(4001).
  2009-01-01 12:00  => FD  FO1
  2009-01-01 12:00  =>     LABEL RECORD STANDARD.
  2009-01-01 12:00  => 01  FO1-REC PIC X(4000).
  2009-01-01 12:00  => FD  FO2
  2009-01-01 12:00  =>     LABEL RECORD STANDARD.
  2009-01-01 12:00  => 01  FO2-REC PIC X(4000).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  RECIN              PIC X(4001).
  2009-01-01 12:00  => 01  RECOUT             PIC X(4000).
  2009-01-01 12:00  => 01  WS-IN              PIC X(4000).
  2009-01-01 12:00  => 01  WS-KEY             PIC X(400).
  2009-01-01 12:00  => 01  PREV-KEY           PIC X(400).
  2009-01-01 12:00  => 77  WS-IN-LEN          PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-INLEN            PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-MODE             PIC X(3) VALUE 'ALL'.
  2009-01-01 12:00  => 77  P-SEQ              PIC X VALUE 'N'.
  2009-01-01 12:00  => 77  N-OUT              PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  N-KF               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  N-RQ               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  I                  PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  KP                 PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  KEY-LEN            PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  CP-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  TARGET             PIC 9 VALUE 1.
  2009-01-01 12:00  => 77  DUP                PIC X VALUE 'N'.
  2009-01-01 12:00  => 77  NB-LUS             PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  NB-OUT1            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  NB-OUT2            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  NB-ELIM            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 77  NB-PREV            PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 01  OUT-TAB.
  2009-01-01 12:00  =>     03  OUT-LEN        PIC 9(5) COMP OCCURS 2.
  2009-01-01 12:00  => 01  KF-TAB.
  2009-01-01 12:00  =>     03  KF-ENT OCCURS 20.
  2009-01-01 12:00  =>         05  KF-POS     PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  KF-LEN     PIC 9(5) COMP.
  2009-01-01 12:00  => 01  RQ-TAB.
  2009-01-01 12:00  =>     03  RQ-ENT OCCURS 40.
  2009-01-01 12:00  =>         05  RQ-LEN     PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  RQ-VAL     PIC X(393).
  2009-01-01 12:00  => 01  DISPLAY-LINE.
  2009-01-01 12:00  =>     03  DISP-MESSAGE   PIC X(24).
  2009-01-01 12:00  =>     03  DISP-CT        PIC Z(11)9.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT PARMF.
  2009-01-01 12:00  => PARM-LECT.
  2009-01-01 12:00  =>     READ PARMF AT END GO TO PARM-FIN.
  2009-01-01 12:00  =>     IF P-TYPE = 'IN'
  2009-01-01 12:00  =>        MOVE PF-LEN TO P-INLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'OU'
  2009-01-01 12:00  =>        ADD 1 TO N-OUT
  2009-01-01 12:00  =>        MOVE PF-LEN TO OUT-LEN (N-OUT).
  2009-01-01 12:00  =>     IF P-TYPE = 'MD'
  2009-01-01 12:00  =>        MOVE PD-MODE TO P-MODE
  2009-01-01 12:00  =>        MOVE PD-SEQ TO P-SEQ.
  2009-01-01 12:00  =>     IF P-TYPE = 'KF'
  2009-01-01 12:00  =>        ADD 1 TO N-KF
  2009-01-01 12:00  =>        MOVE PK-POS TO KF-POS (N-KF)
  2009-01-01 12:00  =>        MOVE PK-LEN TO KF-LEN (N-KF).
  2009-01-01 12:00  =>     IF P-TYPE = 'RQ'
  2009-01-01 12:00  =>        ADD 1 TO N-RQ
  2009-01-01 12:00  =>        MOVE PR-LEN TO RQ-LEN (N-RQ)
  2009-01-01 12:00  =>        MOVE PR-VAL TO RQ-VAL (N-RQ).
  2009-01-01 12:00  =>     GO TO PARM-LECT.
  2009-01-01 12:00  => PARM-FIN.
  2009-01-01 12:00  =>     CLOSE PARMF.
  2009-01-01 12:00  =>     OPEN INPUT FI1.
  2009-01-01 12:00  =>     OPEN OUTPUT FO1.
  2009-01-01 12:00  =>     IF N-OUT > 1
  2009-01-01 12:00  =>        OPEN OUTPUT FO2.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     READ FI1 INTO RECIN AT END GO TO FINW.
  2009-01-01 12:00  =>     ADD 1 TO NB-LUS.
  2009-01-01 12:00  =>     IF NB-LUS NOT < 99999999 GO TO FINW.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-IN.
  2009-01-01 12:00  =>     MOVE WS-IN-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > P-INLEN
  2009-01-01 12:00  =>        MOVE P-INLEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > 0
  2009-01-01 12:00  =>        MOVE RECIN (1:CP-LEN) TO WS-IN (1:CP-LEN).
  2009-01-01 12:00  =>     MOVE SPACES TO WS-KEY.
  2009-01-01 12:00  =>     MOVE 1 TO KP.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => KEY-LOOP.
  2009-01-01 12:00  =>     IF I > N-KF GO TO KEY-END.
  2009-01-01 12:00  =>     MOVE WS-IN (KF-POS (I):KF-LEN (I))
  2009-01-01 12:00  =>       TO WS-KEY (KP:KF-LEN (I)).
  2009-01-01 12:00  =>     ADD KF-LEN (I) TO KP.
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO KEY-LOOP.
  2009-01-01 12:00  => KEY-END.
  2009-01-01 12:00  =>     COMPUTE KEY-LEN = KP - 1.
  2009-01-01 12:00  =>     MOVE 'N' TO DUP.
  2009-01-01 12:00  =>     IF P-SEQ = 'N' OR NB-LUS = 1 OR KEY-LEN = 0
  2009-01-01 12:00  =>        GO TO SEQ-END.
  2009-01-01 12:00  =>     IF WS-KEY (1:KEY-LEN) < PREV-KEY (1:KEY-LEN)
  2009-01-01 12:00  =>        GO TO SEQ-ABORT.
  2009-01-01 12:00  =>     IF P-SEQ = 'M' AND WS-KEY (1:KEY-LEN) = PREV-KEY (1:KEY-LEN)
  2009-01-01 12:00  =>        MOVE 'Y' TO DUP.
  2009-01-01 12:00  => SEQ-END.
  2009-01-01 12:00  =>     MOVE WS-KEY TO PREV-KEY.
  2009-01-01 12:00  =>     MOVE 1 TO TARGET.
  2009-01-01 12:00  =>     IF P-SEQ = 'M'
  2009-01-01 12:00  =>        IF DUP = 'Y'
  2009-01-01 12:00  =>           MOVE 2 TO TARGET
  2009-01-01 12:00  =>           GO TO ROUTE-END
  2009-01-01 12:00  =>        ELSE
  2009-01-01 12:00  =>           GO TO ROUTE-END.
  2009-01-01 12:00  =>     IF P-MODE = 'ALL' GO TO ROUTE-END.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => RQ-LOOP.
  2009-01-01 12:00  =>     IF I > N-RQ GO TO RQ-NONE.
  2009-01-01 12:00  =>     IF RQ-LEN (I) = KEY-LEN AND KEY-LEN > 0
  2009-01-01 12:00  =>        IF WS-KEY (1:KEY-LEN) = RQ-VAL (I) (1:KEY-LEN)
  2009-01-01 12:00  =>           GO TO RQ-FOUND.
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO RQ-LOOP.
  2009-01-01 12:00  => RQ-FOUND.
  2009-01-01 12:00  =>     IF P-MODE = 'E'
  2009-01-01 12:00  =>        MOVE 2 TO TARGET.
  2009-01-01 12:00  =>     GO TO ROUTE-END.
  2009-01-01 12:00  => RQ-NONE.
  2009-01-01 12:00  =>     IF P-MODE = 'R'
  2009-01-01 12:00  =>        MOVE 2 TO TARGET.
  2009-01-01 12:00  => ROUTE-END.
  2009-01-01 12:00  =>     IF TARGET > N-OUT
  2009-01-01 12:00  =>        ADD 1 TO NB-ELIM
  2009-01-01 12:00  =>        GO TO LECT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECOUT.
  2009-01-01 12:00  =>     MOVE WS-IN (1:P-INLEN) TO RECOUT (1:OUT-LEN (TARGET)).
  2009-01-01 12:00  =>     IF TARGET = 1
  2009-01-01 12:00  =>        WRITE FO1-REC FROM RECOUT
  2009-01-01 12:00  =>        ADD 1 TO NB-OUT1
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        WRITE FO2-REC FROM RECOUT
  2009-01-01 12:00  =>        ADD 1 TO NB-OUT2.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => SEQ-ABORT.
  2009-01-01 12:00  =>     COMPUTE NB-PREV = NB-LUS - 1.
  2009-01-01 12:00  =>     MOVE ' HAS SEQUENCE ERROR AT  ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-PREV TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     MOVE '               AND AT   ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-LUS TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE FI1.
  2009-01-01 12:00  =>     CLOSE FO1.
  2009-01-01 12:00  =>     IF N-OUT > 1
  2009-01-01 12:00  =>        CLOSE FO2.
  2009-01-01 12:00  =>     CALL 'ABORT'.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     MOVE '     RECORDS  READ      ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-LUS TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     MOVE '    RECORDS WRITTEN 1   ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-OUT1 TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     MOVE '    RECORDS WRITTEN 2   ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-OUT2 TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     MOVE '    RECORDS ELIMINATED  ' TO DISP-MESSAGE.
  2009-01-01 12:00  =>     MOVE NB-ELIM TO DISP-CT.
  2009-01-01 12:00  =>     DISPLAY DISPLAY-LINE UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE FI1.
  2009-01-01 12:00  =>     CLOSE FO1.
  2009-01-01 12:00  =>     IF N-OUT > 1
  2009-01-01 12:00  =>        CLOSE FO2.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
