  2009-01-01 12:00  => 01  PARM-MOVE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PM-IS          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-IL          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-OS          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-OL          PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(228).
  2009-01-01 12:00  => 01  PARM-FIXE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PX-OS          PIC 9(5).
  2009-01-01 12:00  =>     03  PX-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  PX-TXT         PIC X(238).
  2009-01-01 12:00  => 01  PARM-SKIP-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PS-N           PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(243).
  2009-01-01 12:00  => FD  FI1
  2009-01-01 12:00  =>     LABEL RECORD STANDARD
  2009-01-01 12:00  =>     RECORD VARYING IN SIZE FROM 1 TO 4001
  2009-01-01 12:00  =>     DEPENDING ON WS-IN-LEN.
  2009-01-01 12:00  => 01  FI1-REC PIC X(4001).
  2009-01-01 12:00  => FD  FO1
  2009-01-01 12:00  =>     LABEL RECORD STANDARD.
  2009-01-01 12:00  => 01  FO1-REC PIC X(4000).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 01  RECIN              PIC X(4001).
  2009-01-01 12:00  => 01  RECOUT             PIC X(4000).
  2009-01-01 12:00  => 01  IN-NAMES-V.
  2009-01-01 12:00  =>     03 FILLER PIC X(30) VALUE 'CFHIN'.
  2009-01-01 12:00  => 01  IN-NAMES REDEFINES IN-NAMES-V.
  2009-01-01 12:00  =>     03 IN-NM PIC X(30) OCCURS 1.
  2009-01-01 12:00  => 01  OUT-NAMES-V.
  2009-01-01 12:00  =>     03 FILLER PIC X(30) VALUE 'CFHOUT'.
  2009-01-01 12:00  => 01  OUT-NAMES REDEFINES OUT-NAMES-V.
  2009-01-01 12:00  =>     03 OUT-NM PIC X(30) OCCURS 1.
  2009-01-01 12:00  => 77  IX-IN              PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  IX-OUT             PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  NB-LUS             PIC 9(10) COMP VALUE 0.
  2009-01-01 12:00  => 01  SWITCHES.
  2009-01-01 12:00  =>     03  REC-SKIPPED    PIC S9(6) VALUE ZEROES.
  2009-01-01 12:00  => 77  WS-INNAME          PIC X(30) VALUE SPACES.
  2009-01-01 12:00  => 77  WS-OUTNAME         PIC X(30) VALUE SPACES.
  2009-01-01 12:00  => 77  WS-IN-LEN          PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  WS-OUT-LEN         PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-INLEN            PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-OUTLEN           PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-SKIP             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  N-MV               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  N-FX               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  I                  PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  CP-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 01  MV-TAB.
  2009-01-01 12:00  =>     03  MV-ENT OCCURS 30.
  2009-01-01 12:00  =>         05  MV-IS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-IL      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-OS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-OL      PIC 9(5) COMP.
  2009-01-01 12:00  => 01  FX-TAB.
  2009-01-01 12:00  =>     03  FX-ENT OCCURS 20.
  2009-01-01 12:00  =>         05  FX-OS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  FX-LEN     PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  FX-TXT     PIC X(238).
  2009-01-01 12:00  => 01  WS-IN              PIC X(4000).
  2009-01-01 12:00  => 01  WS-OUT             PIC X(4000).
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT PARMF.
  2009-01-01 12:00  => PARM-LECT.
  2009-01-01 12:00  =>     READ PARMF AT END GO TO PARM-FIN.
  2009-01-01 12:00  =>     IF P-TYPE = 'IN'
  2009-01-01 12:00  =>        MOVE PF-NAME TO WS-INNAME
  2009-01-01 12:00  =>        MOVE PF-LEN TO P-INLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'OU'
  2009-01-01 12:00  =>        MOVE PF-NAME TO WS-OUTNAME
  2009-01-01 12:00  =>        MOVE PF-LEN TO P-OUTLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'MV'
  2009-01-01 12:00  =>        ADD 1 TO N-MV
  2009-01-01 12:00  =>        MOVE PM-IS TO MV-IS (N-MV)
  2009-01-01 12:00  =>        MOVE PM-IL TO MV-IL (N-MV)
  2009-01-01 12:00  =>        MOVE PM-OS TO MV-OS (N-MV)
  2009-01-01 12:00  =>        MOVE PM-OL TO MV-OL (N-MV).
  2009-01-01 12:00  =>     IF P-TYPE = 'FX'
  2009-01-01 12:00  =>        ADD 1 TO N-FX
  2009-01-01 12:00  =>        MOVE PX-OS TO FX-OS (N-FX)
  2009-01-01 12:00  =>        MOVE PX-LEN TO FX-LEN (N-FX)
  2009-01-01 12:00  =>        MOVE PX-TXT TO FX-TXT (N-FX).
  2009-01-01 12:00  =>     IF P-TYPE = 'SK'
  2009-01-01 12:00  =>        MOVE PS-N TO P-SKIP.
  2009-01-01 12:00  =>     GO TO PARM-LECT.
  2009-01-01 12:00  => PARM-FIN.
  2009-01-01 12:00  =>     CLOSE PARMF.
  2009-01-01 12:00  =>     MOVE 1 TO IX-IN.
  2009-01-01 12:00  =>     MOVE 1 TO IX-OUT.
  2009-01-01 12:00  => FIND-IN.
  2009-01-01 12:00  =>     IF IX-IN > 1 GO TO FINW.
  2009-01-01 12:00  =>     IF IN-NM (IX-IN) = WS-INNAME GO TO FIND-OUT.
  2009-01-01 12:00  =>     ADD 1 TO IX-IN.
  2009-01-01 12:00  =>     GO TO FIND-IN.
  2009-01-01 12:00  => FIND-OUT.
  2009-01-01 12:00  =>     IF IX-OUT > 1 GO TO FINW.
  2009-01-01 12:00  =>     IF OUT-NM (IX-OUT) = WS-OUTNAME GO TO OPEN-FILES.
  2009-01-01 12:00  =>     ADD 1 TO IX-OUT.
  2009-01-01 12:00  =>     GO TO FIND-OUT.
  2009-01-01 12:00  => OPEN-FILES.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           OI-1
  2009-01-01 12:00  =>       DEPENDING ON IX-IN.
  2009-01-01 12:00  => OI-1.
  2009-01-01 12:00  =>     OPEN INPUT FI1.
  2009-01-01 12:00  =>     GO TO OI-END.
  2009-01-01 12:00  => OI-END.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           OO-1
  2009-01-01 12:00  =>       DEPENDING ON IX-OUT.
  2009-01-01 12:00  => OO-1.
  2009-01-01 12:00  =>     OPEN OUTPUT FO1.
  2009-01-01 12:00  =>     GO TO OO-END.
  2009-01-01 12:00  => OO-END.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-OUT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           RD-1
  2009-01-01 12:00  =>       DEPENDING ON IX-IN.
  2009-01-01 12:00  => RD-1.
  2009-01-01 12:00  =>     READ FI1 INTO RECIN AT END GO TO FINW.
  2009-01-01 12:00  =>     GO TO RD-END.
  2009-01-01 12:00  => RD-END.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-IN.
  2009-01-01 12:00  =>     MOVE WS-IN-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > P-INLEN
  2009-01-01 12:00  =>        MOVE P-INLEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > 0
  2009-01-01 12:00  =>        MOVE RECIN (1:CP-LEN) TO WS-IN (1:CP-LEN).
  2009-01-01 12:00  =>     IF N-MV = 0
  2009-01-01 12:00  =>        MOVE WS-IN (1:P-INLEN) TO WS-OUT (1:P-OUTLEN).
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => MV-LOOP.
  2009-01-01 12:00  =>     IF I > N-MV GO TO FX-START.
  2009-01-01 12:00  =>     MOVE WS-IN (MV-IS (I):MV-IL (I))
  2009-01-01 12:00  =>       TO WS-OUT (MV-OS (I):MV-OL (I)).
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO MV-LOOP.
  2009-01-01 12:00  => FX-START.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => FX-LOOP.
  2009-01-01 12:00  =>     IF I > N-FX GO TO REC-END.
  2009-01-01 12:00  =>     MOVE FX-TXT (I) (1:FX-LEN (I))
  2009-01-01 12:00  =>       TO WS-OUT (FX-OS (I):FX-LEN (I)).
  2009-01-01 12:00  =>     INSPECT WS-OUT (FX-OS (I):FX-LEN (I))
  2009-01-01 12:00  =>       REPLACING ALL '<' BY ';'.
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO FX-LOOP.
  2009-01-01 12:00  => REC-END.
  2009-01-01 12:00  =>     ADD 1 TO NB-LUS.
  2009-01-01 12:00  =>     IF NB-LUS < P-SKIP
  2009-01-01 12:00  =>        ADD 1 TO REC-SKIPPED
  2009-01-01 12:00  =>        GO TO LECT.
  2009-01-01 12:00  =>     MOVE P-OUTLEN TO WS-OUT-LEN.
  2009-01-01 12:00  =>     MOVE WS-OUT TO RECOUT.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           WR-1
  2009-01-01 12:00  =>       DEPENDING ON IX-OUT.
  2009-01-01 12:00  => WR-1.
  2009-01-01 12:00  =>     WRITE FO1-REC FROM RECOUT.
  2009-01-01 12:00  =>     GO TO WR-END.
  2009-01-01 12:00  => WR-END.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     DISPLAY  '*CFH-COPY  FIN*'  UPON  PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-LUS ='  NB-LUS  UPON  PRINTER.
  2009-01-01 12:00  =>     IF IX-IN > 1 GO TO CI-END.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           CI-1
  2009-01-01 12:00  =>       DEPENDING ON IX-IN.
  2009-01-01 12:00  => CI-1.
  2009-01-01 12:00  =>     CLOSE FI1.
  2009-01-01 12:00  =>     GO TO CI-END.
  2009-01-01 12:00  => CI-END.
  2009-01-01 12:00  =>     IF IX-OUT > 1 GO TO CO-END.
  2009-01-01 12:00  =>     GO TO
  2009-01-01 12:00  =>           CO-1
  2009-01-01 12:00  =>       DEPENDING ON IX-OUT.
  2009-01-01 12:00  => CO-1.
  2009-01-01 12:00  =>     CLOSE FO1.
  2009-01-01 12:00  =>     GO TO CO-END.
  2009-01-01 12:00  => CO-END.
  2009-01-01 12:00  =>     DISPLAY  REC-SKIPPED  UPON  PRINTER.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  * SSG-4 spike (MT-043): one CFH-COPY for every call. Record shapes,
  * field moves and constants come from the SGSPARM file written by
  * the skeleton hand-off; see _scratch\spike-cfh\spec.md.
  PROGRAM-ID. .
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
<IN FOLDER>
COBOL
</IN FOLDER>
</OBJECT>
