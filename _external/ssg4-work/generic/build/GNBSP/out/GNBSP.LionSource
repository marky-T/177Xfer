  2009-01-01 12:00  =>     IF WS-A2-A1 = ';'
  2009-01-01 12:00  =>        MOVE '0'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-200X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '_'
  2009-01-01 12:00  =>        MOVE '1'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-201X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '|'
  2009-01-01 12:00  =>        MOVE '2'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-202X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '~'
  2009-01-01 12:00  =>        MOVE '3'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-203X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => WRITE-REC-OUTPUT.
  2009-01-01 12:00  =>*******************
  2009-01-01 12:00  =>     ADD 1 TO NB-REC-ECRIT.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22A-200X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22A-200X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22A-201X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22A-201X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22A-202X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22A-202X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22A-203X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22A-203X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22B-200X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22B-200X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22B-201X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22B-201X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22B-202X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22B-202X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-22B-203X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-22B-203X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66A-200X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-66A-200X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66A-201X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-66A-201X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66A-202X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-66A-202X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66A-203X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-66A-203X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66B-200X = 'Y'
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-TRANSFORME-66B-200X.
  2009-01-01 12:00  =>     IF WS-RECORD-TRANSFORME-66B-201X = 'Y'
