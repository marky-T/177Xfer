function ConvertTo-SqlName([string]$Name) { '[' + $Name.Replace(']', ']]') + ']' }

function New-SqlcmdInvoker {
    param([string]$Server = '(localdb)\MSSQLLocalDB', [Parameter(Mandatory)][string]$Database)
    $sep = [char]0x1F
    {
        param([string]$Sql, [string[]]$Columns)
        $out = & sqlcmd -S $Server -d $Database -C -b -h -1 -W -s $sep -Q ("SET NOCOUNT ON; " + $Sql) 2>&1
        if ($LASTEXITCODE -ne 0) { throw "sqlcmd failed: $($out -join ' ')" }
        foreach ($line in @($out | Where-Object { $_ -ne '' })) {
            $v = "$line".Split($sep); $o = [ordered]@{}
            for ($i = 0; $i -lt $Columns.Count; $i++) { $o[$Columns[$i]] = if ($v[$i] -eq 'NULL') { $null } else { $v[$i] } }
            [pscustomobject]$o
        }
    }.GetNewClosure()
}

function New-AmtDbInvoker {
    # In a CC job: AMT's own database connection (the application database), the same object QlpExecute uses.
    {
