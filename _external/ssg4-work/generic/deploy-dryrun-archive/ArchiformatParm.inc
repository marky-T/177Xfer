        $dt = $global:AmtDatabase.OpenQuery($Sql)
        if ($global:AmtDatabase.ErrorCode -ne 0) { throw "OpenQuery failed: $($global:AmtDatabase.ErrorDescription)" }
        foreach ($r in $dt.Rows) { $o = [ordered]@{}; foreach ($c in $Columns) { $o[$c] = if ($r[$c] -is [DBNull]) { $null } else { "$($r[$c])" } }; [pscustomobject]$o }
    }
}

function Get-ArchiveTableMeta {
    # Returns the same shape as a cases.json ddTables entry, read from the catalog.
    param([Parameter(Mandatory)][scriptblock]$Invoke, [Parameter(Mandatory)][string]$Schema, [Parameter(Mandatory)][string]$Table)
    $obj = "N'" + ((ConvertTo-SqlName $Schema) + '.' + (ConvertTo-SqlName $Table)).Replace("'", "''") + "'"
    $t = @(& $Invoke "SELECT CONVERT(char(8), o.modify_date, 12) FROM sys.objects o WHERE o.object_id = OBJECT_ID($obj)" @('ymd'))
    if (-not $t) { throw "table $Schema.$Table not found" }
    $cols = & $Invoke ("SELECT c.name, ty.name, c.max_length, c.is_nullable FROM sys.columns c JOIN sys.types ty ON ty.user_type_id = c.user_type_id " +
        "WHERE c.object_id = OBJECT_ID($obj) ORDER BY c.column_id") @('name', 'type', 'length', 'nullable')
    $pk = @(& $Invoke ("SELECT kc.name, col.name, ic.is_descending_key FROM sys.key_constraints kc " +
        "JOIN sys.index_columns ic ON ic.object_id = kc.parent_object_id AND ic.index_id = kc.unique_index_id " +
        "JOIN sys.columns col ON col.object_id = ic.object_id AND col.column_id = ic.column_id " +
        "WHERE kc.parent_object_id = OBJECT_ID($obj) AND kc.type = 'PK' ORDER BY ic.key_ordinal") @('pk', 'column', 'desc'))
    $ymd = $t[0].ymd.Trim()
    [pscustomobject]@{
        schema           = $Schema
        table            = $Table
        processTimeStamp = '{0} {1} {2}' -f $ymd.Substring(0, 2), $ymd.Substring(2, 2), $ymd.Substring(4, 2)
        primaryKey       = if ($pk) { $pk[0].pk } else { '' }
        keyColumns       = @($pk | ForEach-Object { , @($_.column, $(if ($_.desc -eq '1') { 'Desc' } else { 'Asc' })) })
        columns          = @($cols | ForEach-Object {
                $rt = $script:RdmsTypeOf[$_.type.ToLower()]; if (-not $rt) { throw "no RDMS type name for SQL type '$($_.type)' ($($_.name))" }
                [pscustomobject]@{ name = $_.name; type = $rt; length = [int]$_.length; nullable = ($_.nullable -eq '1') } })
    }
}

