$script:Ascii = [System.Text.Encoding]::ASCII

function Write-ArchiveFile {
    # Fixed-width ASCII records, CRLF after every record (same shape as the CFH-COPY CC outputs).
    param([Parameter(Mandatory)][string]$Path, [AllowEmptyCollection()][string[]]$Records = @(), [int]$Length = 0)
    $sb = [System.Text.StringBuilder]::new()
    foreach ($r in $Records) {
        $line = if ($Length -gt 0) { $r.PadRight($Length).Substring(0, $Length) } else { $r }
        [void]$sb.Append($line).Append("`r`n")
    }
    [System.IO.File]::WriteAllBytes($Path, $script:Ascii.GetBytes($sb.ToString()))
}

function Read-ArchiveFile {
    param([Parameter(Mandatory)][string]$Path)
    $text = $script:Ascii.GetString([System.IO.File]::ReadAllBytes($Path))
    if ($text.Length -eq 0) { return , @() }
    if (-not $text.EndsWith("`r`n")) { throw "$Path does not end with CRLF" }
    return , ($text.Substring(0, $text.Length - 2) -split "`r`n")
}

function Get-FileSha256 {
    param([Parameter(Mandatory)][string]$Path)
    (Get-FileHash -Algorithm SHA256 -LiteralPath $Path).Hash
}

function New-DdReportLines {
    # Layout the COBOL needs (1-based columns):
    #   'DD-PROCESS-TIME-STAMP' at 4; next line yy at 7, mm at 10, dd at 13
    #   'Columns' at 1; two lines on, 'Allowed' (here at 40); then one row per column with 'YES'/'NO' at 42
    #   'Primary Key :' at 1 with 'PK_<name>'; two lines on, one row per key column '    <name> , <Asc|Desc>'; blank ends
    param([Parameter(Mandatory)]$Table)
    $ts = $Table.processTimeStamp
    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add('   DD-PROCESS-TIME-STAMP')
    $lines.Add('      ' + $ts)
    $lines.Add('')
    $lines.Add('Columns')
    $lines.Add(' Col  Name               Type    Length  Null')
    $lines.Add((' ' * 39) + 'Allowed')
    $n = 0
    foreach ($c in $Table.columns) {
        $n++
        $left = (' {0,3}  {1,-18} {2,-8}{3,5}' -f $n, $c.name, $c.type, $c.length)
        if ($left.Length -gt 41) { throw "DD report row for $($c.name) is $($left.Length) chars; the null flag must start at column 42" }
        $lines.Add($left.PadRight(41) + $(if ($c.nullable) { 'YES' } else { 'NO' }))
    }
    $lines.Add('')
    $lines.Add('Primary Key : ' + $Table.primaryKey)
    $lines.Add('  Column     Direction')
    foreach ($k in $Table.keyColumns) { $lines.Add('    ' + $k[0] + ' , ' + $k[1]) }
    $lines.Add('')
    return , $lines.ToArray()
}

function New-DdDescriptLines {
    # Line 1 is a title; then one line per column: type at 6 (7), length at 13 (10 digits), and the column
    # name right after 'TION.' at the same position on every line; then one closing line.
    param([Parameter(Mandatory)]$Table, [Parameter(Mandatory)][string]$TableName)
    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add('DESCRIPTION DES CHAMPS DE ' + $TableName)
    foreach ($c in $Table.columns) {
        $lines.Add('     ' + $c.type.PadRight(7).Substring(0, 7) + ([int]$c.length).ToString('D10') + (' ' * 11) + 'COLLECTION.' + $c.name)
    }
    $lines.Add('END DESCRIPTION')
    return , $lines.ToArray()
}

