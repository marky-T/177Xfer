  2009-01-01 12:00  => TRANSFO-DATE-4-2.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     MOVE WS-A4-AA TO WS-A2.
  2009-01-01 12:00  =>     IF ((WS-A4 > '1999') AND (WS-A4 < '2010'))
  2009-01-01 12:00  =>        MOVE ';' TO WS-A2-A1.
  2009-01-01 12:00  =>     IF ((WS-A4 > '2009') AND (WS-A4 < '2020'))
  2009-01-01 12:00  =>        MOVE '_' TO WS-A2-A1.
  2009-01-01 12:00  =>     IF ((WS-A4 > '2019') AND (WS-A4 < '2030'))
  2009-01-01 12:00  =>        MOVE '|' TO WS-A2-A1.
  2009-01-01 12:00  =>     IF ((WS-A4 > '2029') AND (WS-A4 < '2040'))
  2009-01-01 12:00  =>        MOVE '~' TO WS-A2-A1.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-4-2-EXIT.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-2-4.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     IF WS-A2 = '00'
  2009-01-01 12:00  =>        MOVE '0000' TO WS-A4
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     IF WS-A2 = '  '
  2009-01-01 12:00  =>        MOVE '    ' TO WS-A4
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = ';'
  2009-01-01 12:00  =>        MOVE '20' TO WS-A4-SS
  2009-01-01 12:00  =>        MOVE '0'  TO WS-A4-A1
  2009-01-01 12:00  =>        MOVE WS-A2-A2  TO WS-A4-A2
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '_'
  2009-01-01 12:00  =>        MOVE '20' TO WS-A4-SS
  2009-01-01 12:00  =>        MOVE '1'  TO WS-A4-A1
  2009-01-01 12:00  =>        MOVE WS-A2-A2  TO WS-A4-A2
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '|'
  2009-01-01 12:00  =>        MOVE '20' TO WS-A4-SS
  2009-01-01 12:00  =>        MOVE '2'  TO WS-A4-A1
  2009-01-01 12:00  =>        MOVE WS-A2-A2  TO WS-A4-A2
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '~'
  2009-01-01 12:00  =>        MOVE '20' TO WS-A4-SS
  2009-01-01 12:00  =>        MOVE '3'  TO WS-A4-A1
  2009-01-01 12:00  =>        MOVE WS-A2-A2  TO WS-A4-A2
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-2-4-EXIT.
  2009-01-01 12:00  =>     MOVE '19'     TO WS-A4-SS.
  2009-01-01 12:00  =>     MOVE WS-A2    TO WS-A4-AA.
  2009-01-01 12:00  =>     GO TO TRANSFO-DATE-2-4-EXIT.
