<OBJECT=ASSURFED-UTILIT-TAPELD-GN,COBOL PROGRAM>
<REVDATA>
<VERSION=1.0>
<USER=>
<DATE=20090101>
<TIME=1200>
<LOCKED=False>
<DESCRIPTION=COBOL PROGRAM>
</REVDATA>
<DATA=Options>
  Name=ASSURFED-UTILIT-TAPELD-GN
  Description=COBOL PROGRAM
  Parameter=
</DATA>
<DATA=Code>
  2009-01-01 12:00  => IDENTIFICATION DIVISION.
  2009-01-01 12:00  =>* SSG-4 (MT-043): one TAPELD (CFH-COPY to PRINTER with page
  2009-01-01 12:00  =>* titles) for every call. Record shapes, field moves and the title
  2009-01-01 12:00  =>* come from the SGSPARM file written by the skeleton hand-off; see
  2009-01-01 12:00  =>* _scratch\spike-tapeld\spec.md. Statements as the skeleton.
  2009-01-01 12:00  => PROGRAM-ID. 'ASSURFED-UTILIT-TAPELD-GN'.
  2009-01-01 12:00  => ENVIRONMENT DIVISION.
  2009-01-01 12:00  => CONFIGURATION SECTION.
  2009-01-01 12:00  => SOURCE-COMPUTER. UNIVAC-1106.
  2009-01-01 12:00  => OBJECT-COMPUTER. UNIVAC-1106.
  2009-01-01 12:00  => SPECIAL-NAMES.
  2009-01-01 12:00  =>     DECIMAL-POINT IS COMMA.
  2009-01-01 12:00  => INPUT-OUTPUT SECTION.
  2009-01-01 12:00  => FILE-CONTROL.
  2009-01-01 12:00  =>     SELECT  PARMF  ASSIGN  TO  DISC SGSPARM.
  2009-01-01 12:00  =>     SELECT  TAPEIN  ASSIGN  TO  DISC TAPLIN.
  2009-01-01 12:00  =>     SELECT   TAPEOUT  ASSIGN  TO  PRINTER.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
  2009-01-01 12:00  => FD  PARMF
  2009-01-01 12:00  =>     LABEL RECORD STANDARD.
  2009-01-01 12:00  => 01  PARM-REC.
  2009-01-01 12:00  =>     03  P-TYPE         PIC XX.
  2009-01-01 12:00  =>     03  P-REST         PIC X(248).
  2009-01-01 12:00  => 01  PARM-LEN-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PL-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(243).
  2009-01-01 12:00  => 01  PARM-MOVE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PM-IS          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-IL          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-OS          PIC 9(5).
  2009-01-01 12:00  =>     03  PM-OL          PIC 9(5).
  2009-01-01 12:00  =>     03  FILLER         PIC X(228).
  2009-01-01 12:00  => 01  PARM-FIXE-REC.
  2009-01-01 12:00  =>     03  FILLER         PIC XX.
  2009-01-01 12:00  =>     03  PX-OS          PIC 9(5).
  2009-01-01 12:00  =>     03  PX-LEN         PIC 9(5).
  2009-01-01 12:00  =>     03  PX-TXT         PIC X(238).
  2009-01-01 12:00  => FD  TAPEIN
  2009-01-01 12:00  =>     LABEL  RECORD  STANDARD
  2009-01-01 12:00  =>     RECORD VARYING IN SIZE FROM 1 TO 4001
  2009-01-01 12:00  =>     DEPENDING ON WS-IN-LEN.
  2009-01-01 12:00  => 01  RECIN-FD           PIC X(4001).
  2009-01-01 12:00  => FD  TAPEOUT
  2009-01-01 12:00  =>     LABEL  RECORD OMITTED
  2009-01-01 12:00  =>     DATA RECORD RECOUT.
  2009-01-01 12:00  => 01  RECOUT  PIC  X(132).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 77  NB-LUS   PIC  S9(10)  COMP  VALUE 0.
  2009-01-01 12:00  => 77  LNCTR  PIC  S9(2)  VALUE 58.
  2009-01-01 12:00  => 01   SWITCHES.
  2009-01-01 12:00  =>     03  REC-SKIPPED  PIC  S9(6) VALUE ZEROES.
  2009-01-01 12:00  => 01  RECIN              PIC X(4001).
  2009-01-01 12:00  => 01  WS-IN              PIC X(4000).
  2009-01-01 12:00  => 77  WS-IN-LEN          PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  CP-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-INLEN            PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-OUTLEN           PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-STITRE           PIC X VALUE 'N'.
  2009-01-01 12:00  => 77  N-MV               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  N-FX               PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 77  I                  PIC 9(3) COMP VALUE 0.
  2009-01-01 12:00  => 01  MV-TAB.
  2009-01-01 12:00  =>     03  MV-ENT OCCURS 60.
  2009-01-01 12:00  =>         05  MV-IS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-IL      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-OS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  MV-OL      PIC 9(5) COMP.
  2009-01-01 12:00  => 01  FX-TAB.
  2009-01-01 12:00  =>     03  FX-ENT OCCURS 40.
  2009-01-01 12:00  =>         05  FX-OS      PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  FX-LEN     PIC 9(5) COMP.
  2009-01-01 12:00  =>         05  FX-TXT     PIC X(238).
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT PARMF.
  2009-01-01 12:00  => PARM-LECT.
  2009-01-01 12:00  =>     READ PARMF AT END GO TO PARM-FIN.
  2009-01-01 12:00  =>     IF P-TYPE = 'IN'
  2009-01-01 12:00  =>        MOVE PL-LEN TO P-INLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'OU'
  2009-01-01 12:00  =>        MOVE PL-LEN TO P-OUTLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'MV'
  2009-01-01 12:00  =>        ADD 1 TO N-MV
  2009-01-01 12:00  =>        MOVE PM-IS TO MV-IS (N-MV)
  2009-01-01 12:00  =>        MOVE PM-IL TO MV-IL (N-MV)
  2009-01-01 12:00  =>        MOVE PM-OS TO MV-OS (N-MV)
  2009-01-01 12:00  =>        MOVE PM-OL TO MV-OL (N-MV).
  2009-01-01 12:00  =>     IF P-TYPE = 'FX'
  2009-01-01 12:00  =>        ADD 1 TO N-FX
  2009-01-01 12:00  =>        MOVE PX-OS TO FX-OS (N-FX)
  2009-01-01 12:00  =>        MOVE PX-LEN TO FX-LEN (N-FX)
  2009-01-01 12:00  =>        MOVE PX-TXT TO FX-TXT (N-FX).
  2009-01-01 12:00  =>     IF P-TYPE = 'ST'
  2009-01-01 12:00  =>        MOVE 'Y' TO P-STITRE.
  2009-01-01 12:00  =>     GO TO PARM-LECT.
  2009-01-01 12:00  => PARM-FIN.
  2009-01-01 12:00  =>     CLOSE PARMF.
  2009-01-01 12:00  =>     OPEN INPUT TAPEIN.
  2009-01-01 12:00  =>     OPEN  OUTPUT  TAPEOUT.
  2009-01-01 12:00  => LECT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECOUT.
  2009-01-01 12:00  =>     IF P-STITRE NOT = 'Y' OR N-FX = 0 GO TO LECT-READ.
  2009-01-01 12:00  =>     IF LNCTR NOT > 57 GO TO LECT-READ.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => TITLE-MOVE.
  2009-01-01 12:00  =>     IF I > N-FX GO TO TITLE-WRITE.
  2009-01-01 12:00  =>     MOVE FX-TXT (I) (1:FX-LEN (I))
  2009-01-01 12:00  =>       TO RECOUT (FX-OS (I):FX-LEN (I)).
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO TITLE-MOVE.
  2009-01-01 12:00  => TITLE-WRITE.
  2009-01-01 12:00  =>     WRITE  RECOUT  AFTER  PAGE
  2009-01-01 12:00  =>     MOVE SPACES TO  RECOUT
  2009-01-01 12:00  =>     MOVE 5 TO LNCTR.
  2009-01-01 12:00  => LECT-READ.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     READ  TAPEIN  INTO RECIN  AT  END  GO TO  FINW.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-IN.
  2009-01-01 12:00  =>     MOVE WS-IN-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > P-INLEN
  2009-01-01 12:00  =>        MOVE P-INLEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > 0
  2009-01-01 12:00  =>        MOVE RECIN (1:CP-LEN) TO WS-IN (1:CP-LEN).
  2009-01-01 12:00  =>     IF N-MV = 0
  2009-01-01 12:00  =>        MOVE WS-IN (1:P-INLEN) TO RECOUT.
  2009-01-01 12:00  =>     MOVE 1 TO I.
  2009-01-01 12:00  => MV-LOOP.
  2009-01-01 12:00  =>     IF I > N-MV GO TO MV-END.
  2009-01-01 12:00  =>     MOVE WS-IN (MV-IS (I):MV-IL (I))
  2009-01-01 12:00  =>       TO RECOUT (MV-OS (I):MV-OL (I)).
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO MV-LOOP.
  2009-01-01 12:00  => MV-END.
  2009-01-01 12:00  =>     ADD 1  TO NB-LUS.
  2009-01-01 12:00  =>     ADD 1  TO LNCTR.
  2009-01-01 12:00  =>     WRITE RECOUT.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => FINW.
  2009-01-01 12:00  =>     DISPLAY  '*CFH-COPY  FIN*'  UPON  PRINTER.
  2009-01-01 12:00  =>     DISPLAY  '*NB-ENREG-LUS ='  NB-LUS  UPON  PRINTER.
  2009-01-01 12:00  =>     CLOSE  TAPEIN.
  2009-01-01 12:00  =>     CLOSE  TAPEOUT.
  2009-01-01 12:00  =>     DISPLAY  REC-SKIPPED  UPON  PRINTER.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
<DATA=Documentation>
  -MAP-
  Documentation
  * SSG-4 (MT-043): one TAPELD (CFH-COPY to PRINTER with page
  * titles) for every call. Record shapes, field moves and the title
  * come from the SGSPARM file written by the skeleton hand-off; see
  * _scratch\spike-tapeld\spec.md. Statements as the skeleton.
  PROGRAM-ID. .
  -MAPEND-
  -MAP-
  Technical issues
  -MAPEND-
</DATA>
<IN FOLDER>
COBOL
</IN FOLDER>
</OBJECT>
