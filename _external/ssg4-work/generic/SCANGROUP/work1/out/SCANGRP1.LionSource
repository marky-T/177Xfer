  2009-01-01 12:00  =>     RECOUT.
  2009-01-01 12:00  => 01  RECOUT  PIC  X(132).
  2009-01-01 12:00  => 01  REC21.
  2009-01-01 12:00  =>     06 ZONO1 PIC X(7).
  2009-01-01 12:00  => 01  REC22.
  2009-01-01 12:00  =>     06 FILLER PIC  X(9).
  2009-01-01 12:00  =>     06 ZONO2 PIC X(2).
  2009-01-01 12:00  => 01  REC23.
  2009-01-01 12:00  =>     06 FILLER PIC  X(17).
  2009-01-01 12:00  =>     06 ZONO3 PIC X(2).
  2009-01-01 12:00  => 01  REC31.
  2009-01-01 12:00  =>     06 FIXDATA1 PIC X(24).
  2009-01-01 12:00  => 01  REC32.
  2009-01-01 12:00  =>     06 FILLER PIC  X(25).
  2009-01-01 12:00  =>     06 FIXDATA2 PIC X(30).
  2009-01-01 12:00  => WORKING-STORAGE SECTION.
  2009-01-01 12:00  => 77  NB-LUS   PIC  S9(10)  COMP  VALUE 0.
  2009-01-01 12:00  => 77  LNCTR  PIC  S9(2)  VALUE 58.
  2009-01-01 12:00  => 01  TITLE-LINE         USAGE DISP-1.
  2009-01-01 12:00  =>     03  FILLER         PIC X(4) VALUE 'H,,,'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10)  VALUE '1234567890'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10)  VALUE '1234567890'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10)  VALUE '1234567890'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10)  VALUE '1234567890'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10) VALUE '1234567890'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(5)  VALUE SPACES.
  2009-01-01 12:00  =>     03  FILLER         PIC X(12) VALUE 'IPBA04CBB'.
  2009-01-01 12:00  =>     03  FILLER         PIC X(13) VALUE ' TO PRINTER '.
  2009-01-01 12:00  =>     03  FILLER         PIC X(10) VALUE '1234567890'.
