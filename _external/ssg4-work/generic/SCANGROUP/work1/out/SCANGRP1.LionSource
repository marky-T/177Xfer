  2009-01-01 12:00  =>     SELECT  TAPEIN  ASSIGN  TO  DISC IN1.
  2009-01-01 12:00  =>     SELECT   TAPEOUT  ASSIGN  TO  PRINTER.
  2009-01-01 12:00  => DATA DIVISION.
  2009-01-01 12:00  => FILE SECTION.
