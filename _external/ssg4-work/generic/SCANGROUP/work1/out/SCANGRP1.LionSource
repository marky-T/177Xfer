  2009-01-01 12:00  => TRANSFO-DATE-66A.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     IF WS-A6 NOT NUMERIC
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-66A-EXIT.
  2009-01-01 12:00  =>     IF ((WS-A6-MM > '15') or (WS-A6-MM = '00'))
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-66A-EXIT.
  2009-01-01 12:00  =>     IF ((WS-A6-JJ > '35') or (WS-A6-JJ = '00'))
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-66A-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = '0'
  2009-01-01 12:00  =>        MOVE ';'      TO WS-A6-Y1
  2009-01-01 12:00  =>        MOVE 'Y' TO WS-RECORD-TRANSFORME-66A-200X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-66A-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = '1'
  2009-01-01 12:00  =>        MOVE '_'      TO WS-A6-Y1
