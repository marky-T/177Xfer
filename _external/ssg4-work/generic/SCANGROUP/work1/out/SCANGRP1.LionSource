  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT PARMF.
  2009-01-01 12:00  => PARM-LECT.
  2009-01-01 12:00  =>     READ PARMF AT END GO TO PARM-FIN.
  2009-01-01 12:00  =>     IF P-TYPE = 'FI'
  2009-01-01 12:00  =>        MOVE PL-LEN TO P-INLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'FO'
  2009-01-01 12:00  =>        MOVE PL-LEN TO P-OUTLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'CA' OR P-TYPE = 'OT' OR P-TYPE = 'NG'
  2009-01-01 12:00  =>        ADD 1 TO N-GRP
  2009-01-01 12:00  =>        MOVE P-TYPE (1:1) TO G-KIND (N-GRP)
  2009-01-01 12:00  =>        MOVE 0 TO G-CN (N-GRP)
  2009-01-01 12:00  =>        COMPUTE G-T1 (N-GRP) = N-TS + 1
  2009-01-01 12:00  =>        MOVE N-TS TO G-TN (N-GRP)
  2009-01-01 12:00  =>        COMPUTE G-O1 (N-GRP) = N-OP + 1
  2009-01-01 12:00  =>        MOVE N-OP TO G-ON (N-GRP).
  2009-01-01 12:00  =>     IF P-TYPE = 'CA'
  2009-01-01 12:00  =>        ADD 1 TO N-CASE
  2009-01-01 12:00  =>        MOVE N-CASE TO G-CN (N-GRP).
  2009-01-01 12:00  =>     IF P-TYPE = 'OT'
  2009-01-01 12:00  =>        ADD 1 TO N-OTH.
  2009-01-01 12:00  =>     IF P-TYPE = 'TS'
  2009-01-01 12:00  =>        ADD 1 TO N-TS
  2009-01-01 12:00  =>        MOVE PV-POS TO T-POS (N-TS)
  2009-01-01 12:00  =>        MOVE PV-LEN TO T-LEN (N-TS)
  2009-01-01 12:00  =>        MOVE PV-TXT TO T-VAL (N-TS)
  2009-01-01 12:00  =>        MOVE N-TS TO G-TN (N-GRP).
  2009-01-01 12:00  =>     IF P-TYPE = 'MV'
  2009-01-01 12:00  =>        ADD 1 TO N-OP
  2009-01-01 12:00  =>        MOVE 'M' TO O-TYPE (N-OP)
  2009-01-01 12:00  =>        MOVE PM-IS TO O-IS (N-OP)
  2009-01-01 12:00  =>        MOVE PM-IL TO O-IL (N-OP)
  2009-01-01 12:00  =>        MOVE PM-OS TO O-OS (N-OP)
  2009-01-01 12:00  =>        MOVE PM-OL TO O-OL (N-OP)
  2009-01-01 12:00  =>        MOVE PM-CODE TO O-CODE (N-OP)
  2009-01-01 12:00  =>        MOVE N-OP TO G-ON (N-GRP).
  2009-01-01 12:00  =>     IF P-TYPE = 'CO'
  2009-01-01 12:00  =>        ADD 1 TO N-OP
  2009-01-01 12:00  =>        ADD 1 TO N-CO
  2009-01-01 12:00  =>        MOVE 'K' TO O-TYPE (N-OP)
  2009-01-01 12:00  =>        MOVE PV-POS TO O-OS (N-OP)
  2009-01-01 12:00  =>        MOVE PV-LEN TO O-OL (N-OP)
  2009-01-01 12:00  =>        MOVE PV-TXT TO CO-VAL (N-CO)
  2009-01-01 12:00  =>        MOVE N-CO TO O-CX (N-OP)
  2009-01-01 12:00  =>        MOVE N-OP TO G-ON (N-GRP).
  2009-01-01 12:00  =>     GO TO PARM-LECT.
  2009-01-01 12:00  => PARM-FIN.
  2009-01-01 12:00  =>     CLOSE PARMF.
  2009-01-01 12:00  =>     OPEN INPUT FI1.
  2009-01-01 12:00  =>     OPEN OUTPUT FO1.
  2009-01-01 12:00  =>     MOVE 0 TO NB-REC-LU.
