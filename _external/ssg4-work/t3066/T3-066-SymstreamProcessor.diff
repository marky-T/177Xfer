+    /// <summary>
+    /// Tells whether an ECL image (# or @ form) calls a COBOL compiler with the I option, i.e. the compiler reads its source
+    /// from the images that follow in the run stream, up to @EOF (T3-066).
+    /// </summary>
+    private static Boolean IsInlineSourceCompilerCall (String eclLine) {
+      String body = eclLine.Substring(1);
+      Int32 end = 0;
+      while (end < body.Length && body[end] != ',' && !Char.IsWhiteSpace(body[end])) { end++; }
+      if (!s_InlineSourceCompilers.Contains(body.Substring(0, end))) { return false; }
+      if (end >= body.Length || body[end] != ',') { return false; }
+      Int32 optEnd = end + 1;
+      while (optEnd < body.Length && !Char.IsWhiteSpace(body[optEnd]) && body[optEnd] != ',') { optEnd++; }
+      return body.Substring(end + 1, optEnd - end - 1).IndexOf('I', StringComparison.OrdinalIgnoreCase) >= 0;
+    } // IsInlineSourceCompilerCall
