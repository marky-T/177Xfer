  2009-01-01 12:00  => 77  P-OP               PIC X VALUE SPACE.
  2009-01-01 12:00  => 77  P-REL              PIC XX VALUE SPACES.
  2009-01-01 12:00  => 77  P-LITLEN           PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-LITN             PIC 9(9) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-LIT              PIC X(100) VALUE SPACES.
  2009-01-01 12:00  => 77  P-ND               PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  P-Z5               PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 01  YP-TAB.
  2009-01-01 12:00  =>     03  YP             PIC 9(5) COMP OCCURS 40 TIMES.
  2009-01-01 12:00  => 77  DA                 PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  CP-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  CC-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  ZL-LEN             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  KP                 PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  COND-OK            PIC 9 VALUE 0.
  2009-01-01 12:00  => 01  RECIN              PIC X(4001).
  2009-01-01 12:00  => 01  CRDREC             PIC X(4001).
  2009-01-01 12:00  => 01  ZL1                PIC X(4001).
  2009-01-01 12:00  => 01  SYMK-W             PIC X(4001).
  2009-01-01 12:00  => 01  W-A                PIC X(4001).
  2009-01-01 12:00  => 01  W-B                PIC X(4001).
  2009-01-01 12:00  => 01  WREC               PIC X(4001).
  2009-01-01 12:00  => 77  INDEXI             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  INDEXO             PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  SW-AVANT           PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  DCNT               PIC S9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  W3                 PIC 9(5) COMP VALUE 0.
  2009-01-01 12:00  => 77  WS-MARK            PIC X VALUE SPACE.
  2009-01-01 12:00  => 01  TAB-INPUT.
  2009-01-01 12:00  =>     03  TAB-I          PIC X OCCURS 4200 TIMES.
  2009-01-01 12:00  => 01  TAB-OUTPUT.
  2009-01-01 12:00  =>     03  TAB-O          PIC X OCCURS 4200 TIMES.
  2009-01-01 12:00  => 01  TIT.
  2009-01-01 12:00  =>     03  FILLER      PIC X(5) VALUE '***  '.
  2009-01-01 12:00  =>     03  FILLER        PIC X(14) VALUE 'RECORD NUMERO '.
  2009-01-01 12:00  =>     03  FILCO     PIC Z.ZZZ.ZZZ.
  2009-01-01 12:00  =>     03  FILLER      PIC X(5) VALUE '  ***'.
  2009-01-01 12:00  => 01  ZPR  USAGE DISPLAY-1  VALUE ALL SPACES.
  2009-01-01 12:00  =>     03  ZP1            PIC X(100) USAGE DISPLAY-1.
