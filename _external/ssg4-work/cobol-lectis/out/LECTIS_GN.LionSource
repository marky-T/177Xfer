  2009-01-01 12:00  =>     03  ZP3            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP4            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP5            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP6            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP7            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP8            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP9            PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP10           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP11           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP12           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP13           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP14           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP15           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP16           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP17           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP18           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP19           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  =>     03  ZP20           PIC X(100) USAGE DISPLAY-1.
  2009-01-01 12:00  => 01  CTRLI PIC 9(4) VALUE ZEROES.
  2009-01-01 12:00  => 01  CTR                PIC S9(7) VALUE 0.
  2009-01-01 12:00  => 01  SWI                PIC S9 VALUE 0.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.
  2009-01-01 12:00  =>     OPEN INPUT PARMF.
  2009-01-01 12:00  => PARM-LECT.
  2009-01-01 12:00  =>     READ PARMF AT END GO TO PARM-FIN.
  2009-01-01 12:00  =>     IF P-TYPE = 'IN'
  2009-01-01 12:00  =>        MOVE PI-LEN TO P-LEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'KY'
  2009-01-01 12:00  =>        MOVE PK-OFF TO P-OFF
  2009-01-01 12:00  =>        MOVE PK-LEN TO P-KLEN.
  2009-01-01 12:00  =>     IF P-TYPE = 'MD'
  2009-01-01 12:00  =>        MOVE PM-KEYS TO P-KEYS
  2009-01-01 12:00  =>        MOVE PM-NOLIST TO P-NOLIST
  2009-01-01 12:00  =>        MOVE PM-Y2K TO P-Y2K.
  2009-01-01 12:00  =>     IF P-TYPE = 'CD'
  2009-01-01 12:00  =>        MOVE PC-OP TO P-OP
  2009-01-01 12:00  =>        MOVE PC-REL TO P-REL
  2009-01-01 12:00  =>        MOVE PC-LITLEN TO P-LITLEN
  2009-01-01 12:00  =>        MOVE PC-LIT TO P-LIT.
  2009-01-01 12:00  =>     IF P-TYPE = 'CD' AND PC-OP = 'C'
  2009-01-01 12:00  =>        MOVE PC-LITN TO P-LITN.
  2009-01-01 12:00  =>     IF P-TYPE = 'YD'
  2009-01-01 12:00  =>        PERFORM YD-COPY THRU YD-COPY-EXIT.
  2009-01-01 12:00  =>     GO TO PARM-LECT.
  2009-01-01 12:00  => PARM-FIN.
  2009-01-01 12:00  =>     CLOSE PARMF.
  2009-01-01 12:00  => OUVERT.
  2009-01-01 12:00  =>     OPEN OUTPUT IMP.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP1 BEFORE PAGE.
  2009-01-01 12:00  =>     IF P-KEYS = 1 GO TO KEY-OPEN.
  2009-01-01 12:00  =>     OPEN INPUT LECIN.
  2009-01-01 12:00  => LECTURE.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     READ LECIN INTO RECIN AT END GO TO FIN.
  2009-01-01 12:00  =>     PERFORM LOAD-WREC THRU LOAD-WREC-EXIT.
  2009-01-01 12:00  =>     ADD 1 TO CTR.
  2009-01-01 12:00  =>     IF P-NOLIST = 1 GO TO LECTURE.
  2009-01-01 12:00  =>     PERFORM COND-TEST THRU COND-TEST-EXIT.
  2009-01-01 12:00  =>     IF COND-OK = 0 GO TO LECTURE.
  2009-01-01 12:00  => SUITE.
  2009-01-01 12:00  =>     MOVE CTR TO FILCO.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM TIT BEFORE 1.
  2009-01-01 12:00  =>     MOVE WREC TO ZPR.
  2009-01-01 12:00  =>     PERFORM IMPRES THRU FIIMPRES.
  2009-01-01 12:00  =>     GO TO LECTURE.
  2009-01-01 12:00  => KEY-OPEN.
  2009-01-01 12:00  =>     OPEN INPUT LECCRD.
  2009-01-01 12:00  =>     MOVE P-KLEN TO ZL-LEN.
  2009-01-01 12:00  =>     IF P-Y2K = 1 MOVE P-Z5 TO ZL-LEN.
  2009-01-01 12:00  => KEY-LOOP.
  2009-01-01 12:00  =>     MOVE SPACES TO CRDREC.
  2009-01-01 12:00  =>     READ LECCRD INTO CRDREC AT END GO TO FIN.
  2009-01-01 12:00  =>     MOVE SPACES TO ZL1.
  2009-01-01 12:00  =>     MOVE WS-CRD-LEN TO CC-LEN.
  2009-01-01 12:00  =>     IF CC-LEN > ZL-LEN
  2009-01-01 12:00  =>        MOVE ZL-LEN TO CC-LEN.
  2009-01-01 12:00  =>     IF CC-LEN > 0
  2009-01-01 12:00  =>        MOVE CRDREC (1:CC-LEN) TO ZL1 (1:CC-LEN).
  2009-01-01 12:00  =>     MOVE SPACES TO SYMK-W.
  2009-01-01 12:00  =>     IF P-Y2K = 0 GO TO KEY-PLAIN.
  2009-01-01 12:00  =>     PERFORM FORMAT-CLE THRU FORMAT-CLE-EXIT.
  2009-01-01 12:00  =>     MOVE TAB-OUTPUT (1:P-KLEN) TO SYMK-W (1:P-KLEN).
  2009-01-01 12:00  =>     GO TO KEY-FIND.
  2009-01-01 12:00  => KEY-PLAIN.
  2009-01-01 12:00  =>     MOVE ZL1 (1:P-KLEN) TO SYMK-W (1:P-KLEN).
  2009-01-01 12:00  => KEY-FIND.
  2009-01-01 12:00  =>     PERFORM SEARCH-KEY THRU SK-EXIT.
  2009-01-01 12:00  =>     IF SWI = 1 ADD 1 TO CTR.
  2009-01-01 12:00  =>     IF SWI NOT = 1 MOVE WREC TO ZPR
  2009-01-01 12:00  =>        PERFORM IMPRES THRU FIIMPRES.
  2009-01-01 12:00  =>     MOVE 0 TO SWI.
  2009-01-01 12:00  =>     GO TO KEY-LOOP.
  2009-01-01 12:00  => FIN.
  2009-01-01 12:00  =>     MOVE SPACES TO ZPRINT.
  2009-01-01 12:00  =>     WRITE ZPRINT BEFORE SAUT.
  2009-01-01 12:00  =>     DISPLAY '** FIN DU TRAVAIL **' UPON PRINTER.
  2009-01-01 12:00  =>     IF P-KEYS = 0
  2009-01-01 12:00  =>        DISPLAY 'NOMBRE DE RECORDS LUS ** ' CTR UPON PRINTER.
  2009-01-01 12:00  =>     IF P-KEYS = 1
  2009-01-01 12:00  =>        DISPLAY 'NOMBRE D INVALID KEY **' CTR UPON PRINTER.
  2009-01-01 12:00  =>     CLOSE IMP.
  2009-01-01 12:00  =>     IF P-KEYS = 0 CLOSE LECIN.
  2009-01-01 12:00  =>     IF P-KEYS = 1 CLOSE LECCRD.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => YD-COPY.
  2009-01-01 12:00  =>     MOVE PY-ND TO P-ND.
  2009-01-01 12:00  =>     MOVE PY-Z5 TO P-Z5.
  2009-01-01 12:00  =>     MOVE 1 TO DA.
  2009-01-01 12:00  => YD-COPY-LOOP.
  2009-01-01 12:00  =>     IF DA > P-ND GO TO YD-COPY-EXIT.
  2009-01-01 12:00  =>     MOVE PY-POS (DA) TO YP (DA).
  2009-01-01 12:00  =>     ADD 1 TO DA.
  2009-01-01 12:00  =>     GO TO YD-COPY-LOOP.
  2009-01-01 12:00  => YD-COPY-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => LOAD-WREC.
  2009-01-01 12:00  =>     MOVE SPACES TO WREC.
  2009-01-01 12:00  =>     MOVE WS-IN-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > P-LEN
  2009-01-01 12:00  =>        MOVE P-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > 0
  2009-01-01 12:00  =>        MOVE RECIN (1:CP-LEN) TO WREC (1:CP-LEN).
  2009-01-01 12:00  => LOAD-WREC-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => COND-TEST.
  2009-01-01 12:00  =>     MOVE 0 TO COND-OK.
  2009-01-01 12:00  =>     IF P-OP = 'K' GO TO COND-KEY.
  2009-01-01 12:00  =>     IF P-REL = 'EQ' AND CTR = P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'NE' AND CTR NOT = P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'GT' AND CTR > P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'LT' AND CTR < P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'GE' AND CTR NOT < P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'LE' AND CTR NOT > P-LITN MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     GO TO COND-TEST-EXIT.
  2009-01-01 12:00  => COND-KEY.
  2009-01-01 12:00  =>     MOVE SPACES TO W-A.
  2009-01-01 12:00  =>     MOVE SPACES TO W-B.
  2009-01-01 12:00  =>     COMPUTE KP = P-OFF + 1.
  2009-01-01 12:00  =>     MOVE WREC (KP:P-KLEN) TO W-A (1:P-KLEN).
  2009-01-01 12:00  =>     MOVE P-LIT (1:P-LITLEN) TO W-B (1:P-LITLEN).
  2009-01-01 12:00  =>     IF P-REL = 'EQ' AND W-A = W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'NE' AND W-A NOT = W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'GT' AND W-A > W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'LT' AND W-A < W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'GE' AND W-A NOT < W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  =>     IF P-REL = 'LE' AND W-A NOT > W-B MOVE 1 TO COND-OK.
  2009-01-01 12:00  => COND-TEST-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => SEARCH-KEY.
  2009-01-01 12:00  =>     MOVE 1 TO SWI.
  2009-01-01 12:00  =>     COMPUTE KP = P-OFF + 1.
  2009-01-01 12:00  =>     OPEN INPUT LECIN.
  2009-01-01 12:00  => SK-LOOP.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     READ LECIN INTO RECIN AT END GO TO SK-CLOSE.
  2009-01-01 12:00  =>     PERFORM LOAD-WREC THRU LOAD-WREC-EXIT.
  2009-01-01 12:00  =>     IF WREC (KP:P-KLEN) = SYMK-W (1:P-KLEN)
  2009-01-01 12:00  =>        MOVE 0 TO SWI
  2009-01-01 12:00  =>        GO TO SK-CLOSE.
  2009-01-01 12:00  =>     GO TO SK-LOOP.
  2009-01-01 12:00  => SK-CLOSE.
  2009-01-01 12:00  =>     CLOSE LECIN.
  2009-01-01 12:00  => SK-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => IMPRES.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP1 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP2 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP3 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP4 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP5 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP6 BEFORE 1.
