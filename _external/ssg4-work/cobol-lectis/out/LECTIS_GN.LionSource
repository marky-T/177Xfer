  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP7 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP8 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP9 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP10 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP11 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP12 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     WRITE ZPRINT FROM ZP13 BEFORE 1.
  2009-01-01 12:00  =>     ADD 100 TO CTRLI.
  2009-01-01 12:00  =>     IF P-LEN = CTRLI GO TO RAZ.
  2009-01-01 12:00  =>     IF P-LEN < CTRLI GO TO RAZ.
