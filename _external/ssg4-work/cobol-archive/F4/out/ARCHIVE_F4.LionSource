  2009-01-01 12:00  =>*---------------------*
  2009-01-01 12:00  => file-control.
  2009-01-01 12:00  =>     select fic-report assign to disc      ARF4-REPORT.
  2009-01-01 12:00  =>     select fic-descript assign to disc    ARF4-DESCRIPT.
  2009-01-01 12:00  =>     select fic-unload assign to disc      ARF4-UNLOAD.
