  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-68.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     MOVE WS-A6 TO WS-A8-YYMMJJ.
  2009-01-01 12:00  =>     MOVE '19'  to WS-A8-YY.
  2009-01-01 12:00  =>     IF WS-A6 = '      '
  2009-01-01 12:00  =>        MOVE '        ' to WS-A8
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     IF WS-A6 = '000000'
  2009-01-01 12:00  =>        MOVE '00000000' to WS-A8
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = ';'
  2009-01-01 12:00  =>        MOVE '200'    TO WS-A8-YYY
  2009-01-01 12:00  =>        MOVE WS-A6-Y2 TO WS-A8-Y4
  2009-01-01 12:00  =>        MOVE WS-A6-MM TO WS-A8-MM
  2009-01-01 12:00  =>        MOVE WS-A6-JJ TO WS-A8-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = '_'
  2009-01-01 12:00  =>        MOVE '201'    TO WS-A8-YYY
  2009-01-01 12:00  =>        MOVE WS-A6-Y2 TO WS-A8-Y4
  2009-01-01 12:00  =>        MOVE WS-A6-MM TO WS-A8-MM
  2009-01-01 12:00  =>        MOVE WS-A6-JJ TO WS-A8-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = '|'
  2009-01-01 12:00  =>        MOVE '202'    TO WS-A8-YYY
  2009-01-01 12:00  =>        MOVE WS-A6-Y2 TO WS-A8-Y4
  2009-01-01 12:00  =>        MOVE WS-A6-MM TO WS-A8-MM
  2009-01-01 12:00  =>        MOVE WS-A6-JJ TO WS-A8-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>     IF WS-A6-Y1 = '~'
  2009-01-01 12:00  =>        MOVE '203'    TO WS-A8-YYY
  2009-01-01 12:00  =>        MOVE WS-A6-Y2 TO WS-A8-Y4
  2009-01-01 12:00  =>        MOVE WS-A6-MM TO WS-A8-MM
  2009-01-01 12:00  =>        MOVE WS-A6-JJ TO WS-A8-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-68-EXIT.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-86.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     MOVE WS-A8-YYMMJJ TO WS-A6.
  2009-01-01 12:00  =>     IF WS-A8 NOT NUMERIC
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF ((WS-A8-MM > '15') or (WS-A8-MM = '00'))
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF ((WS-A8-JJ > '35') or (WS-A8-JJ = '00'))
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF WS-A8-YYY = '200'
  2009-01-01 12:00  =>        MOVE ';'      TO WS-A6-Y1
  2009-01-01 12:00  =>        MOVE WS-A8-Y4 TO WS-A6-Y2
  2009-01-01 12:00  =>        MOVE WS-A8-MM TO WS-A6-MM
  2009-01-01 12:00  =>        MOVE WS-A8-JJ TO WS-A6-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF WS-A8-YYY = '201'
  2009-01-01 12:00  =>        MOVE '_'      TO WS-A6-Y1
  2009-01-01 12:00  =>        MOVE WS-A8-Y4 TO WS-A6-Y2
  2009-01-01 12:00  =>        MOVE WS-A8-MM TO WS-A6-MM
  2009-01-01 12:00  =>        MOVE WS-A8-JJ TO WS-A6-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF WS-A8-YYY = '202'
  2009-01-01 12:00  =>        MOVE '|'      TO WS-A6-Y1
  2009-01-01 12:00  =>        MOVE WS-A8-Y4 TO WS-A6-Y2
  2009-01-01 12:00  =>        MOVE WS-A8-MM TO WS-A6-MM
  2009-01-01 12:00  =>        MOVE WS-A8-JJ TO WS-A6-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF WS-A8-YYY = '203'
  2009-01-01 12:00  =>        MOVE '~'      TO WS-A6-Y1
  2009-01-01 12:00  =>        MOVE WS-A8-Y4 TO WS-A6-Y2
  2009-01-01 12:00  =>        MOVE WS-A8-MM TO WS-A6-MM
  2009-01-01 12:00  =>        MOVE WS-A8-JJ TO WS-A6-JJ
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>     IF WS-A8-SS = '19'
  2009-01-01 12:00  =>        MOVE WS-A8-YYMMJJ   TO WS-A6
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-86-EXIT.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  =>
  2009-01-01 12:00  => TRANSFO-DATE-22B.
  2009-01-01 12:00  =>******************
  2009-01-01 12:00  =>     IF WS-A2-A1 = ';'
  2009-01-01 12:00  =>        MOVE '0'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-200X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '_'
  2009-01-01 12:00  =>        MOVE '1'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-201X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '|'
  2009-01-01 12:00  =>        MOVE '2'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-202X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
  2009-01-01 12:00  =>     IF WS-A2-A1 = '~'
  2009-01-01 12:00  =>        MOVE '3'      TO WS-A2-A1
  2009-01-01 12:00  =>        move 'Y' TO WS-RECORD-TRANSFORME-22B-203X
  2009-01-01 12:00  =>        GO TO TRANSFO-DATE-22B-EXIT.
