  2009-01-01 12:00  =>     MOVE 0 TO NB-REC-OTHER.
  2009-01-01 12:00  => TRT.
  2009-01-01 12:00  =>     MOVE SPACES TO RECIN.
  2009-01-01 12:00  =>     READ FI1 INTO RECIN AT END GO TO FIN-TRT.
  2009-01-01 12:00  =>     MOVE SPACES TO WS-IN.
  2009-01-01 12:00  =>     MOVE WS-IN-LEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > P-INLEN
  2009-01-01 12:00  =>        MOVE P-INLEN TO CP-LEN.
  2009-01-01 12:00  =>     IF CP-LEN > 0
  2009-01-01 12:00  =>        MOVE RECIN (1:CP-LEN) TO WS-IN (1:CP-LEN).
  2009-01-01 12:00  =>     MOVE SPACES TO WS-OUT.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22A-200X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22A-201X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22A-202X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22A-203X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22B-200X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22B-201X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22B-202X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-22B-203X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66A-200X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66A-201X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66A-202X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66A-203X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66B-200X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66B-201X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66B-202X.
  2009-01-01 12:00  =>     MOVE 'N' TO WS-RECORD-TRANSFORME-66B-203X.
  2009-01-01 12:00  =>     ADD 1 TO NB-REC-LU.
  2009-01-01 12:00  =>     MOVE 0 TO G.
  2009-01-01 12:00  => GRP-NEXT.
  2009-01-01 12:00  =>     ADD 1 TO G.
  2009-01-01 12:00  =>     IF G > N-GRP GO TO GRP-END.
  2009-01-01 12:00  =>     MOVE G-T1 (G) TO J.
  2009-01-01 12:00  => TST-LOOP.
  2009-01-01 12:00  =>     IF G-KIND (G) NOT = 'C' GO TO OP-START.
  2009-01-01 12:00  =>     IF J > G-TN (G) GO TO OP-START.
  2009-01-01 12:00  =>     IF WS-IN (T-POS (J):T-LEN (J)) NOT = T-VAL (J) (1:T-LEN (J))
  2009-01-01 12:00  =>        GO TO GRP-NEXT.
  2009-01-01 12:00  =>     ADD 1 TO J.
  2009-01-01 12:00  =>     GO TO TST-LOOP.
  2009-01-01 12:00  => OP-START.
  2009-01-01 12:00  =>     MOVE G-O1 (G) TO I.
  2009-01-01 12:00  => OP-LOOP.
  2009-01-01 12:00  =>     IF I > G-ON (G) GO TO OP-END.
  2009-01-01 12:00  =>     IF O-TYPE (I) = 'K'
  2009-01-01 12:00  =>        MOVE CO-VAL (O-CX (I)) (1:O-OL (I))
  2009-01-01 12:00  =>          TO WS-OUT (O-OS (I):O-OL (I))
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        IF O-CODE (I) = SPACES
  2009-01-01 12:00  =>           MOVE WS-IN (O-IS (I):O-IL (I))
  2009-01-01 12:00  =>             TO WS-OUT (O-OS (I):O-OL (I))
  2009-01-01 12:00  =>        ELSE
  2009-01-01 12:00  =>           PERFORM DATE-OP THRU DATE-OP-EXIT.
  2009-01-01 12:00  =>     ADD 1 TO I.
  2009-01-01 12:00  =>     GO TO OP-LOOP.
  2009-01-01 12:00  => OP-END.
  2009-01-01 12:00  =>     IF G-KIND (G) = 'N' GO TO GRP-NEXT.
  2009-01-01 12:00  =>     IF G-KIND (G) = 'C'
  2009-01-01 12:00  =>        ADD 1 TO NB-CASE (G-CN (G))
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-OTHER.
  2009-01-01 12:00  =>     PERFORM WRITE-REC-OUTPUT THRU WRITE-REC-OUTPUT-EXIT.
  2009-01-01 12:00  =>     GO TO TRT.
  2009-01-01 12:00  => GRP-END.
  2009-01-01 12:00  =>*    no group matched: written only when the call has no CASE and
  2009-01-01 12:00  =>*    no OTHERWISE (CASE-NON-PREVU otherwise).
  2009-01-01 12:00  =>     IF N-CASE = 0 AND N-OTH = 0
  2009-01-01 12:00  =>        ADD 1 TO NB-REC-CASE-0
  2009-01-01 12:00  =>        PERFORM WRITE-REC-OUTPUT THRU WRITE-REC-OUTPUT-EXIT.
  2009-01-01 12:00  =>     GO TO TRT.
  2009-01-01 12:00  => DATE-OP.
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D42'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):4) TO WS-A4
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-4-2 THRU TRANSFO-DATE-4-2-EXIT
  2009-01-01 12:00  =>        MOVE WS-A2 TO WS-OUT (O-OS (I):2).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D24'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):2) TO WS-A2
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-2-4 THRU TRANSFO-DATE-2-4-EXIT
  2009-01-01 12:00  =>        MOVE WS-A4 TO WS-OUT (O-OS (I):4).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D22A'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):2) TO WS-A2
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-22A THRU TRANSFO-DATE-22A-EXIT
  2009-01-01 12:00  =>        MOVE WS-A2 TO WS-OUT (O-OS (I):2).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D22B'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):2) TO WS-A2
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-22B THRU TRANSFO-DATE-22B-EXIT
  2009-01-01 12:00  =>        MOVE WS-A2 TO WS-OUT (O-OS (I):2).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D66A'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):6) TO WS-A6
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-66A THRU TRANSFO-DATE-66A-EXIT
  2009-01-01 12:00  =>        MOVE WS-A6 TO WS-OUT (O-OS (I):6).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D66B'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):6) TO WS-A6
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-66B THRU TRANSFO-DATE-66B-EXIT
  2009-01-01 12:00  =>        MOVE WS-A6 TO WS-OUT (O-OS (I):6).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D68'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):6) TO WS-A6
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-68 THRU TRANSFO-DATE-68-EXIT
  2009-01-01 12:00  =>        MOVE WS-A8 TO WS-OUT (O-OS (I):8).
  2009-01-01 12:00  =>     IF O-CODE (I) = 'D86'
  2009-01-01 12:00  =>        MOVE WS-IN (O-IS (I):8) TO WS-A8
  2009-01-01 12:00  =>        PERFORM TRANSFO-DATE-86 THRU TRANSFO-DATE-86-EXIT
  2009-01-01 12:00  =>        MOVE WS-A6 TO WS-OUT (O-OS (I):6).
  2009-01-01 12:00  => DATE-OP-EXIT.
  2009-01-01 12:00  =>     EXIT.
  2009-01-01 12:00  => FIN-TRT.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS LUS    = ' NB-REC-LU
  2009-01-01 12:00  =>                          UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS ECRITS = ' NB-REC-ECRIT
  2009-01-01 12:00  =>                          UPON PRINTER.
  2009-01-01 12:00  =>     SUBTRACT NB-REC-ECRIT FROM NB-REC-LU GIVING NB-REC-NONECRIT.
  2009-01-01 12:00  =>     IF NB-REC-NONECRIT > 0
  2009-01-01 12:00  =>        DISPLAY '*******************************' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*   attention                 *' UPON PRINTER
  2009-01-01 12:00  =>        DISPLAY '*   certains records ne       *' UPon printer
  2009-01-01 12:00  =>        DISPLAY '*   respectent aucun case     *' UPON PRInter
  2009-01-01 12:00  =>        DISPLAY '*   et ne figurent donc pas   *' UPON PRInter
  2009-01-01 12:00  =>        DISPLAY '*   sur le fichier output     *' UPON PRInter
  2009-01-01 12:00  =>        DISPLAY '*******************************' UPON PRINTER.
  2009-01-01 12:00  =>     MOVE 1 TO J.
  2009-01-01 12:00  => DSP-CASE.
  2009-01-01 12:00  =>     IF J > N-CASE GO TO DSP-END.
  2009-01-01 12:00  =>     MOVE J TO WS-N2.
  2009-01-01 12:00  =>     IF J < 10
  2009-01-01 12:00  =>        DISPLAY 'NB ENREGISTREMENTS CONDITION NO ' WS-N2 (2:1)
  2009-01-01 12:00  =>                ' = ' NB-CASE (J) UPON PRINTER
  2009-01-01 12:00  =>     ELSE
  2009-01-01 12:00  =>        DISPLAY 'NB ENREGISTREMENTS CONDITION NO ' WS-N2
  2009-01-01 12:00  =>                ' = ' NB-CASE (J) UPON PRINTER.
  2009-01-01 12:00  =>     ADD 1 TO J.
  2009-01-01 12:00  =>     GO TO DSP-CASE.
  2009-01-01 12:00  => DSP-END.
  2009-01-01 12:00  =>     DISPLAY 'NB ENREGISTREMENTS OTHER = ' NB-REC-OTHER
  2009-01-01 12:00  =>                                          UPON PRINTER.
