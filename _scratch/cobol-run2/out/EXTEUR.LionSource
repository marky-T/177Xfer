  2009-01-01 12:00  =>  LINK$PF,SYS$LIB$*APP$3.
  2009-01-01 12:00  =>  TEMPABS,F///5000
  2009-01-01 12:00  =>S ,TPF$.EXTEUR
  2009-01-01 12:00  =>   INCLUDE    TEMPUCS.EXTEUR
  2009-01-01 12:00  =>   OUTPUT ZOOM
  2009-01-01 12:00  =>   RESOLVE ALL REFERENCES USING LOCAL_DEFS,SYS$LIB$*EMOMRTS.,
  2009-01-01 12:00  =>               LIBCODENAME,UTST*OBJ
  2009-01-01 12:00  =>   SET SIZE=SIZE + 32734 FOR URTS$TABLES
  2009-01-01 12:00  =>   SET ALS_INIT_SIZE = 0117000
  2009-01-01 12:00  =>   DELETE ALL DEFINITION EXCEPT START$
