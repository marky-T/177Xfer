  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>/
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  =>********************
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>* .000. TRAITEMENT GENERAL (MAIN)                                 *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  => 000-MAIN.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>     PERFORM 010-INIT-FICHIER        THRU 010-EXIT.
  2009-01-01 12:00  =>     PERFORM 020-INIT-VARIABLES      THRU 020-EXIT.
  2009-01-01 12:00  =>     PERFORM 030-INIT-DB             THRU 030-EXIT.
  2009-01-01 12:00  =>     PERFORM 035-RECHERCHE-PHASE THRU 035-EXIT.
  2009-01-01 12:00  =>     PERFORM UNTIL SW-END = 1
  2009-01-01 12:00  =>        PERFORM 040-TRAITEMENT          THRU 040-EXIT
  2009-01-01 12:00  =>     END-PERFORM.
  2009-01-01 12:00  =>     PERFORM 090-CLOTURE             THRU 090-EXIT.
  2009-01-01 12:00  =>     IF WS-NB-REC-ERR > 0
  2009-01-01 12:00  =>        DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>        DISPLAY '*     GRAVE ERREUR (OVERFLOW)     *'
  2009-01-01 12:00  =>        DISPLAY '*        ABORT DU PROGRAMME       *'
  2009-01-01 12:00  =>        DISPLAY '*        CONTACTER J-Y NAUW       *'
  2009-01-01 12:00  =>        DISPLAY '*       APPELER LES POMPIERS      *'
  2009-01-01 12:00  =>        DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>        CALL "EREABT$"
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => 000-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>* .010. OUVERTURE DES FICHIERS                                    *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  => 010-INIT-FICHIER.
  2009-01-01 12:00  =>*-----------------*
  2009-01-01 12:00  =>     OPEN OUTPUT LISTE ANOA OUTA
  2009-01-01 12:00  =>     OPEN INPUT  INA
  2009-01-01 12:00  => 010-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>* .020. INITIALISATION VARIABLES                                  *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  => 020-INIT-VARIABLES.
  2009-01-01 12:00  =>     INITIALIZE WS-NB-REC-LUS
  2009-01-01 12:00  =>                WS-NB-REC-ECR
  2009-01-01 12:00  =>                WS-NB-REC-ERR.
  2009-01-01 12:00  => 020-INIT-DATE.
  2009-01-01 12:00  =>     MOVE FUNCTION CURRENT-DATE TO WK-CURRENT-DATE.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  => 020-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>* .030. INITIALISATION DB                                         *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  => 030-INIT-DB.
  2009-01-01 12:00  =>*------------*
  2009-01-01 12:00  =>     MOVE "0" TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     EXEC RDMS BEGIN THREAD READ END-EXEC
  2009-01-01 12:00  =>     IF  SQLCODE NOT = 0
  2009-01-01 12:00  =>          MOVE "100- BEGIN THREAD" TO WS-ESQL-TRACE
  2009-01-01 12:00  =>          PERFORM 999-ESQL-ERR
  2009-01-01 12:00  =>          PERFORM 090-CLOTURE THRU 090-EXIT
  2009-01-01 12:00  =>          CALL "EREABT$"
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     MOVE "1" TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     EXEC RDMS  USE DEFAULT QUALIFIER AFLINC END-EXEC
  2009-01-01 12:00  =>     EXEC RDMS  USE DEFAULT VERSION PRODUCTION  END-EXEC
  2009-01-01 12:00  =>     IF  SQLCODE NOT = 0
  2009-01-01 12:00  =>          PERFORM 999-ESQL-ERR
  2009-01-01 12:00  =>          PERFORM 090-CLOTURE THRU 090-EXIT
  2009-01-01 12:00  =>          CALL "EREABT$"
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  => 030-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  => 035-RECHERCHE-PHASE.
  2009-01-01 12:00  =>*-------------------*
  2009-01-01 12:00  =>     MOVE 0 TO C-PHA-EUR.
  2009-01-01 12:00  =>     EXEC RDMS
  2009-01-01 12:00  =>           SELECT
  2009-01-01 12:00  =>                 C_PHA_EUR
  2009-01-01 12:00  =>              INTO :C-PHA-EUR
  2009-01-01 12:00  =>              FROM
  2009-01-01 12:00  =>                 EU001
  2009-01-01 12:00  =>     END-EXEC
  2009-01-01 12:00  =>     IF C-PHA-EUR = '100' OR = '200'
  2009-01-01 12:00  =>        MOVE 'BEF' TO WS-DEVISE-2200
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     IF C-PHA-EUR = '300' OR = '350' OR = '400'
  2009-01-01 12:00  =>        MOVE 'EUR' TO WS-DEVISE-2200
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     DISPLAY 'PHASE ACTUELLE : ' C-PHA-EUR '/' WS-DEVISE-2200
  2009-01-01 12:00  => 035-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>* .040. TRAITEMENT PROPRE AU PROGRAMME BATCH                      *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  => 040-TRAITEMENT.
  2009-01-01 12:00  =>*---------------*
  2009-01-01 12:00  =>*----------------------------------------------------------------*
  2009-01-01 12:00  =>* TRAITEMENT DIVERS                                              *
  2009-01-01 12:00  =>*----------------------------------------------------------------*
  2009-01-01 12:00  =>     MOVE 0 TO SW-ERREUR.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>     PERFORM  500-LECTURE-INA
  2009-01-01 12:00  =>         THRU 500-LECTURE-INA-EXIT.
  2009-01-01 12:00  =>     IF SW-END = 1
  2009-01-01 12:00  =>        PERFORM 510-MAJ-PARAM-DB
  2009-01-01 12:00  =>        GO TO 040-EXIT.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>     ADD 1 TO WS-NB-REC-ECR.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>* CAS OVERFLOW
  2009-01-01 12:00  =>     IF SW-ERREUR = 1
  2009-01-01 12:00  =>        ADD 1 TO WS-NB-REC-ERR
  2009-01-01 12:00  =>        MOVE REC-FILE-INA OF INA TO REC-ANOA-DATA
  2009-01-01 12:00  =>        WRITE REC-ANOA
  2009-01-01 12:00  =>     END-IF.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  => 040-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  =>* .090. CLOTURE GENERALE                                         *
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  => 090-CLOTURE.
  2009-01-01 12:00  =>*------------*
  2009-01-01 12:00  =>     DISPLAY 'NB RECORDS LUS     : ' WS-NB-REC-LUS
  2009-01-01 12:00  =>     DISPLAY 'NB RECORDS MAJ     : ' WS-NB-REC-MAJ
  2009-01-01 12:00  =>     DISPLAY 'NB RECORDS ERREUR  : ' WS-NB-REC-ERR
  2009-01-01 12:00  =>     IF  WS-ESQL-FL-THREAD = "1"
  2009-01-01 12:00  =>          EXEC RDMS END THREAD END-EXEC
  2009-01-01 12:00  =>          MOVE "0" TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     END-IF.
  2009-01-01 12:00  =>     CLOSE LISTE ANOA INA OUTA
  2009-01-01 12:00  => 090-EXIT.  EXIT.
  2009-01-01 12:00  =>*---------*
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  =>* .500. LECTURES DB                                              *
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>*  DECLARATION CURSEUR                                            *
  2009-01-01 12:00  =>*=================================================================*
  2009-01-01 12:00  =>*
  2009-01-01 12:00  =>*-----------------*
  2009-01-01 12:00  => 500-LECTURE-INA.
  2009-01-01 12:00  =>      READ INA AT END MOVE 1 TO SW-END.
  2009-01-01 12:00  =>      IF SW-END = 1
  2009-01-01 12:00  =>         GO TO 500-LECTURE-INA-EXIT.
  2009-01-01 12:00  =>      MOVE 0 TO WS-MAJ.
  2009-01-01 12:00  =>      ADD 1 TO WS-NB-REC-LUS
  2009-01-01 12:00  =>      MOVE REC-FILE-INA TO
  2009-01-01 12:00  =>           REC-FILE-OUTA
  2009-01-01 12:00  =>      MOVE 0 TO WS-PAS-CONVERTION
  2009-01-01 12:00  =>      IF WS-DEVISE-2200 = 'BEF'
  2009-01-01 12:00  =>         IF DEVISE-INA NOT = '1' AND NOT =
  2009-01-01 12:00  =>                             '2'
  2009-01-01 12:00  =>            DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>            DISPLAY '*     GRAVE ERREUR DE DEVISE      *'
  2009-01-01 12:00  =>            DISPLAY '*        ABORT DU PROGRAMME       *'
  2009-01-01 12:00  =>            DISPLAY '*        CONTACTER J-Y NAUW       *'
  2009-01-01 12:00  =>            DISPLAY '*       APPELER LES POMPIERS      *'
  2009-01-01 12:00  =>            DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>            CALL "EREABT$"
  2009-01-01 12:00  =>         END-IF
  2009-01-01 12:00  =>         IF DEVISE-INA = '1'
  2009-01-01 12:00  =>            MOVE 1 TO WS-PAS-CONVERTION
  2009-01-01 12:00  =>         END-IF
  2009-01-01 12:00  =>      END-IF
  2009-01-01 12:00  =>      IF WS-DEVISE-2200 = 'EUR'
  2009-01-01 12:00  =>         IF DEVISE-INA NOT = '1' AND NOT =
  2009-01-01 12:00  =>                             '2'
  2009-01-01 12:00  =>            DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>            DISPLAY '*     GRAVE ERREUR DE DEVISE      *'
  2009-01-01 12:00  =>            DISPLAY '*        ABORT DU PROGRAMME       *'
  2009-01-01 12:00  =>            DISPLAY '*        CONTACTER J-Y NAUW       *'
  2009-01-01 12:00  =>            DISPLAY '*       APPELER LES POMPIERS      *'
  2009-01-01 12:00  =>            DISPLAY '*---------------------------------*'
  2009-01-01 12:00  =>            CALL "EREABT$"
  2009-01-01 12:00  =>         END-IF
  2009-01-01 12:00  =>         IF DEVISE-INA = '2'
  2009-01-01 12:00  =>            MOVE 1 TO WS-PAS-CONVERTION
  2009-01-01 12:00  =>         END-IF
  2009-01-01 12:00  =>      END-IF
  2009-01-01 12:00  =>      IF WS-PAS-CONVERTION = 1
  2009-01-01 12:00  =>         GO TO SUITE.
  2009-01-01 12:00  => SUITE.
  2009-01-01 12:00  =>      COMPUTE WS-NB-REC-MAJ = WS-NB-REC-MAJ + WS-MAJ
  2009-01-01 12:00  =>         MOVE WS-DEVISE-2200 TO DEVISE-OUTA
  2009-01-01 12:00  =>      WRITE REC-FILE-OUTA
  2009-01-01 12:00  => 500-LECTURE-INA-EXIT. EXIT.
  2009-01-01 12:00  => 500-VERIF-PARAM-DB.
  2009-01-01 12:00  =>*
  2009-01-01 12:00  => 510-MAJ-PARAM-DB.
  2009-01-01 12:00  =>      PERFORM 020-INIT-DATE.
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  =>* .600. TRAITEMENT DES CASES ET CALCULS                          *
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  => 600-CASE-1.
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  =>* .900. TRAITEMENT DES ANOMALIES                                 *
  2009-01-01 12:00  =>*================================================================*
  2009-01-01 12:00  => 999-ESQL-ERR.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>* ESQL ERROR                                                      *
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>     IF  SQLCODE = -6010
  2009-01-01 12:00  =>          MOVE CS-ESQL-NO-MSG-DEADLOCK TO MSGERR-NO
  2009-01-01 12:00  =>          MOVE '1'                     TO MSGERR-CD-RLG
  2009-01-01 12:00  =>          MOVE WS-ESQL-TRACE           TO MSGERR-VAR-001
  2009-01-01 12:00  =>          CALL 'MSGERR' USING MSGERR
  2009-01-01 12:00  =>          DISPLAY MSGERR-LB (1:60) UPON CONSOLE
  2009-01-01 12:00  =>          CALL 'BLOACE' USING WS-ESQL-TRACE
  2009-01-01 12:00  =>          ADD  1 TO WS-ESQL-CT-DEADLOCK
  2009-01-01 12:00  =>          MOVE 1 TO WS-ESQL-FL-DEADLOCK
  2009-01-01 12:00  =>          IF  WS-ESQL-CT-DEADLOCK < 6
  2009-01-01 12:00  =>               PERFORM 090-CLOTURE THRU 090-EXIT
  2009-01-01 12:00  =>               GO TO 000-MAIN
  2009-01-01 12:00  =>          END-IF
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  =>     PERFORM 999-ESQL-GET-ERR
  2009-01-01 12:00  =>     IF WS-ESQL-FL-THREAD = '1'
  2009-01-01 12:00  =>          EXEC RDMS ROLLBACK WORK END-EXEC
  2009-01-01 12:00  =>*         EXEC SQL END THREAD    END-EXEC
  2009-01-01 12:00  =>*         MOVE '0' TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  => 999-ESQL-ERR-NO-DISP.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>* ESQL ERROR                                                      *
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>     IF WS-ESQL-FL-THREAD = '1'
  2009-01-01 12:00  =>          EXEC RDMS ROLLBACK WORK END-EXEC
  2009-01-01 12:00  =>*         EXEC SQL END THREAD    END-EXEC
  2009-01-01 12:00  =>*         MOVE '0' TO WS-ESQL-FL-THREAD
  2009-01-01 12:00  =>     END-IF
  2009-01-01 12:00  => 999-ESQL-GET-ERR.
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>* DISPLAY DE L'ERREUR ESQL                                        *
  2009-01-01 12:00  =>*-----------------------------------------------------------------*
  2009-01-01 12:00  =>     MOVE SQLCODE      TO WS-ESQL-SQLCODE
  2009-01-01 12:00  =>     MOVE ERROR-STATUS OF RDMCA
  2009-01-01 12:00  =>                       TO WS-ESQL-ERROR-STATUS
  2009-01-01 12:00  =>     MOVE AUX-INFO     OF RDMCA
  2009-01-01 12:00  =>                        TO WS-ESQL-AUX-INFO
  2009-01-01 12:00  =>     DISPLAY "*** ESQL ERROR ***"          UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY "TRACE       = " WS-ESQL-TRACE  UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY "SQLCODE     = " SQLCODE      UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY "ERROR-SATUS = " ERROR-STATUS OF RDMCA
  2009-01-01 12:00  =>                                           UPON PRINTER
  2009-01-01 12:00  =>     DISPLAY "AUX-INFO    = " AUX-INFO     OF RDMCA
  2009-01-01 12:00  =>                                           UPON PRINTER
  2009-01-01 12:00  =>     MOVE "0" TO WS-ESQL-FL
  2009-01-01 12:00  =>     PERFORM UNTIL WS-ESQL-FL = "1"
  2009-01-01 12:00  =>          EXEC RDMS GETERROR INTO
  2009-01-01 12:00  =>            :WS-ESQL-LB-ERR (1), :WS-ESQL-LB-ERR (2),
  2009-01-01 12:00  =>            :WS-ESQL-LB-ERR (3), :WS-ESQL-LB-ERR (4),
  2009-01-01 12:00  =>            :WS-ESQL-LB-ERR (5)
  2009-01-01 12:00  =>          END-EXEC
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-LB-ERR (1) UPON PRINTER
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-LB-ERR (2) UPON PRINTER
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-LB-ERR (3) UPON PRINTER
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-LB-ERR (4) UPON PRINTER
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-LB-ERR (5) UPON PRINTER
  2009-01-01 12:00  =>          IF  WS-ESQL-LB-ERR (1) = SPACES
  2009-01-01 12:00  =>          AND WS-ESQL-LB-ERR (2) = SPACES
  2009-01-01 12:00  =>          AND WS-ESQL-LB-ERR (3) = SPACES
  2009-01-01 12:00  =>          AND WS-ESQL-LB-ERR (4) = SPACES
  2009-01-01 12:00  =>          AND WS-ESQL-LB-ERR (5) = SPACES
  2009-01-01 12:00  =>               MOVE "1" TO WS-ESQL-FL
  2009-01-01 12:00  =>          END-IF
  2009-01-01 12:00  =>     END-PERFORM
  2009-01-01 12:00  =>     PERFORM VARYING WS-ESQL-IX-CML FROM 1 BY 1
  2009-01-01 12:00  =>               UNTIL WS-ESQL-IX-CML > 200
  2009-01-01 12:00  =>          DISPLAY WS-ESQL-CML (WS-ESQL-IX-CML) UPON PRINTER
  2009-01-01 12:00  =>     END-PERFORM
  2009-01-01 12:00  =>     MOVE WS-ESQL-SQLCODE      TO SQLCODE
  2009-01-01 12:00  =>     MOVE WS-ESQL-ERROR-STATUS TO ERROR-STATUS OF RDMCA
  2009-01-01 12:00  =>     MOVE WS-ESQL-AUX-INFO     TO AUX-INFO     OF RDMCA
  2009-01-01 12:00  =>
