  2009-01-01 12:00  =>     03 FILLER          PIC X(03) VALUE '3..'.
  2009-01-01 12:00  => 01  FIVE-CT PIC 9(10) COMP VALUE 6.
  2009-01-01 12:00  => 01  M-LINE                                USAGE  DISPLAY-1.
  2009-01-01 12:00  =>     03  FILLER         PIC X(20)
  2009-01-01 12:00  =>         VALUE '** END SCAN **      '.
  2009-01-01 12:00  =>     03  FILLER         PIC X(37)
  2009-01-01 12:00  =>         VALUE  'RECORDS READ FROM ECL-TAPEIN = '.
  2009-01-01 12:00  =>     03  M-CT           PIC Z(10)9.
  2009-01-01 12:00  =>     03  FILLER         PIC X(19)
  2009-01-01 12:00  =>         VALUE  ' RECORD MATCHING = '.
  2009-01-01 12:00  =>     03  FN-CT          PIC Z(10)9.
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => OPEN-FILES SECTION.
  2009-01-01 12:00  => FIRST-READ.
  2009-01-01 12:00  =>     OPEN INPUT  TAPEIN.  OPEN OUTPUT  PRT.
  2009-01-01 12:00  => LR. READ  TAPEIN  INTO  REC-AREA  AT END  GO TO END-OUT.
  2009-01-01 12:00  =>     ADD 1 TO REC-IN-CT.
  2009-01-01 12:00  => SUITE-RECHERCHE.
  2009-01-01 12:00  => FOUND-REC.
  2009-01-01 12:00  =>     ADD  1  TO  REC-FOUND-CT.
  2009-01-01 12:00  =>     MOVE ZERO  TO  LINE-CNT.
  2009-01-01 12:00  =>     ADD 1 TO FIVE-CT.
  2009-01-01 12:00  =>     IF FIVE-CT > 9 MOVE REC-IN-CT TO F-CT
  2009-01-01 12:00  =>       WRITE PRT-LINE FROM F-LINE AFTER 1 MOVE 1 TO FIVE-CT
  2009-01-01 12:00  =>      ELSE   MOVE REC-IN-CT TO CT-CT
  2009-01-01 12:00  =>       WRITE PRT-LINE FROM CT-LINE AFTER 1.
  2009-01-01 12:00  =>     ADD 1 TO LINE-CNT.
  2009-01-01 12:00  =>     MOVE  1  TO  SKIP.
  2009-01-01 12:00  =>     WRITE  PRT-LINE  FROM  PRINT-LINE-1  AFTER ADVANCING SKIP.
  2009-01-01 12:00  =>     ADD 1 TO LINE-CNT.
  2009-01-01 12:00  =>     MOVE 1 TO SKIP.
  2009-01-01 12:00  =>     MOVE SPACES  TO REC-AREA.
  2009-01-01 12:00  =>     MOVE  1  TO  SKIP.     GO  TO  LR.
  2009-01-01 12:00  => END-OUT.
  2009-01-01 12:00  =>     MOVE  REC-IN-CT  TO  M-CT.
  2009-01-01 12:00  =>     MOVE REC-FOUND-CT  TO  FN-CT.
  2009-01-01 12:00  =>     WRITE PRT-LINE  FROM  M-LINE AFTER ADVANCING 10 LINES.
  2009-01-01 12:00  =>     CLOSE  TAPEIN  PRT.
  2009-01-01 12:00  =>     STOP RUN.
</DATA>
