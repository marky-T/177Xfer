  2009-01-01 12:00  => 01  RDMS-COLUMN                           PIC S1(36).
  2009-01-01 12:00  => 01  RDMS-SAV-COLUMN                       PIC S1(36).
  2009-01-01 12:00  => 01  RDMS-FLAG                             PIC 9     VALUE 0.
  2009-01-01 12:00  => 01  RDMS-FLAG-THREAD                      PIC 9     VALUE 0.
  2009-01-01 12:00  => 01  RDMS-RESULT.
  2009-01-01 12:00  =>       05 RDMS-ERROR-LINE OCCURS 4         PIC X(80).
  2009-01-01 12:00  => 01  RDMS-COM.
  2009-01-01 12:00  =>       05 RLIN            OCCURS 36        PIC X(40).
  2009-01-01 12:00  => 01  ZONE-25                               PIC Z(18).
  2009-01-01 12:00  => PROCEDURE DIVISION.
  2009-01-01 12:00  => DEBUT.   OPEN INPUT TAPE1.
  2009-01-01 12:00  =>     MOVE  SPACES  TO  LIGNES-SUB.
  2009-01-01 12:00  =>     OPEN OUTPUT  IMP.
  2009-01-01 12:00  =>     CALL 'RSA$INIT'.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'BEGIN THREAD FOR APPLICATION UDSSRC READ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 1 TO RDMS-FLAG-THREAD.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'USE DEFAULT QUALIFIER AFLINC;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'USE DEFAULT VERSION PRODUCTION ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 0 TO RDMS-FLAG.
  2009-01-01 12:00  =>     MOVE 'TABAN'     TO NM-PGM-APL   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'BATCH'     TO NM-NOM-ENV   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'Y'         TO CD-DBG-PRG   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'EUW002'    TO NM-NOM-COP   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE 'SERVICE1'  TO NM-NOM-DEM   OF WS-CMT-PGM.
  2009-01-01 12:00  =>     MOVE SPACES      TO WS-PTR-ENE   OF EUW002.
  2009-01-01 12:00  =>     MOVE 'R'         TO FL-PLT-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE '2'         TO FL-TRD-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE 'Y'         TO MT-ENE-SGN   OF EUW002.
  2009-01-01 12:00  =>     MOVE '1'         TO CD-FMT-MON-SRT  OF EUW002.
  2009-01-01 12:00  =>     MOVE 'Y'         TO FL-IMP-PNT      OF EUW002.
  2009-01-01 12:00  =>     MOVE 'N'         TO FL-000          OF EUW002.
  2009-01-01 12:00  => LECT.  READ TAPE1  AT END GO TO FINBDE.
  2009-01-01 12:00  =>     ADD  1  TO  NB-LUS.
  2009-01-01 12:00  =>     IF  FIRS  =  0  MOVE  1  TO  FIRS  GO TO CONT1.
  2009-01-01 12:00  => LECT2.
  2009-01-01 12:00  =>     GO TO LECT.
  2009-01-01 12:00  => CONT1.
  2009-01-01 12:00  =>     GO TO LECT2.
  2009-01-01 12:00  => FINBDE.
  2009-01-01 12:00  =>     ADD  CORRESPONDING  SUB-TOTAL  TO  TOTAL.
  2009-01-01 12:00  =>     PERFORM  IMP-TOTAL.
  2009-01-01 12:00  =>     MOVE  NB-LUS  TO   P-LUS.
  2009-01-01 12:00  =>     WRITE  LIGNE  FROM  TIT-TOTAL  AFTER  3.
  2009-01-01 12:00  => FF. CLOSE  TAPE1.
  2009-01-01 12:00  =>     CLOSE  IMP.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'END THREAD ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN.
  2009-01-01 12:00  =>     IF RDMS-STATUS NOT = 0 GO TO RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     MOVE 0 TO RDMS-FLAG-THREAD.
  2009-01-01 12:00  =>     STOP RUN.
  2009-01-01 12:00  => IMP-TOTAL.
  2009-01-01 12:00  =>     MOVE '*****TOTAL GENERAL *****'  TO  LIGNE.
  2009-01-01 12:00  =>      WRITE  LIGNE  AFTER PAGE.
  2009-01-01 12:00  =>     MOVE 17     TO MT-ENE-CHI OF EUW002.
  2009-01-01 12:00  =>     MOVE 25     TO LG-MAX-MON-SRT OF EUW002.
  2009-01-01 12:00  => RDMS-ERROR-PAR.
  2009-01-01 12:00  =>     DISPLAY '*** ERROR RDMS ***' UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'COLUMN = ' RDMS-COLUMN UPON PRINTER.
  2009-01-01 12:00  =>     DISPLAY 'STATUS = ' RDMS-STATUS UPON PRINTER.
  2009-01-01 12:00  =>     PERFORM TRAIT-RDMS.
  2009-01-01 12:00  =>     GO TO RDMS-ERROR-EX.
  2009-01-01 12:00  => TRAIT-RDMS.
  2009-01-01 12:00  =>     MOVE ZEROS TO RDMS-FLAG.
  2009-01-01 12:00  =>     PERFORM VISU-RDMS-COM VARYING RDMS-IND FROM 1 BY 1
  2009-01-01 12:00  =>         UNTIL RDMS-IND > 36.
  2009-01-01 12:00  =>     MOVE ZEROS TO RDMS-FLAG.
  2009-01-01 12:00  =>     PERFORM TRAIT-RDMS-ERROR
  2009-01-01 12:00  =>         UNTIL RDMS-FLAG NOT = ZEROS.
  2009-01-01 12:00  => TRAIT-RDMS-ERROR.
  2009-01-01 12:00  =>     ENTER MASM 'ACOB$RDMR' USING
  2009-01-01 12:00  =>       'GETERROR INTO $P1, $P2, $P3, $P4 ;',
  2009-01-01 12:00  =>       RDMS-STATUS, RDMS-COLUMN,
  2009-01-01 12:00  =>       RDMS-ERROR-LINE (1), RDMS-ERROR-LINE (2),
  2009-01-01 12:00  =>       RDMS-ERROR-LINE (3), RDMS-ERROR-LINE (4).
  2009-01-01 12:00  =>     PERFORM VISU-RDMS-ERROR
  2009-01-01 12:00  =>       VARYING RDMS-IND FROM 1 BY 1
  2009-01-01 12:00  =>       UNTIL RDMS-IND > 4.
  2009-01-01 12:00  => VISU-RDMS-ERROR.
  2009-01-01 12:00  =>     IF RDMS-ERROR-LINE (RDMS-IND) NOT = SPACE
  2009-01-01 12:00  =>          DISPLAY RDMS-ERROR-LINE (RDMS-IND) UPON PRINTER
  2009-01-01 12:00  =>     ELSE MOVE 1 TO RDMS-FLAG.
  2009-01-01 12:00  => VISU-RDMS-COM.
  2009-01-01 12:00  =>     IF RLIN (RDMS-IND) NOT = SPACES
  2009-01-01 12:00  =>          DISPLAY RLIN (RDMS-IND) UPON PRINTER.
  2009-01-01 12:00  => RDMS-ERROR-EX.
</DATA>
